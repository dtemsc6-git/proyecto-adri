page 472 (
    name: Cargar Archivos
    alias: CARGAR-ARCHIVOS
    title: Cargar Archivos
    pageGroup: @archivos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cargar-archivos (
        name: Cargar Archivos
        type: form
        source {
            location: localDatabase
            tableName: SGT_ARCHIVOS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Cargue aquí sus esquemas, documentación u otra información que considere relevante
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P472_ENTIDAD (
        type: selectList
        label {
            label: Informe / Esquema
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:6. Esquemas;6,7. Informes;7
            nullDisplayValue: Seleccione una
        }
        layout {
            sequence: 50
            region: @cargar-archivos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @cargar-archivos
            column: ENTIDAD
            dataType: number
        }
        help {
            inlineHelpText: Selecciones si es un informe o un esquema
        }
    )

    pageItem P472_ESTADO (
        type: hidden
        layout {
            sequence: 40
            region: @cargar-archivos
            slot: regionBody
        }
        source {
            formRegion: @cargar-archivos
            column: ESTADO
            dataType: number
        }
    )

    pageItem P472_FILE_BLOB (
        type: fileUpload
        label {
            label: Archivo Seleccionado
            alignment: left
        }
        storage {
            mimeTypeColumn: FILE_MIMETYPE
            filenameColumn: FILE_NAME
            charSetColumn: FILE_CHARSET
            bobLastUpdatedColumn: ACTUALIZADO_EL
            fileTypes: .docx, .vsd, .pdf
            maxFileSize: 2048
        }
        layout {
            sequence: 70
            region: @cargar-archivos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @cargar-archivos
            column: FILE_BLOB
            dataType: blob
        }
    )

    pageItem P472_ID (
        type: hidden
        layout {
            sequence: 10
            region: @cargar-archivos
            slot: regionBody
        }
        source {
            formRegion: @cargar-archivos
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P472_OBSERVACIONES (
        type: textarea
        label {
            label: Observaciones
            alignment: left
        }
        layout {
            sequence: 80
            region: @cargar-archivos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @cargar-archivos
            column: OBSERVACIONES
            dataType: varchar2
        }
    )

    pageItem P472_PK_ID (
        type: numberField
        label {
            label: Pk Id
            alignment: left
        }
        layout {
            sequence: 30
            region: @cargar-archivos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @cargar-archivos
            column: PK_ID
            dataType: number
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P472_SITIOS (
        type: popupLov
        label {
            label: Sitios
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @sgt-sitios-siglas
            nullDisplayValue: Seleccione un sitio
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 60
            region: @cargar-archivos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        help {
            inlineHelpText: Puede seleccionar múltiples sitios
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @cargar-archivos
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 471
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 40
            region: @cargar-archivos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P472_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @cargar-archivos
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P472_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @cargar-archivos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P472_ID
        }
    )

    computation p472-entidad (
        itemName: P472_ENTIDAD
        execution {
            sequence: 10
        }
        computation {
            type: staticValue
            staticValue: 6
        }
        config {
            buildOption: @commented-out
        }
    )

    process initialize-form-cargar-archivos (
        name: Initialize form Cargar Archivos
        type: formInitialization
        formRegion: @cargar-archivos
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21657662942979099
        }
    )

    process procesar-sitios (
        name: Procesar Sitios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                v_tipo_entidad number := :P472_ENTIDAD;
                begin
                   --iterar sobre los valores del combo P472_SITIOS
                   for rec in (SELECT column_value 
                        FROM apex_string.split_numbers(:P472_SITIOS, ':') )
                
                    loop
                   --Insertar cada valor.
                        insert into SGT_SITIOS_ARCHIVOS (ARCHIVO_ID, SITIO_ID) values (:P472_ID, rec.column_value );
                
                   end loop;
                
                   end;
                
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 21500961200040849
        }
    )

    process process-form-cargar-archivos (
        name: Process form Cargar Archivos
        type: formAutoRowProcessing
        formRegion: @cargar-archivos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21658009092979099
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 471
            }
        }
    )

)

