page 403 (
    name: Seleccionar las conexiones
    alias: SELECCIONAR-LAS-CONEXIONES
    title: Seleccionar las conexiones
    pageGroup: @wzrd-wan
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function filtrarShuttle() {
            var filtro = $("#P403_FILTRAR_CONEXIONES").val();
                var filtroLower = filtro.toLowerCase();
                var opciones = document.querySelectorAll("#P403_CONEXIONES_LEFT option");
            
                opciones.forEach(function (opt) {
                    if (opt.text.toLowerCase().includes(filtroLower)) {
                        opt.style.display = "";   // mostrar
                    } else {
                        opt.style.display = "none"; // ocultar
                    }
                });
            }
            ```
    }
    css {
        inline:
            ```css
            .shuttle select {
                overflow: scroll;
            }
            ```
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region seleccionar-las-conexiones (
        name: Seleccionar las conexiones
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @wizard-progress
            slot: wizardSubRegions
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region wizard-progress (
        name: Wizard Progress
        type: list
        source {
            list: @wzrd-conexiones-wan
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P403_CONEXIONES (
        type: shuttle
        label {
            label: Conexiones
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    EQUIPO_A || ':' || INTERFAZ_A ||':'|| etiqueta_a 
                    || ' > '||  EQUIPO_B || ':' || INTERFAZ_B || ':' || etiqueta_b 
                    AS display_value,
                    conexiones.id AS return_value
                FROM v_tramos_nombres conexiones
                WHERE conexiones.equipo_a_id IN (
                    SELECT column_value FROM apex_string.split_numbers(:P405_EQUIPOS, ',')
                )
                OR 
                conexiones.equipo_b_id IN (
                    SELECT column_value FROM apex_string.split_numbers(:P405_EQUIPOS, ',')
                )
                
                /*
                MODIFICADO: DMF: 2026-04-06
                SELECT 
                    EQUIPO_A || ':' || INTERFAZ_A ||':'|| etiqueta_a 
                    || ' > '||  EQUIPO_B || ':' || INTERFAZ_B || ':' || etiqueta_b 
                    AS display_value,
                    conexiones.id AS return_value
                FROM v_tramos_nombres conexiones
                WHERE conexiones.sitio_a_id IN (
                    SELECT column_value FROM apex_string.split_numbers(:P402_SITIOS, ',')
                )
                
                and (:P403_FILTRAR_TIPO_CONEXION IS NULL OR TIPO_CONEXION = :P403_FILTRAR_TIPO_CONEXION)
                */
                /*
                and 
                TIPO_CONEXION <> 'Trasera'
                
                union
                
                 select  EQUIPO_A || ':' || INTERFAZ_A ||':'|| etiqueta_a 
                    || ' > '||  EQUIPO_B || ':' || INTERFAZ_B || ':' || etiqueta_b 
                    AS display_value,
                    t.id AS return_value from v_tramos_nombres t join (   
                    select * from sgt_enlaces_tramos
                    where tipo_conexion = 'Trasera'
                    and
                    interfaz_a_id in 
                    (
                        select iface_a_id int_id from v_tramos_nombres where id in (SELECT column_value FROM apex_string.split_numbers(:P402_SITIOS, ','))
                        union
                        select iface_b_id int_id from v_tramos_nombres where id in (SELECT column_value FROM apex_string.split_numbers(:P402_SITIOS, ','))
                    )
                ) q1
                 on t.id = q1.id 
                 */
                ```
        }
        cascadingLov {
            parentItems: P403_FILTRAR_TIPO_CONEXION
            itemsToSubmit: P403_FILTRAR_TIPO_CONEXION
        }
        multipleValues {
            separator: ,
        }
        layout {
            sequence: 30
            region: @seleccionar-las-conexiones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 10
        }
        advanced {
            cssClasses: shuttle-sgt
        }
        source {
            type: sqlQueryMultipleValues
            sqlQuery:
                ```sql
                SELECT ENLACE_TRAMO_ID FROM SGT_CONEXIONES_ENLACE_WAN wan
                where wan.enlace_wan_id = :P401_ID
                ORDER BY SECUENCIA
                ```
        }
    )

    pageItem P403_FILTRAR_CONEXIONES (
        type: textField
        label {
            label: Filtrar Conexiones
            alignment: left
        }
        layout {
            sequence: 10
            region: @seleccionar-las-conexiones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        sessionState {
            storage: request
        }
    )

    pageItem P403_FILTRAR_SITIO (
        type: selectOne
        label {
            label: Filtrar Sitio
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Display1;Return1,Display2;Return2
        }
        layout {
            sequence: 20
            region: @seleccionar-las-conexiones
            slot: sortOrder
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P403_FILTRAR_TIPO_CONEXION (
        type: selectList
        label {
            label: Filtrar Tipo Conexion
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Física;Física,Lógica;Lógica,Trasera;Trasera
            nullDisplayValue: Seleccione Uno
        }
        layout {
            sequence: 40
            region: @seleccionar-las-conexiones
            slot: sortOrder
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        config {
            buildOption: @commented-out
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @wizard-progress
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
                clearCache: 405
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @wizard-progress
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 20
            region: @wizard-progress
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P403_FILTRAR_CONEXIONES
        }

        action filtrar-shuttle (
            name: FILTRAR_SHUTTLE
            action: executeJsCode
            settings {
                jsCode: filtrarShuttle();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction no-submit (
        name: NO_SUBMIT
        execution {
            sequence: 20
        }
        when {
            event: keypress
            selectionType: items
            items: P403_FILTRAR_CONEXIONES
        }

        action no-submit (
            name: NO_SUBMIT
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (event.key === "Enter") {
                        filtrarShuttle();
                        event.preventDefault();
                        return false;
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 402
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {
                page: 405
            }
        }
        serverSideCondition {
            whenButtonPressed: @previous
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 404
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

