        series total-equipos-por-sitio (
            name: Total equipos por sitio
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select te.nombre nombres, count(e.tipo_equipo_id) valores from
                    sgt_equipos e left join sgt_tipo_equipos te on e.tipo_equipo_id = te.id
                    left join sgt_racks r on e.rack_id = r.id
                    LEFT JOIN sgt_salas sa ON r.sala_id = sa.id
                    
                    where sa.sitio_id = :FILTRO_TE_SITIO
                    
                    group by (e.tipo_equipo_id,te.nombre)
                    order by valores desc
                    ```
                pageItemsToSubmit: FILTRO_TE_SITIO
            }
            columnMapping {
                label: NOMBRES
                value: VALORES
            }
        )

        axis x (
