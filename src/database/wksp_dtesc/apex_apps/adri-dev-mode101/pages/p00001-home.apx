    region resumen (
        name: Resumen
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    1 as ORDEN,
                    'Total Sitios' as CARD_TITLE,
                    COUNT(s.id) || ' Sitios'as CARD_VALUE,
                    'Locales de ANDE' as CARD_SUBTITLE,
                    'fa fa-university' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                    APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':25:' || :APP_SESSION ) as HREF
                FROM sgt_sitios s
                
                UNION ALL
                
                SELECT 
                    2 as ORDEN,
                    'Total Salas' as CARD_TITLE,
                    COUNT(ss.id) || ' Salas' as CARD_VALUE,
                    'Salas de comunicación ANDE' as CARD_SUBTITLE,
                    'fa fa-map-marker' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                     APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':4:' || :APP_SESSION)  as HREF
                FROM sgt_salas ss
                UNION ALL
                
                SELECT 
                    3 as ORDEN,
                    'Total Racks' as CARD_TITLE,
                    COUNT(r.id) || ' Racks' as CARD_VALUE,
                    'Racks de ANDE' as CARD_SUBTITLE,
                    'fa fa-server' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                    APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':11:' || :APP_SESSION ) as HREF
                FROM sgt_racks r
                
                UNION ALL
                
                SELECT 
                    4 as ORDEN,
                    'Total Equipos' as CARD_TITLE,
                    COUNT(e.id) ||' Equipos' as CARD_VALUE,
                    'Activos / Pasivos / Otros' as CARD_SUBTITLE,
                    'fa fa-microchip' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                    APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':13:' || :APP_SESSION ) as HREF
                FROM sgt_equipos e
                
                UNION ALL
                
                SELECT 
                    5 as ORDEN,
                    'Total Interfaces' as CARD_TITLE,
                    COUNT(i.id) ||' Interfaces' as CARD_VALUE,
                    'Interfaces / Puertos' as CARD_SUBTITLE,
                    'fa fa-plug' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                    APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':8:' || :APP_SESSION)  as HREF
                FROM sgt_interfaces i
                
                UNION ALL
                
                
                SELECT 
                    6 as ORDEN,
                    'Total Servicios' as CARD_TITLE,
                    COUNT(srv.id) || ' Servicios' as CARD_VALUE,
                    'Servicios de Comunicaciones' as CARD_SUBTITLE,
                    'fa fa-sitemap-horizontal' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                    APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':17:' || :APP_SESSION ) as HREF
                FROM sgt_servicios srv
                
                union
                
                SELECT 
                    7 as ORDEN,
                    'Total Enlaces de Fibra Óptica' as CARD_TITLE,
                    COUNT(fo.id) ||' Enlaces FO' as CARD_VALUE,
                     
                    'Enlaces FO: ' || TO_CHAR(SUM (fo.abs_longitud)/1000,
                         'fm999G999G999D00') || ' km' as CARD_SUBTITLE,
                    'fa fa-sitemap-horizontal' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                    APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':36:' || :APP_SESSION ) as HREF
                FROM sgt_enlaces_fo fo
                
                union 
                
                SELECT 
                    8 as ORDEN,
                    'Total Enlaces WAN' as CARD_TITLE,
                    COUNT(wan.id) || ' Enlaces WAN' as CARD_VALUE,
                    'Enlaces WAN' as CARD_SUBTITLE,
                    'fa fa-sitemap-horizontal' as CARD_ICON,
                    'is-success' as CARD_COLOR,
                    APEX_UTIL.PREPARE_URL('f?p='|| :APP_ID || ':10:' || :APP_SESSION ) as HREF
                FROM sgt_enlaces_wan wan
                
                ORDER BY ORDEN ASC
                
                ;
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tabs
            slot: subRegions
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
