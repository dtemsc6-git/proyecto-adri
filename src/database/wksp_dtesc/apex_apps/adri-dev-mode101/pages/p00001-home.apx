            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT te.nombre, COUNT(e.id) as valores 
                    FROM sgt_equipos e 
                    LEFT JOIN sgt_tipo_equipos te ON e.tipo_equipo_id = te.id
                    where e.tipo_red = :TIPO_RED
                    GROUP BY te.nombre, te.id;
                    ```
                pageItemsToSubmit: TIPO_RED
            }
            columnMapping {
                label: NOMBRE
                value: VALORES
            }
        )

        axis x (
            name: x
            title: Tipo de equipo
