page 1 (
    name: Home
    alias: HOME
    title: Sistema de Gestión TI
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region reportes (
        name: Reportes
        title: Reportes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    ss.siglas Sitio,
                    s.siglas AS Sala,
                    COUNT(DISTINCT r.id) AS total_racks,
                    COUNT(e.id) AS total_equipos
                    
                    --,COUNT(CASE WHEN e.sub_tipo_equipo = 'activo' THEN 1 END) AS total_activos,
                    --COUNT(CASE WHEN e.sub_tipo_equipo = 'pasivo' THEN 1 END) AS total_pasivos,
                    --COUNT(CASE WHEN e.sub_tipo_equipo = 'energía'  THEN 1 END) AS total_energia
                FROM 
                    sgt_sitios ss 
                left join    
                    sgt_salas s on s.sitio_id =ss.id
                LEFT JOIN 
                    sgt_racks r ON r.sala_id = s.id
                LEFT JOIN 
                    sgt_equipos e ON e.rack_id = r.id
                GROUP BY 
                    ss.siglas, s.siglas
                HAVING 
                    COUNT(DISTINCT r.id) > 0
                order by SITIO
                ```
        }
        layout {
            sequence: 30
            parentRegion: @tabs
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: Reporte de totales por Sitio/Sala/Rack
        }
        security {
            authorizationScheme: @jefatura-rights
        }
        config {
            buildOption: @commented-out
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            reportsSelectList: false
        }
        actionsMenu {
            controlBreak: false
            highlight: false
            compute: false
            aggregate: false
            chart: false
            pivot: false
            flashback: false
            saveReport: false
        }
        advanced {
            savedReportMappingIdentifier: 45026643190979173741
        }

        column SALA (
            type: plainText
            heading {
                heading: Sala
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
