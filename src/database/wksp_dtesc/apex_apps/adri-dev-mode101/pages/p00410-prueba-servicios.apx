page 410 (
    name: PRUEBA_SERVICIOS
    alias: PRUEBA-SERVICIOS
    title: Vista Servicios
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @search-results
        }
        layout {
            sequence: 10
            slot: leftColumn
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkLabel: Filters
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
            displayChartForTopNValues: 10
        }

        facet P410_EQUIPO (
            type: checkboxGroup
            label {
                label: Equipo
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: EQ
            }
        )

        facet P410_FO_NOMBRE (
            type: checkboxGroup
            label {
                label: Enlace FO
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: FO_NOMBRE
            }
        )

        facet P410_INTERFAZ_A (
            type: checkboxGroup
            label {
                label: Interfaz A
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: IFACE
            }
        )

        facet P410_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: SITIO_A,EQUIPO_A,INTERFAZ_A,SITIO_B,EQUIPO_B,INTERFAZ_B,SERVICIO,TIPO_CONEXION
            }
        )

        facet P410_SERVICIO (
            type: checkboxGroup
            label {
                label: Servicio
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: SERVICIO
            }
        )

        facet P410_WAN (
            type: checkboxGroup
            label {
                label: Wan
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: WAN
            }
        )

    )

    region search-results (
        name: Search Results
        type: classicReport
        source {
            location: localDatabase
            tableName: V_CONEXIONES_GENERAL_V2
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CONN_ID (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Conn Id
                alignment: end
            }
            layout {
                sequence: 270
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

        column EQ (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Equipo A
                alignment: center
            }
            layout {
                sequence: 200
            }
        )

        column EQ_B (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Equipo B
                alignment: center
            }
            layout {
                sequence: 240
            }
        )

        column EQ_B_ID (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Eq B Id
                alignment: end
            }
            layout {
                sequence: 230
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

        column EQ_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Eq Id
                alignment: end
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

        column FO_ID (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Fo Id
                alignment: end
            }
            layout {
                sequence: 280
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

        column FO_NOMBRE (
            reportColumnQueryId: 15
            derivedColumn: N
            heading {
                heading: Enlace FO
                alignment: center
            }
            layout {
                sequence: 320
            }
        )

        column IFACE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Interfaz A
                alignment: center
            }
            layout {
                sequence: 220
            }
        )

        column IFACE_B (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Interfaz B
                alignment: center
            }
            layout {
                sequence: 260
            }
        )

        column IFACE_B_ID (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Iface B Id
                alignment: end
            }
            layout {
                sequence: 250
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

        column IFACE_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Iface Id
                alignment: end
            }
            layout {
                sequence: 210
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

        column NIVEL_DE_PRIORIDAD (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Nivel de Prioridad
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @servicios-nivel-prioridad
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
        )

        column SEQ (
            reportColumnQueryId: 16
            derivedColumn: N
            heading {
                heading: Seq Srv
                alignment: center
            }
            layout {
                sequence: 290
                columnAlignment: end
            }
        )

        column SEQ_WAN (
            reportColumnQueryId: 19
            derivedColumn: N
            heading {
                heading: Seq Wan
                alignment: end
            }
            layout {
                sequence: 310
                columnAlignment: end
            }
        )

        column SERVICIO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Servicio
            }
            layout {
                sequence: 130
            }
        )

        column SERV_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Serv Id
                alignment: end
            }
            layout {
                sequence: 170
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

        column TIPO_CONEXION (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Tipo Conexion
            }
            layout {
                sequence: 160
            }
            config {
                buildOption: @commented-out
            }
        )

        column WAN (
            reportColumnQueryId: 18
            derivedColumn: N
            heading {
                heading: Enlace WAN
                alignment: center
            }
            layout {
                sequence: 300
            }
        )

        column WAN_ID (
            reportColumnQueryId: 17
            derivedColumn: N
            heading {
                heading: Wan Id
                alignment: end
            }
            layout {
                sequence: 330
                columnAlignment: end
            }
            config {
                buildOption: @commented-out
            }
        )

    )

    pageItem P410_ORDER_BY (
        type: selectList
        label {
            label: Order By
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Equipo A;EQUIPO_A,Servicio;SERVICIO
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @search-results
            slot: sortOrder
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: EQUIPO_A
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 410
                clearCache: 410
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

