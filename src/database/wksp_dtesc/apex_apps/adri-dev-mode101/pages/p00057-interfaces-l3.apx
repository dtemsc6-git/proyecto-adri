page 57 (
    name: Interfaces L3
    alias: INTERFACES-L3
    title: Interfaces L3
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region interfaces-l (
        name: Interfaces L3
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_INTERFACES_L3
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12213108954907058
        }

        savedReport 122136 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @INTERFACE_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @VPN_INSTANCE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ROUTER_ID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @PROCESO_OSPF
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @OSPF_AREA
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @CREADO_EL
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @CREADO_POR
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @NUM_BGP
                layout {
                    sequence: 12
                }
            )

        )

        column ACTUALIZADO_EL (
            type: textField
            heading {
                heading: Actualizado El
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ACTUALIZADO_POR (
            type: textField
            heading {
                heading: Actualizado Por
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CREADO_EL (
            type: textField
            heading {
                heading: Creado El
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CREADO_EL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREADO_POR (
            type: textField
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CREADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column INTERFACE_ID (
            type: popupLov
            heading {
                heading: Interfaz
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @interfaces-nombre-compuesto
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: INTERFACE_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column NUM_BGP (
            type: textField
            heading {
                heading: Num BGP
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: NUM_BGP
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column OSPF_AREA (
            type: textField
            heading {
                heading: OSPF Area
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: OSPF_AREA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PROCESO_OSPF (
            type: textField
            heading {
                heading: Proceso OSPF
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: PROCESO_OSPF
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROUTER_ID (
            type: textField
            heading {
                heading: Router ID
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 45
            }
            source {
                databaseColumn: ROUTER_ID
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column VPN_INSTANCE (
            type: textField
            heading {
                heading: VPN Instance
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: VPN_INSTANCE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Interfaces L3
        }
    )

    button load (
        buttonName: LOAD
        label: Importar XLSX
        layout {
            sequence: 30
            region: @interfaces-l
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 61
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process interfaces-l3-save-interactive-grid-data (
        name: Interfaces L3 - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @interfaces-l
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12226824962907066
        }
    )

)

