page 67 (
    name: Vista Global Comentarios
    alias: VISTA-GLOBAL-COMENTARIOS
    title: Vista Global Comentarios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @search-results
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_02
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkLabel: Filters
        }
        config {
            buildOption: @commented-out
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
            displayChartForTopNValues: 10
        }

        facet P67_ACTUALIZADO_POR (
            type: checkboxGroup
            label {
                label: Actualizado Por
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: ACTUALIZADO_POR
            }
        )

        facet P67_COMENTARIO (
            type: checkboxGroup
            label {
                label: Comentario
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: COMENTARIO
            }
        )

        facet P67_EQUIPO_NOMBRE (
            type: checkboxGroup
            label {
                label: Equipo Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: EQUIPO_NOMBRE
            }
        )

        facet P67_RACK_NOMBRE (
            type: checkboxGroup
            label {
                label: Rack Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: RACK_NOMBRE
            }
        )

        facet P67_SALA_NOMBRE (
            type: checkboxGroup
            label {
                label: Sala Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: SALA_NOMBRE
            }
        )

        facet P67_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: SITIO_NOMBRE,SALA_NOMBRE,RACK_NOMBRE,EQUIPO_NOMBRE,COMENTARIO
            }
        )

        facet P67_SITIO_NOMBRE (
            type: checkboxGroup
            label {
                label: Sitio Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: SITIO_NOMBRE
            }
        )

    )

    region search-results (
        name: Search Results
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sitio.id as sitio_id, sitio.siglas as sitio_nombre, null as sala_id, null as sala_nombre, null as rack_id, null as rack_nombre,
                null as equipo_id, null as equipo_nombre, null as tipo_red ,comentario, sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por 
                
                from sgt_sitios sitio join sgt_comentarios on pk_id = sitio.id
                where entidad = 1 
                
                union all 
                
                select sitio.id as sitio_id, sitio.siglas as sitio_nombre, salas.id as sala_id, salas.siglas||'-'||salas.nombre as sala_nombre, null as rack_id, null as rack_nombre,
                null as equipo_id, null as equipo_nombre, null as tipo_red, comentario, sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_sitios sitio 
                join sgt_salas salas on salas.sitio_id = sitio.id
                join sgt_comentarios on pk_id = salas.id
                where entidad = 2 
                
                union all 
                
                --Comentarios de los racks
                select sitio.id as sitio_id, sitio.siglas as sitio_nombre, salas.id as sala_id, salas.siglas||'-'||salas.nombre as sala_nombre, racks.id as rack_id, racks.nombre as rack_nombre,
                null as equipo_id, null as equipo_nombre, null as tipo_red, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_sitios sitio 
                join sgt_salas salas on salas.sitio_id = sitio.id
                join sgt_racks racks on racks.sala_id = salas.id
                join sgt_comentarios on pk_id = racks.id
                where entidad = 3 
                
                union all
                --vista de los comentarios de los equipos
                
                select sitio.id as sitio_id, sitio.siglas as sitio_nombre, salas.id as sala_id, salas.siglas||'-'||salas.nombre as sala_nombre, racks.id as rack_id, racks.nombre as rack_nombre,
                equipos.id as equipo_id, equipos.nombre as equipo_nombre , equipos.tipo_red as tipo_red, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_sitios sitio 
                join sgt_salas salas on salas.sitio_id = sitio.id
                join sgt_racks racks on racks.sala_id = salas.id
                join sgt_equipos equipos on equipos.rack_id = racks.id
                join sgt_comentarios on pk_id = equipos.id
                where entidad = 4
                
                
                --Vista de los comentarios de los enlaces de FO
                union all 
                select null as sitio_id, sitio.siglas as sitio_nombre, null as  sala_id, null as  sala_nombre, null as  rack_id, null as  rack_nombre,
                null as  equipo_id, fo.nombre as  equipo_nombre , 'ENLACE_FO' as tipo_red, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_enlaces_fo fo
                join sgt_sitios sitio on fo.sitio_id_a = sitio.id
                join sgt_comentarios on pk_id = fo.id
                where entidad = 5
                
                --Ver lado B
                union all 
                select null as sitio_id, sitio.siglas as sitio_nombre, null as  sala_id, null as  sala_nombre, null as  rack_id, null as  rack_nombre,
                null as  equipo_id, fo.nombre as  equipo_nombre , 'ENLACE_FO' as tipo_red, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_enlaces_fo fo
                join sgt_sitios sitio on fo.sitio_id_b = sitio.id
                join sgt_comentarios on pk_id = fo.id
                where entidad = 5
                
                union all
                
                --vista de los comentarios de los enlaces wan
                select null as sitio_id, null as sitio_nombre, null as  sala_id, null as  sala_nombre, null as  rack_id, null as  rack_nombre,
                null as  equipo_id, wan.nombre as  equipo_nombre , 'ENLACE_WAN' as tipo_red, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_enlaces_wan wan
                
                join sgt_comentarios on pk_id = wan.id
                where entidad = 8
                
                union all
                --Vista de los comentarios de servicios
                select null as sitio_id, null as sitio_nombre, null as  sala_id, null as  sala_nombre, null as  rack_id, null as  rack_nombre,
                null as  equipo_id, servicios.nombre as  equipo_nombre , 'SERVICIO' as tipo_red, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_servicios servicios
                
                join sgt_comentarios on pk_id = servicios.id
                where entidad = 9
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        headerAndFooter {
            footerText:
                ```html
                <br/>
                <span class="success">Resultado obtenido en: #TIMING# seg
                </span>
                ```
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 26461882241363011
        }

