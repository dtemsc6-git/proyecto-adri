page 27 (
    name: SGT_FORM_ENLACES_FO
    alias: SGT-FORM-ENLACES-FO
    title: Agregar / Editar
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region datos-cable (
        name: DATOS_CABLE
        title: Datos Adicionales
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @detalles-form
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region datos-enlaces (
        name: DATOS_ENLACES
        title: Datos Principales
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @detalles-form
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region datos-log (
        name: DATOS_LOG
        type: staticContent
        source {
            htmlCode:
                ```html
                Creado por &P27_CREADO_POR. el &P27_CREADO_EL.. 
                Actualizado por &P27_ACTUALIZADO_POR. el &P27_ACTUALIZADO_EL. 
                ```
        }
        layout {
            sequence: 270
            parentRegion: @sgt-form-enlaces-fo
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P27_ID
        }
    )

    region detalles-form (
        name: DETALLES_FORM
        title: Detalles
        type: regionDisplaySelector
        layout {
            sequence: 250
            parentRegion: @sgt-form-enlaces-fo
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        settings {
            includeShowAll: false
        }
    )

    region sgt-form-enlaces-fo (
        name: SGT_FORM_ENLACES_FO
        title: Agregar  / Editar Enlace FO
        type: form
        source {
            location: localDatabase
            tableName: SGT_ENLACES_FO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P27_ABS_LONGITUD (
        type: numberField
        label {
            label: Abs Longitud
            alignment: left
        }
        layout {
            sequence: 60
            region: @datos-cable
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-enlaces-fo
            column: ABS_LONGITUD
            dataType: number
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P27_ACTUALIZADO_EL (
