    pageItem P27_TIPO (
        type: selectList
        label {
            label: Tipo de enlace
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @tipo-enlace
        }
        layout {
            sequence: 90
            region: @datos-enlaces
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @sgt-form-enlaces-fo
            column: TIPO
            dataType: varchar2
        }
        help {
            inlineHelpText: Seleccionar el tipo de enlace
            helpText:
                ```html
                <p>
                Opciones:
                <p>
                    <ul>
                	
                <li>Troncal: Unión de sitios diferentes.</li>
                <li>Interno: Cableado interno dentro de un sitio dado.</li>
                <li>Acceso: Conexiones a gabinetes de poste, reconectadores o cualquier otro equipo externo ubicado fuera de un sitio.</li>
                <li>De Terceros: El enlace no pertenece a ANDE.</li>
                
                	    </ul>
                </p>
                
                ```
        }
    )

