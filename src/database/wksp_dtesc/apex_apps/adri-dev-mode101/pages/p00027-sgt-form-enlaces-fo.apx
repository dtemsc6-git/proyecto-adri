    pageItem P27_EQUIPO_ID_A (
        type: popupLov
        label {
            label: Equipo Lado A
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nombre Mostrar, e.id Valor from SGT_EQUIPOS e
                left join sgt_racks r on e.rack_id = r.id
                left join sgt_salas s on r.sala_id = s.id
                left join sgt_sitios ss on s.sitio_id = ss.id
                where ss.id = :P27_SITIO_ID_A AND e.tipo_equipo_id = 11
                ```
            displayExtraValues: false
            nullDisplayValue: Valor no asignado
        }
        cascadingLov {
            parentItems: P27_SITIO_ID_A
            itemsToSubmit: P27_SITIO_ID_A
        }
        layout {
            sequence: 40
            region: @datos-enlaces
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-enlaces-fo
            column: EQUIPO_ID_A
            dataType: number
        }
        help {
            inlineHelpText: Seleccionar el DIO de inicio del enlace
        }
    )

    pageItem P27_EQUIPO_ID_B (
        type: popupLov
        label {
            label: Equipo Lado B
