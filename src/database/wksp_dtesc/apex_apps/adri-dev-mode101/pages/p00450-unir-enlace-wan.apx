                }
            }
            
            // Uso en APEX
            var miGrafo = new HierarchicalGraph("network");
            
            // Agregar nodo con hijos
            miGrafo.agregarNodoConHijos("JumboSW_SMI", "JumboSW_SMI", [
                { label: "S1_TC3840A_GE1/2", relacion: "interfaz" },
                { label: "S1_TC3840A_GE2/3", relacion: "interfaz" },
                { label: "S1_TC3840A_GE3/4", relacion: "interfaz" }
            ]);
            
            // Expandir nodo existente
            miGrafo.expandirNodo("JumboSW_SMI_child_0", [
                { label: "DO_SMI_PCA_ARMOR2", relacion: "conexión" }
            ]); */
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region controles (
        name: controles
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region network (
        name: network
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                i-h640
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: network
        }
    )

    pageItem P450_EQUIPOS (
        type: popupLov
        label {
            label: Equipos
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nombre, id from sgt_equipos
                where rack_id = :P450_RACKS
                ```
        }
        cascadingLov {
            parentItems: P450_RACKS
            itemsToSubmit: P450_RACKS
        }
        layout {
            sequence: 30
            region: @controles
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P450_RACKS (
        type: popupLov
        label {
            label: New
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @racks-nombre-compuesto
        }
        layout {
            sequence: 10
            region: @controles
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button agregar (
        buttonName: Agregar
        label: Agregar
        layout {
            sequence: 40
            region: @controles
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction agregar (
        name: Agregar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @agregar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    level =+10;
                    
                    data.nodes.add(
                        {
                            id:  $v("P450_EQUIPOS"),
                            label: $("#P450_EQUIPOS").val()+": "+ $v("P450_EQUIPOS"),
                            shape: "box", // Forma para interfaces
                            level: level
                        }
                    );
                    
                    network.redraw();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

