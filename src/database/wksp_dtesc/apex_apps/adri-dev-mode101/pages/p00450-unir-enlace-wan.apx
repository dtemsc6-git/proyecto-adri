                            to: childId,
                            label: hijo.relacion || "conexión"
                        });
                    });
                    
                    // Refrescar vista
                    this.network.fit();
                }
                
                expandirNodo(nodeId, hijos) {
                    var node = this.nodes.get(nodeId);
                    var currentLevel = node.level || 0;
                    
                    hijos.forEach((hijo, index) => {
                        var childId = `${nodeId}_child_${index}`;
                        
