    process conexiones-puertos (
        name: CONEXIONES_PUERTOS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                L_NODES CLOB;
                l_edges CLOB;
                
                begin
                    
                      apex_debug.message('dmf: CONEXIONES_PUERTOS: %s', :P403_CONEXIONES); 
                
                        L_NODES := GET_NODOS_IFACE_WAN(:P403_CONEXIONES);
                      --L_EDGES := GET_EDGES_IFACE(:P400_SERVICIO_ID);
                
                      htp.p(
                      JSON_OBJECT(
                        'nodes' VALUE L_NODES FORMAT JSON,
                        'edges' VALUE l_edges FORMAT JSON
                      )
                      );
                
                    end;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 18949393389977208
        }
    )

    process datos-grafo (
        name: DATOS_GRAFO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                l_cursor SYS_REFCURSOR;
                begin
                
                open l_cursor for
                
                select s.id ORIGEN_ID, s.siglas ORIGEN
                from sgt_sitios s 
                where s.id in (SELECT column_value 
                        FROM apex_string.split_numbers(:P402_SITIOS, ',')
                );
                
                APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE('data', l_cursor); -- Convierte el cursor a JSON array
                    APEX_JSON.CLOSE_OBJECT;
                
                    end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 85693682171725747628
        }
    )

    process procesar-datos (
        name: PROCESAR_DATOS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_seq NUMBER := 10;
                BEGIN
                    -- ===========================================
                    -- 1. BORRAR datos relacionados existentes
                    -- ===========================================
                    DELETE FROM sgt_sitios_enlace_wan
                    WHERE enlace_wan_id = :P401_ID;
                
                    DELETE FROM sgt_conexiones_enlace_wan
                    WHERE enlace_wan_id = :P401_ID;
                
                    DELETE FROM sgt_equipos_wan
                    WHERE wan_id = :P401_ID;
                
                    -- ===========================================
                    -- 2. INSERTAR o ACTUALIZAR datos del ENLACE_WAN
                    -- ===========================================
                    IF :P401_ID IS NULL THEN
                    -- Nuevo registro
                    INSERT INTO sgt_enlaces_wan (nombre, grupo_red)
                    VALUES (:P401_NOMBRE, :P401_GRUPO_RED)
                    RETURNING id INTO :P401_ID;
                ELSE
                    -- Actualizar existente
                    UPDATE sgt_enlaces_wan
                    SET nombre    = :P401_NOMBRE,
                        grupo_red = :P401_GRUPO_RED
                    WHERE id = :P401_ID;
                END IF;
                
                
                    -- ===========================================
                    -- 3. INSERTAR datos en SITIOS_ENLACE_WAN
                    -- ===========================================
                    l_seq := 10;
                    FOR rec IN (
                        SELECT column_value AS sitio_id
                        FROM TABLE(apex_string.split_numbers(:P402_SITIOS, ','))
                        ORDER BY ROWNUM
                    )
                    LOOP
                        INSERT INTO sgt_sitios_enlace_wan (
                            sitio_id,
                            enlace_wan_id,
                            seq
                        ) VALUES (
                            rec.sitio_id,
                            :P401_ID,
                            l_seq
                        );
                        l_seq := l_seq + 10;
                    END LOOP;
                
                    -- ===========================================
                    -- 4. INSERTAR datos en CONEXIONES_ENLACE_WAN
                    -- ===========================================
                    l_seq := 10;
                    FOR rec IN (
                        SELECT column_value tramo_id
                        FROM TABLE(apex_string.split_numbers(:P403_CONEXIONES, ','))
                        ORDER BY ROWNUM
                    )
                    LOOP
                        INSERT INTO sgt_conexiones_enlace_wan (
                            enlace_tramo_id,
                            enlace_wan_id,
                            secuencia
                        ) VALUES (
                            rec.tramo_id,
                            :P401_ID,
                            l_seq
                        );
                        l_seq := l_seq + 10;
                    END LOOP;
                
                    --======================================= 
                    --.5 Insertar datos en sgt_equipos_wan
                    --=======================================
                     l_seq := 10;
                    FOR rec IN (
                        SELECT column_value equipo_id
                        FROM TABLE(apex_string.split_numbers(:P405_EQUIPOS, ','))
                        ORDER BY ROWNUM
                    )
                    LOOP
                        INSERT INTO sgt_equipos_wan (
                            equipo_id,
                            wan_id,
                            seq
                        ) VALUES (
                            rec.equipo_id,
                            :P401_ID,
                            l_seq
                        );
                        l_seq := l_seq + 10;
                    END LOOP;
                
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Se ha creado el enlace WAN
        }
        error {
            errorMessage: No se pudo crear el enlace WAN
        }
        advanced {
