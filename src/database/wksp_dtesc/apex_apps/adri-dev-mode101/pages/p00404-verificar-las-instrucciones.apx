    region conexiones-2 (
        name: CONEXIONES
        title: Conexiones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with seleccionados as (
                    SELECT column_value tramo_id
                        FROM TABLE(apex_string.split_numbers(:P403_CONEXIONES, ','))
                        ORDER BY ROWNUM
                )
                SELECT 
                    
                   t.equipo_a || ':'|| t.interfaz_a ||'►'|| t.equipo_b || ':'|| t.interfaz_b Conexión
                    
                FROM 
                    V_TRAMOS_NOMBRES t join seleccionados s on t.id = s.tramo_id
                order by rownum
                
                
                ```
        }
