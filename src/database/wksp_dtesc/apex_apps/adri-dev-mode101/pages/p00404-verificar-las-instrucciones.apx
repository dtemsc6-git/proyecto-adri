page 404 (
    name: Verificar las instrucciones
    alias: VERIFICAR-LAS-INSTRUCCIONES
    title: Verificar las instrucciones
    pageGroup: @wzrd-wan
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: https://unpkg.com/vis-network/standalone/umd/vis-network.min.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /*
            Para crear el grafo en esta ventana siempre sera una union del primero con el siguiente. si la cantidad de 
            nodos es mayor a dos ver si vale la pena crear un enlace entre el primero y el ultimo
             */
            
            apex.server.process(
            
                //'CONEXIONES_PUERTOS', { pageItems: '' },
                'DATOS_GRAFO', { pageItems: '' },
                {
                    success: function (apiData) {
                        console.log(apiData.data); // Acceder a los datos
            
                        const nodes = [];
                        const edges = [];
                        var destino = null;
            
                        apiData.data.forEach(connection => {
            
                            console.log(connection);
                            nodes.push({
                                id: connection.ORIGEN_ID,
                                label: connection.ORIGEN,
                                group: "sitios",
                                shape: "box", //
                                color: "#FF9900"
                            });
            
                            if (destino != null) {
                                edges.push({
                                    from: destino.ORIGEN_ID,
                                    to: connection.ORIGEN_ID ,
                                    arrows: "to", // Flecha indica dirección
                                    color: "#848484" // Color de la línea
                                });
                            }
                            destino = connection;
            
                        });
                        
                        nodes.reverse();
            
                        var data = { nodes: nodes, edges: edges };
                        
            
                        var container = document.getElementById("network");
                        var network = new vis.Network(container, data, {
                            layout: { hierarchical: { enabled: true, direction: "RL" }, },
                            physics: { enabled: false, solver: "forceAtlas2Based" }
                        });
                    }
            
            
                    ,
                    error: function (pError) {
                        console.error('Error:', pError);
                    }
                }
            );
            
            ```
    }
