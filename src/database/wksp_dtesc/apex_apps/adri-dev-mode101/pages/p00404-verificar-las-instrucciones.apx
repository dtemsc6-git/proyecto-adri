            sqlQuery:
                ```sql
                with seleccionados as (
                    SELECT column_value equipo_id
                        FROM TABLE(apex_string.split_numbers(:P405_EQUIPOS, ','))
                        ORDER BY ROWNUM
                )
                SELECT 
                    
