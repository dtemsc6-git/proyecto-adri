        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-enlaces-fo (
        name: SGT_ENLACES_FO_2
        title: Enlaces FO
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fo.ID,
                       
                       '<ul>' ||
                        '<li><a href='||APEX_PAGE.GET_URL(p_page => 27, p_items => 'P27_ID', p_values => fo.ID )||'>Editar</a></li>' || 
                        '<li><a href='||APEX_PAGE.GET_URL(p_page => 15, p_items => 'P15_ENTIDAD,P15_PK_ID', p_values =>  '5,' || fo.ID )||'>KMZ</a></li>' || 
                        '<li><a href='||APEX_PAGE.GET_URL(p_page => 64, p_items => 'P64_ID', p_values =>  fo.ID )||'>Dependencias</a></li>' || 
                        --'<li><a href='||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:27:&APP_SESSION.::::P27_ID:'|| fo.ID )||'>Editar</a></li>' || 
                        --'<li><a href='||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:15:&APP_SESSION.:::15:P15_ENTIDAD,P15_PK_ID:5,' || fo.ID )||'>KMZ</a></li>' || 
                      
                        '</ul>'
                
                       as ACCIONES,
                
                       fo.NOMBRE,
                       fo.SITIO_ID_A,
                       s_a.siglas SITIO_A,
                       fo.EQUIPO_ID_A,
                       eq_a.nombre EQUIPO_A,
                       fo.SITIO_ID_B,
                       s_b.siglas SITIO_B,
                       fo.EQUIPO_ID_B,
                       eq_b.nombre EQUIPO_B,
                       fo."CERTIFICACIÓN",
                       fo.UNIDAD_MEDIDA,
                       fo.ABS_LONGITUD,
                       fo.CANTIDAD_DE_PELOS,
                       fo.TIPO_DE_FO,
                       fo.TIPO,
                       fo.LT,
                       fo.CONECTOR,
                       fo.ESTADO,
                       NVL(C.COMENTARIO, 'Ver') as COMENTARIOS,
                       --fo.COMENTARIOS AS OBSERVACIONES,
                       fo."PROYECTO_DE_IMPLEMENTACIÓN",
                       fo."FECHA_IMPLEMENTACIÓN",
                       fo.UNIDAD_ENCARGADA_ACTUAL,
                       fo.CREADO_POR,
                       fo.CREADO_EL,
                       fo.ACTUALIZADO_POR,
                       fo.ACTUALIZADO_EL,
                       fo.TIPO_CABLE,
                       fo.TIPO_TENDIDO,
                       fo.PUERTOS_LADO_A,
                       fo.PUERTOS_LADO_B
                  from SGT_ENLACES_FO fo
                --Agregar comentarios
                LEFT JOIN (
                    SELECT PK_ID, 
                           COMENTARIO, 
                           ROW_NUMBER() OVER (PARTITION BY PK_ID ORDER BY CREADO_EL DESC) AS rn
                    FROM SGT_COMENTARIOS
                    WHERE ENTIDAD = 5
                ) C ON C.PK_ID = fo.ID AND C.rn = 1
                --
                  LEFT JOIN sgt_equipos eq_a on fo.equipo_id_a = eq_a.id
                  LEFT JOIN sgt_equipos eq_b on fo.equipo_id_b = eq_b.id
                  LEFT JOIN sgt_sitios s_a on fo.sitio_id_a = s_a.id
                  LEFT JOIN sgt_sitios s_b on fo.sitio_id_b = s_b.id
                
                  order by fo.ACTUALIZADO_EL DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
