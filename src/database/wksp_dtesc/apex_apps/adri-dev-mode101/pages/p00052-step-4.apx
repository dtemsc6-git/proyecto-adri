page 52 (
    name: Step 4
    alias: STEP-4
    title: Seleccionar Circuitos Fisicos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/wizard-modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 400
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function filtrarShuttle() {
            var filtro = $("#P52_BUSCAR_CONEXIONES").val();
                var filtroLower = filtro.toLowerCase();
                var opciones = document.querySelectorAll("#P52_CIRCUITOS_FISICOS_LEFT option");
            
                opciones.forEach(function (opt) {
                    if (opt.text.toLowerCase().includes(filtroLower)) {
                        opt.style.display = "";   // mostrar
                    } else {
                        opt.style.display = "none"; // ocultar
                    }
                });
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: wizardButtons
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @step
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
    )

    region step (
        name: Step 3
        type: staticContent
        layout {
            sequence: 10
            slot: wizardBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region wizard-progress (
        name: Wizard Progress
        type: list
        source {
            list: @asistente-servicios
        }
        layout {
            sequence: 10
            slot: wizardProgressBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    pageItem P52_BUSCAR_CONEXIONES (
        type: textField
        label {
            label: Buscar Conexiones
            alignment: left
        }
        layout {
            sequence: 20
            region: @step
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P52_CIRCUITOS_FISICOS (
        type: shuttle
        label {
            label: Seleccione los Circuitos Fisicos
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    SITIO_A||'.'||EQUIPO_A || ':' || INTERFAZ_A || '>' || SITIO_B||'.'||EQUIPO_B || ':' || INTERFAZ_B AS display_value,
                    conexiones.id AS return_value
                FROM v_tramos_nombres conexiones
                WHERE conexiones.sitio_a_id IN (
                    SELECT column_value FROM apex_string.split_numbers(:P51_SITIOS_TRANSITO, ',')
                )
                --and 
                --conexiones.id not in ( 
                --    select enlace_tramo_id 
                --    from sgt_conexiones_enlace_wan wan 
                --    where wan.enlace_wan_id in (
                --        SELECT column_value FROM apex_string.split_numbers(:P53_ENLACES_WAN, ',')
                --    )
                --    )
                
                ```
            displayExtraValues: false
        }
        multipleValues {
            separator: ,
        }
        layout {
            sequence: 40
            region: @step
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: sqlQueryMultipleValues
            sqlQuery:
                ```sql
                select enlace_tramo_id from sgt_conexiones_servicio
                where servicio_id = :P50_ID
                union
                select enlace_tramo_id from sgt_conexiones_enlace_wan
                where enlace_wan_id in (
                SELECT column_value 
                        FROM apex_string.split_numbers(:P53_ENLACES_WAN, ',') 
                        
                )
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 20
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P52_BUSCAR_CONEXIONES
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: filtrarShuttle();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction nosubmit (
        name: NoSubmit
        execution {
            sequence: 30
        }
        when {
            event: keypress
            selectionType: items
            items: P52_BUSCAR_CONEXIONES
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (event.key === "Enter") {
                       filtrarShuttle(); 
                       event.preventDefault(); // evita el submit
                        return false;
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 53
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {
                page: 53
            }
        }
        serverSideCondition {
            whenButtonPressed: @previous
        }
    )

    branch (
        name: Go To Page 54
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 54
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

