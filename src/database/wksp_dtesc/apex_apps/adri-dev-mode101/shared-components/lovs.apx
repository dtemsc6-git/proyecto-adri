lov enlaces-wan-filtrado-en-uso (
    name: ENLACES_WAN.FILTRADO_EN_USO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT WAN.NOMBRE, WAN.ID FROM 
            SGT_EQUIPOS_WAN EW
            INNER JOIN SGT_ENLACES_WAN WAN ON
            EW.WAN_ID = WAN.ID
            ORDER BY WAN.ID  
            ```
    }
    columnMapping {
        return: ID
        display: NOMBRE
    }
)

lov enlaces-wan-filtrado-sitios (
    name: ENLACES_WAN.FILTRADO_SITIOS
    source {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            RETURN 'SELECT distinct w.nombre, W.id
            FROM sgt_enlaces_wan w
            JOIN sgt_equipos_wan ew   ON w.id = ew.wan_id
            JOIN v_sitios_equipos vse ON vse.equipo_id = ew.equipo_a_id
            WHERE (:SITIO_ID IS NULL OR vse.sitio_id = :SITIO_ID)
            ORDER BY W.NOMBRE
            '
            ```
    }
    columnMapping {
        return: ID
        display: NOMBRE
        defaultSort: NOMBRE
    }
)

lov enlaces-wan-grupo-red (
