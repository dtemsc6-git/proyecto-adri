lov ciudad-nombre-compuesto (
    name: CIUDAD.NOMBRE-COMPUESTO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select C.ID VALOR, D.NOMBRE||', '||C.NOMBRE  DISPLAY, D.ID DEPTO_ID from SGT_CIUDAD C
            JOIN SGT_DEPTO D ON C.DEPTO_ID = D.ID
            ORDER BY DISPLAY
            ```
    }
    columnMapping {
        return: VALOR
        display: DISPLAY
    }
)

lov conexiones-equipo-a-nombre (
    name: CONEXIONES.EQUIPO_A.NOMBRE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT E.NOMBRE , E.ID FROM 
            SGT_ENLACES_TRAMOS ET
            INNER JOIN SGT_EQUIPOS E
            ON ET.EQUIPO_A_ID = E.ID
            ORDER BY E.ID
            ```
    }
    columnMapping {
        return: ID
        display: NOMBRE
    }
)

