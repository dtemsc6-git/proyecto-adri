lov interfaces-nombre-compuesto (
    name: INTERFACES.NOMBRE-COMPUESTO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT UPPER(SS.SIGLAS ||'.'|| S.SIGLAS ||'.'|| R.NOMBRE || '.'|| E.NOMBRE ||'.'||I.NOMBRE) NOMBRE, I.ID  VALOR  
                    
                    FROM sgt_interfaces I
                    LEFT JOIN SGT_EQUIPOS E  on i.equipo_id = e.id
                    LEFT JOIN SGT_RACKS R ON E.RACK_ID = R.ID  
                    LEFT JOIN SGT_SALAS S ON R.SALA_ID = S.ID  
                    LEFT JOIN SGT_SITIOS SS ON S.SITIO_ID = SS.ID  
            ORDER BY NOMBRE
            ```
    }
    columnMapping {
        return: VALOR
        display: NOMBRE
    }
)

lov interfaces-nombre-equiqueta (
    name: INTERFACES.NOMBRE:EQUIQUETA
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT 
            CASE WHEN ETIQUETA IS NOT NULL THEN NOMBRE ||' : '||ETIQUETA  ELSE NOMBRE END DISPLAY, ID VALUE FROM SGT_INTERFACES
            ORDER BY ID
            ```
    }
    columnMapping {
        return: VALUE
        display: DISPLAY
    }
)

