lov lov-sgt-racks-filtrado (
    name: LOV_SGT_RACKS_FILTRADO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 
                   S.SIGLAS||'.'||R.NOMBRE MOSTRAR,
                   R.ID VALOR        
              from SGT_RACKS R
              LEFT JOIN SGT_SALAS S ON R.SALA_ID = S.ID
              left join SGT_SITIOS SS ON S.SITIO_ID = SS.ID
             where
             SS.ID = :P14_SITIO_ID
            ```
    }
    columnMapping {
        return: VALOR
        display: MOSTRAR
    }
)

