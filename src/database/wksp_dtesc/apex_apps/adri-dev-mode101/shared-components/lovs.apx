lov racks-nombre-compuesto (
    name: RACKS.NOMBRE-COMPUESTO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 
                   SS.SIGLAS||'.'||S.SIGLAS||'.'||R.NOMBRE MOSTRAR,
                   R.ID VALOR        
              from SGT_RACKS R
              LEFT JOIN SGT_SALAS S ON R.SALA_ID = S.ID
              LEFT JOIN SGT_SITIOS SS ON S.SITIO_ID = SS.ID
            ```
    }
    columnMapping {
        return: VALOR
        display: MOSTRAR
        defaultSort: MOSTRAR
    }
)

lov racks-nombres (
    name: RACKS.NOMBRES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT SGT_SITIOS.SIGLAS || '.'|| SGT_SALAS.SIGLAS ||'.'||SGT_RACKS.NOMBRE AS MOSTRAR , SGT_RACKS.ID AS CLAVE
            FROM SGT_RACKS INNER JOIN
            SGT_SALAS ON SGT_RACKS.SALA_ID = SGT_SALAS.ID
            INNER JOIN
            SGT_SITIOS ON SGT_SALAS.SITIO_ID = SGT_SITIOS.ID
            ```
    }
    columnMapping {
        return: CLAVE
        display: MOSTRAR
    }
)

lov salas-nombre (
    name: SALAS.NOMBRE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT SGT_SITIOS.SIGLAS || '.'|| SGT_SALAS.SIGLAS AS MOSTRAR , SGT_SALAS.ID AS CLAVE
            FROM SGT_SALAS INNER JOIN
            SGT_SITIOS ON SGT_SALAS.SITIO_ID = SGT_SITIOS.ID
            ```
    }
    columnMapping {
        return: CLAVE
        display: MOSTRAR
    }
)

