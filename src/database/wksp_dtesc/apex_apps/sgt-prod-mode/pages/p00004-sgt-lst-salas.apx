page 4 (
    name: SGT_LST_SALAS
    alias: SGT-LST-SALAS
    title: Lista de salas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-lst-salas (
        name: SGT_LST_SALAS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SGT_SALAS.ID,
                       sgt_sitios.id as SITIO_ID,
                       SGT_SITIOS.SIGLAS ||' - '||SGT_SITIOS.NOMBRE AS SITIO,
                       SGT_SALAS.SIGLAS AS SIGLAS,
                       SGT_SALAS.NOMBRE AS NOMBRE
                  from SGT_SALAS
                
                  LEFT join SGT_SITIOS
                  ON (SGT_SITIOS.ID = SGT_SALAS.SITIO_ID)
                
                  ORDER BY SGT_SALAS.ID DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 5
                items: {
                    P5_ID: #ID#
                    P5_TITULO: Editar sala
                }
                clearCache: 5
                action: clearRegions
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @implementador-rights
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            searchButtonLabel: Buscar
        }
        actionsMenu {
            controlBreak: false
            highlight: false
            compute: false
            aggregate: false
            chart: false
            groupBy: false
            pivot: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 81469246799019636977
        }

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre Sala
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column SIGLAS (
            type: plainText
            heading {
                heading: Sigla Sala
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column SITIO (
            type: plainText
            heading {
                heading: Sitio
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column SITIO_ID (
            type: hidden
            heading {
                heading: Sitio Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 814742452 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn NOMBRE (
                sequence: 2
            )

            displayColumn SIGLAS (
                sequence: 3
            )

            displayColumn SITIO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 10
            region: @sgt-lst-salas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                items: {
                    P5_TITULO: Agregar sala
                }
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @implementador-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-lst-salas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-lst-salas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

