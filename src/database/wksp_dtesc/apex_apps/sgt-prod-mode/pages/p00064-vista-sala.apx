page 64 (
    name: Vista Sala
    alias: VISTA-SALA
    title: Vista Sala
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region vista-sala (
        name: Vista Sala
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.nombre, r.detalle from sgt_racks r
                where r.sala_id = :P64_SALA_ID
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }

        column DETALLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Detalle
            }
            layout {
                sequence: 12
            }
        )

        column NOMBRE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nombre
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    pageItem P64_SALA_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

