page 10 (
    name: Grilla enlaces WAN
    alias: GRILLA-ENLACES-WAN
    title: Grilla enlaces WAN
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region grilla-enlaces-wan (
        name: Grilla enlaces WAN
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_ENLACES_WAN
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 20792940185532552
        }

        savedReport 207934 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 78.64100000000002
                    sequence: 1
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    show: false
                    sequence: 8
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    show: false
                    sequence: 7
                }
            )

            displayColumn (
                column: @CREADO_EL
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @CREADO_POR
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @GRUPO_RED
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @NOMBRE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

        )

        column ACTUALIZADO_EL (
            type: displayOnly
            heading {
                heading: Actualizado El
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: timestamp
                queryOnly: true
            }
        )

        column ACTUALIZADO_POR (
            type: displayOnly
            heading {
                heading: Actualizado Por
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CREADO_EL (
            type: displayOnly
            heading {
                heading: Creado El
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: CREADO_EL
                dataType: timestamp
                queryOnly: true
            }
        )

        column CREADO_POR (
            type: displayOnly
            heading {
                heading: Creado Por
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: CREADO_POR
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column GRUPO_RED (
            type: selectList
            heading {
                heading: Grupo Red
            }
            lov {
                type: sharedComponent
                lov: @enlaces-wan-grupo-red
                nullDisplayValue: Seleccione una
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: GRUPO_RED
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                sort: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NOMBRE (
            type: textField
            heading {
                heading: Nombre
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 255
            }
            source {
                databaseColumn: NOMBRE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Grilla enlaces WAN
        }
    )

    process grilla-enlaces-wan-save-interactive-grid-data (
        name: Grilla enlaces WAN - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @grilla-enlaces-wan
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20568557260227132
        }
    )

)

