page 11 (
    name: SGT_LST_RACKS
    alias: SGT-LST-RACKS
    title: Lista de racks
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-lst-racks (
        name: SGT_LST_RACKS
        title: Lista Racks
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SGT_RACKS.ID,
                        
                  '<a class="fa fa-search" title="Ver rack">Ver</a>'  ACCIONES , 
                
                
                       sitios.siglas ||'.'|| salas.siglas SALA, 
                       SGT_RACKS.NOMBRE NOMBRE,
                       DETALLE,
                       UNIDAD_ENCARGADA,
                       MARCA,
                       MODELO,
                       DIMENSIONES,
                       ALTURA_U
                  from SGT_RACKS
                inner join SGT_SALAS salas
                on SGT_RACKS.SALA_ID = salas.ID
                inner join SGT_SITIOS sitios
                on sitios.ID = salas.SITIO_ID
                
                ORDER BY SGT_RACKS.ID DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 12
                items: {
                    P12_ID: \#ID#\
                    P12_TITULO: Editar rack
                }
                clearCache: 12
                action: clearRegions
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @implementador-rights
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            controlBreak: false
            highlight: false
            compute: false
            aggregate: false
            chart: false
            groupBy: false
            pivot: false
            flashback: false
            saveReport: false
            reset: false
            help: false
        }
        advanced {
            savedReportMappingIdentifier: 79373491691321883607
        }

        column ACCIONES (
            type: link
            heading {
                heading: Acciones
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 37
                    items: {
                        P37_RACK_ID: #ID#
                    }
                }
                linkText: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
                linkAttributes: #ID#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Y
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
            security {
                escapeSpecialChars: false
            }
            config {
                buildOption: @commented-out
            }
        )

        column ALTURA_U (
            type: plainText
            heading {
                heading: Altura U
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column DETALLE (
            type: plainText
            heading {
                heading: Detalle/Descripción
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
            enableUsersTo {
                hide: false
            }
        )

        column DIMENSIONES (
            type: plainText
            heading {
                heading: Dimensiones
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column MARCA (
            type: plainText
            heading {
                heading: Marca
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column MODELO (
            type: plainText
            heading {
                heading: Modelo
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column NOMBRE (
            type: link
            heading {
                heading: Sigla/Nombre del Rack
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 37
                    items: {
                        P37_RACK_ID: #ID#
                        P37_RACK_NOMBRE: #NOMBRE#
                    }
                    clearCache: 37
                }
                linkText: #NOMBRE#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
            enableUsersTo {
                hide: false
            }
        )

        column SALA (
            type: plainText
            heading {
                heading: Sala
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
            enableUsersTo {
                hide: false
            }
        )

        column UNIDAD_ENCARGADA (
            type: plainText
            heading {
                heading: Unidad Encargada
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: X
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: SGT_LST_RACKS
        }

        savedReport 793735020 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCIONES (
                sequence: 1
            )

            displayColumn ALTURA_U (
                sequence: 4
            )

            displayColumn DETALLE (
                sequence: 5
            )

            displayColumn DIMENSIONES (
                sequence: 8
            )

            displayColumn MARCA (
                sequence: 6
            )

            displayColumn MODELO (
                sequence: 7
            )

            displayColumn NOMBRE (
                sequence: 3
            )

            displayColumn SALA (
                sequence: 2
            )

            displayColumn UNIDAD_ENCARGADA (
                sequence: 9
            )

        )

    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 10
            region: @sgt-lst-racks
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                items: {
                    P12_TITULO: Agregar rack
                }
                clearCache: 12
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @implementador-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-lst-racks
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-lst-racks
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

