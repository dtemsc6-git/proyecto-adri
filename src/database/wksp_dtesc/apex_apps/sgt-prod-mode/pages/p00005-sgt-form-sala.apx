page 5 (
    name: SGT_FORM_SALA
    alias: SGT-FORM-SALA
    title: Formulario Sala
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sgt-form-sala (
        name: SGT_FORM_SALA
        type: form
        source {
            location: localDatabase
            tableName: SGT_SALAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P5_CIUDAD (
        type: popupLov
        label {
            label: Departamento, Ciudad
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @ciudad-nombre-compuesto
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @sgt-form-sala
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            inlineHelpText: Seleccionar departamento, ciudad donde se encuentra ubicada la sala
        }
    )

    pageItem P5_DEPTO (
        type: selectList
        label {
            label: Departamento
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-sgt-dpto
        }
        layout {
            sequence: 30
            region: @sgt-form-sala
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P5_ID (
        type: hidden
        layout {
            sequence: 20
            region: @sgt-form-sala
            slot: regionBody
        }
        source {
            formRegion: @sgt-form-sala
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_NOMBRE (
        type: textarea
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 70
            region: @sgt-form-sala
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            formRegion: @sgt-form-sala
            column: NOMBRE
            dataType: varchar2
        }
        help {
            inlineHelpText: Indicar nombre o descripción identificatoria de la sala
        }
    )

    pageItem P5_SIGLAS (
        type: textField
        label {
            label: Sigla Sala
            alignment: left
        }
        layout {
            sequence: 60
            region: @sgt-form-sala
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            formRegion: @sgt-form-sala
            column: SIGLAS
            dataType: varchar2
        }
        help {
            inlineHelpText: Asignar sigla/abreviación identificatoria de la sala (nombre corto). Ejemplo: SC01
        }
    )

    pageItem P5_SITIO_ID (
        type: selectList
        label {
            label: Sitio
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select siglas ||' - '||nombre, id from sgt_sitios
                where ciudad_id = :P5_CIudad
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P5_CIUDAD
            itemsToSubmit: P5_CIUDAD
        }
        layout {
            sequence: 50
            region: @sgt-form-sala
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @sgt-form-sala
            column: SITIO_ID
            dataType: number
        }
        help {
            inlineHelpText: Seleccionar el sitio donde se encuentra ubicada la sala
        }
    )

    pageItem P5_TITULO (
        type: hidden
        layout {
            sequence: 10
            region: @sgt-form-sala
            slot: regionBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Eliminar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_ID
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$BTN_APLICAR_CAMBIOS!RAW.
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_ID
        }
    )

    dynamicAction actualizar-título-de-página (
        name: Actualizar título de página
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).ready(function() {
                    
                    apex.util.getTopApex().jQuery(".ui-dialog-content").dialog("option", "title", "&P5_TITULO.");
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process actualizar-editar (
        name: Actualizar editar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SELECT s.CIUDAD_ID, c.DEPTO_ID
                    INTO :P5_CIUDAD, :P5_DEPTO
                    FROM SGT_SITIOS s
                    JOIN SGT_CIUDAD c ON s.CIUDAD_ID = c.ID
                    WHERE s.ID = :P5_SITIO_ID;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        :P5_CIUDAD := NULL;
                        :P5_DEPTO := NULL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14912547453776650601
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 81469245628538636976
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sgt-form-sala (
        name: Initialize form SGT_FORM_SALA
        type: formInitialization
        formRegion: @sgt-form-sala
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 81469244830794636975
        }
    )

    process process-form-sgt-form-sala (
        name: Process form SGT_FORM_SALA
        type: formAutoRowProcessing
        formRegion: @sgt-form-sala
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 81469245255424636975
        }
    )

)

