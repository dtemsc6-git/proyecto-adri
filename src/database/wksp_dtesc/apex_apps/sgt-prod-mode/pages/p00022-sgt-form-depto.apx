page 22 (
    name: SGT_FORM_DEPTO
    alias: SGT-FORM-DEPTO
    title: Formulario Departamento
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sgt-form-depto (
        name: SGT_FORM_DEPTO
        type: form
        source {
            location: localDatabase
            tableName: SGT_DEPTO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P22_CAPITAL (
        type: textField
        label {
            label: Capital
            alignment: left
        }
        layout {
            sequence: 40
            region: @sgt-form-depto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @sgt-form-depto
            column: CAPITAL
            dataType: varchar2
        }
    )

    pageItem P22_ID (
        type: hidden
        layout {
            sequence: 20
            region: @sgt-form-depto
            slot: regionBody
        }
        source {
            formRegion: @sgt-form-depto
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P22_NOMBRE (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 30
            region: @sgt-form-depto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @sgt-form-depto
            column: NOMBRE
            dataType: varchar2
        }
    )

    pageItem P22_TITULO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @sgt-form-depto
            slot: regionBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Agregar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P22_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Eliminar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P22_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P22_ID
        }
    )

    dynamicAction actualizar-titulo-de-página (
        name: Actualizar titulo de página
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        comments {
            comments: Acción dinámica para actualizar titulo de página según boton oprimido
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).ready(function() {
                    
                    apex.util.getTopApex().jQuery(".ui-dialog-content").dialog("option", "title", "&P22_TITULO.");
                    });
                    ```
            }
            affectedElements {
                selectionType: region
                region: @sgt-form-depto
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 6036840359111672388
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sgt-form-depto (
        name: Initialize form SGT_FORM_DEPTO
        type: formInitialization
        formRegion: @sgt-form-depto
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6036839531116672387
        }
    )

    process process-form-sgt-form-depto (
        name: Process form SGT_FORM_DEPTO
        type: formAutoRowProcessing
        formRegion: @sgt-form-depto
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6036839961543672387
        }
    )

)

