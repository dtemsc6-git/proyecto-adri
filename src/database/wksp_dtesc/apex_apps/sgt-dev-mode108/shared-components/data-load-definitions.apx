dataLoadDefinition conexiones_dl (
    name: CONEXIONES_DL
    target {
        tableName: SGT_ENLACES_TRAMOS
    }
    dataProfile {
        name: CONEXIONES_DL
        format: xlsx
    }
    advanced {
        encoding: utf-8
        defaultXlsxSheetName: sheet1.xml
    }

    dataProfileColumn equipo-a (
        columnName: EQUIPO_A
        source {
            sequence: 10
            dataType: varchar2
        }
        parsing {
            selector: EQUIPO_A
        }
    )

    dataProfileColumn equipo-a-id (
        columnName: EQUIPO_A_ID
        source {
            sequence: 60
            type: sqlExpression
            dataType: number
        }
        computation {
            sqlExpression: SELECT F_GET_LOVS(1, EQUIPO_A) FROM DUAL
        }
    )

    dataProfileColumn equipo-b (
        columnName: EQUIPO_B
        source {
            sequence: 30
            dataType: varchar2
        }
        parsing {
            selector: EQUIPO_B
        }
    )

    dataProfileColumn equipo-b-id (
        columnName: EQUIPO_B_ID
        source {
            sequence: 70
            type: sqlExpression
            dataType: number
        }
        computation {
            sqlExpression: SELECT F_GET_LOVS(1, EQUIPO_B) FROM DUAL
        }
    )

    dataProfileColumn interfaz-a (
        columnName: INTERFAZ_A
        source {
            sequence: 20
            dataType: varchar2
        }
        parsing {
            selector: INTERFAZ_A
        }
    )

    dataProfileColumn interfaz-a-id (
        columnName: INTERFAZ_A_ID
        source {
            sequence: 100
            type: sqlExpression
            dataType: number
        }
        computation {
            sqlExpression:
                ```sql
                SELECT 
                    CASE
                        WHEN INTERFAZ_A IS NULL THEN NULL
                        ELSE NVL(
                                (
                                    SELECT MAX(ID)
                                    FROM SGT_INTERFACES
                                    WHERE EQUIPO_ID = F_GET_LOVS(1, EQUIPO_A)
                                    AND NOMBRE = INTERFAZ_A
                                ),
                                0
                             )
                    END AS ID
                FROM DUAL
                ```
        }
    )

    dataProfileColumn interfaz-b (
        columnName: INTERFAZ_B
        source {
            sequence: 40
            dataType: varchar2
        }
        parsing {
            selector: INTERFAZ_B
        }
    )

    dataProfileColumn interfaz-b-id (
        columnName: INTERFAZ_B_ID
        source {
            sequence: 110
            type: sqlExpression
            dataType: number
        }
        computation {
            sqlExpression:
                ```sql
                SELECT 
                    CASE
                        WHEN INTERFAZ_B IS NULL THEN NULL
                        else  nvl( (SELECT I2.ID FROM 
                SGT_INTERFACES I2 WHERE I2.EQUIPO_ID = (
                SELECT F_GET_LOVS(1,EQUIPO_B) FROM DUAL ) AND I2.NOMBRE = INTERFAZ_B) 
                , 0) end as ID from dual
                ```
        }
    )

    dataProfileColumn nombre (
        columnName: NOMBRE
        source {
            sequence: 55
            dataType: varchar2
        }
        parsing {
            selector: OBSERVACIONES
        }
    )

    dataProfileColumn tipo-conexion (
        columnName: TIPO_CONEXION
        source {
            sequence: 50
            dataType: varchar2
        }
        parsing {
            selector: TIPO_DE_CONEXIÓN
        }
    )

)

