dataLoadDefinition agregar_ifaces_me (
    name: Agregar Interfaces ME
    target {
        tableName: SGT_INTERFACES
    }
    advanced {
        commitInterval: 500
    }
    dataProfile {
        name: A
        format: xlsx
    }
    advanced {
        encoding: utf-8
        defaultXlsxSheetName: sheet1.xml
    }

    dataProfileColumn equipo-id (
        columnName: EQUIPO_ID
        source {
            sequence: 17
            type: sqlExpression
            dataType: number
        }
        computation {
            sqlExpression: SELECT F_GET_LOVS(1, EQUIPOS) FROM DUAL
        }
    )

    dataProfileColumn equipos (
        columnName: EQUIPOS
        source {
            sequence: 1
            dataType: varchar2
        }
        parsing {
            selector: EQUIPOS
        }
    )

    dataProfileColumn estado (
        columnName: ESTADO
        source {
            sequence: 3
            dataType: varchar2
            maxLength: 1020
        }
        parsing {
            selector: ESTADO
        }
    )

    dataProfileColumn etiqueta (
        columnName: ETIQUETA
        source {
            sequence: 2
            dataType: varchar2
            maxLength: 1020
        }
        parsing {
            selector: ETIQUETA
        }
    )

    dataProfileColumn mac-address (
        columnName: MAC_ADDRESS
        source {
            sequence: 7
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: MAC_ADDRESS
        }
    )

    dataProfileColumn nombre (
        columnName: NOMBRE
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            selector: NOMBRE
        }
    )

    dataProfileColumn rx-en-dbm (
        columnName: RX_EN_DBM
        source {
            sequence: 6
            dataType: varchar2
            maxLength: 40
        }
        parsing {
            selector: RX_EN_DBM
        }
    )

    dataProfileColumn tipo-interface (
        columnName: TIPO_INTERFACE
        source {
            sequence: 5
            dataType: varchar2
        }
        parsing {
            selector: TIPO_INTERFACE
        }
    )

    dataProfileColumn tipo-interface-id (
        columnName: TIPO_INTERFACE_ID
        source {
            sequence: 27
            type: sqlExpression
            dataType: number
        }
        computation {
            sqlExpression: SELECT F_GET_LOVS(2, TIPO_INTERFACE) FROM DUAL
        }
    )

    dataProfileColumn tx-en-dbm (
        columnName: TX_EN_DBM
        source {
            sequence: 5
            dataType: varchar2
            maxLength: 40
        }
        parsing {
            selector: TX_EN_DBM
        }
    )

    dataProfileColumn velocidad-mbps (
        columnName: VELOCIDAD_MBPS
        source {
            sequence: 4
            dataType: number
        }
        parsing {
            selector: VELOCIDAD_MBPS
        }
    )

)

