dataLoadDefinition equipos_dl (
    name: EQUIPOS_DL
    target {
        tableName: SGT_EQUIPOS
    }
    comments {
        comments: Creado para remplazar al metodo de creación de equipos actual
    }
    dataProfile {
        name: EQUIPOS_DL
        format: xlsx
