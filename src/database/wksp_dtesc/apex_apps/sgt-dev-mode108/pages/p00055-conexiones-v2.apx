        column EQUIPO_A_ID (
            type: popupLov
            heading {
                heading: Equipo A
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT e.nombre, E.ID   
                            
                     FROM SGT_EQUIPOS E  
                     LEFT JOIN SGT_RACKS R ON E.RACK_ID = R.ID  
                     LEFT JOIN SGT_SALAS S ON R.SALA_ID = S.ID  
                     LEFT JOIN SGT_SITIOS SS ON S.SITIO_ID = SS.ID  
                     WHERE
                    1=1 AND 
                    ss.id = :sitio_a
                    ```
            }
            cascadingLov {
                parentColumns: SITIO_A
                itemsToSubmit: SITIO_A
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: EQUIPO_A_ID
                dataType: number
            }
        )

