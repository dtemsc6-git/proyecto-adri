    pageItem P55_ENLACE_WAN (
        type: popupLov
        label {
            label: Enlace Wan
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nombre display, id value from sgt_enlaces_wan
                where 
                1=1
                and 
                (:P55_SERVICIO IS NULL 
                OR id in 
                (select enlace_id from 
                sgt_enlaces_wan_servicio where servicio_id = :P55_servicio 
                )
                )
                ```
            nullDisplayValue: Seleccione Una
        }
        cascadingLov {
            parentItems: P55_SERVICIO
            itemsToSubmit: P55_SERVICIO
        }
        layout {
            sequence: 20
            region: @filtrado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P55_EQUIPO_A (
        type: popupLov
        label {
            label: Equipo A
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct e.nombre , e.id
                from
                sgt_equipos e
                inner join 
                  (
                    SELECT EQUIPO_A_ID EQUIPO_ID FROM SGT_ENLACES_TRAMOS
                    UNION
                    SELECT EQUIPO_B_ID EQUIPO_ID FROM SGT_ENLACES_TRAMOS
                  ) conexiones
                
                
                 ON e.id = conexiones.equipo_id  
                WHERE 
                1=1 
                AND 
                (:P55_ENLACE_WAN IS NULL OR 
                
                exists  (SELECT 1
                      FROM SGT_CONEXIONES_ENLACE_WAN WHERE ENLACE_WAN_ID = :P55_ENLACE_WAN )
                 )
                 AND 
                 (:P55_SERVICIO IS NULL OR
                 
                exists  (SELECT 1
                      FROM SGT_CONEXIONES_SERVICIO WHERE SERVICIO_ID = :P55_SERVICIO )
                 )
                 
                ```
            nullDisplayValue: Seleccione una
        }
        cascadingLov {
            parentItems: [
                P55_SERVICIO
                P55_ENLACE_WAN
            ]
            itemsToSubmit: [
                P55_SERVICIO
                P55_ENLACE_WAN
            ]
        }
        layout {
            sequence: 40
            region: @filtrado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P55_EQUIPO_B (
        type: popupLov
