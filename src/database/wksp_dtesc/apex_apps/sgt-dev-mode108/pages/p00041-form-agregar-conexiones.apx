        column INTERFAZ_A_ID (
            type: popupLov
            heading {
                heading: Interfaz A
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NOMBRE, ID FROM SGT_INTERFACES I
                    WHERE I.EQUIPO_ID =:EQUIPO_A_ID;
                    ```
