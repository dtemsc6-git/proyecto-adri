                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        heading {
            fixedTo: region
            fixedReportHeight: 450
        }
        advanced {
            savedReportMappingIdentifier: 45026336728716169076
        }

        savedReport 450263372 (
