page 41 (
    name: FORM_AGREGAR_CONEXIONES
    alias: FORM-AGREGAR-CONEXIONES
    title: Agregar conexiones
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
