    region tabla-principal (
        name: Tabla principal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT O.ID,
                       O.CODIGO,
                       TT.NOMBRE TIPO_TRABAJO,
                       O.TITULO,
                       ES.NOMBRE ESTADO,
                       PR.NOMBRE PRIORIDAD,
                       PR.COLOR_HEX,
                       O.ASIGNADO_A,
                       O.REPORTADO_POR,
                       O.FECHA_RECEPCION,
                       S.NOMBRE SERVICIO
                  FROM SGT_OT O
                  JOIN SGT_CAT_OT_TIPO_TRABAJO TT ON TT.ID = O.TIPO_TRABAJO_ID
                  JOIN SGT_CAT_OT_ESTADO ES ON ES.ID = O.ESTADO_ID
                  JOIN SGT_CAT_OT_PRIORIDAD PR ON PR.ID = O.PRIORIDAD_ID
                  LEFT JOIN SGT_OT_SERVICIO OS ON OS.OT_ID = O.ID
                  LEFT JOIN SGT_SERVICIOS S ON S.ID = OS.SERVICIO_ID
                WHERE (:P150_TIPO_TRABAJO IS NULL OR O.TIPO_TRABAJO_ID = :P150_TIPO_TRABAJO)
                  AND (:P150_ESTADO IS NULL OR O.ESTADO_ID = :P150_ESTADO)
                 ORDER BY PR.NIVEL_ORDEN ASC, O.FECHA_RECEPCION DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
