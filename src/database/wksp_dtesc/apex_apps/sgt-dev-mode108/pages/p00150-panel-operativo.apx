            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prc-total-ot (
        name: PRC_TOTAL_OT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT COUNT(CASE WHEN ES.CODIGO = 'NUEVO'       THEN 1 END),
                       COUNT(CASE WHEN ES.CODIGO = 'ASIGNADO'     THEN 1 END),
                       COUNT(CASE WHEN ES.CODIGO = 'EN_ATENCION'  THEN 1 END),
                       COUNT(CASE WHEN ES.CODIGO = 'RESUELTO'     THEN 1 END),
                       COUNT(CASE WHEN ES.CODIGO = 'CANCELADO'    THEN 1 END)
                  INTO :P150_CNT_NUEVO,
                       :P150_CNT_ASIGNADO,
                       :P150_CNT_EN_ATENCION,
                       :P150_CNT_RESUELTO,
                       :P150_CNT_CANCELADO
                  FROM SGT_OT O
                  JOIN SGT_CAT_OT_ESTADO ES ON ES.ID = O.ESTADO_ID
                WHERE (:P150_TIPO_TRABAJO IS NULL OR O.TIPO_TRABAJO_ID = :P150_TIPO_TRABAJO)
                  AND (:P150_ESTADO IS NULL OR O.ESTADO_ID = :P150_ESTADO);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22160096417806519
        }
    )

)

