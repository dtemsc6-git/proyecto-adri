page 150 (
    name: PANEL OPERATIVO
    alias: PANEL-OPERATIVO
    title: PANEL OPERATIVO
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asignado (
        name: ASIGNADO
        title: ASIGNADO (&P150_CNT_ASIGNADO.)
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- REGION CARDS: ASIGNADO
                SELECT O.ID                                          AS CARD_ID,
                       O.CODIGO                                      AS CARD_TITLE,
                       O.TITULO                                      AS CARD_SUBTITLE,
                       'Prioridad: ' || PR.NOMBRE                    AS CARD_BODY,
                       PR.NOMBRE                                     AS CARD_BADGE_TEXT,
                       PR.COLOR_HEX                                  AS CARD_BADGE_COLOR,
                       'Asignado a: ' || NVL(O.ASIGNADO_A, 'Sin asignar')
                                                                     AS CARD_FOOTER,
                       ES.CODIGO                                     AS ESTADO_CODIGO,
                       ES.NOMBRE                                     AS ESTADO_NOMBRE
                  FROM SGT_OT O
                  JOIN SGT_CAT_OT_ESTADO ES
                    ON ES.ID = O.ESTADO_ID
                  JOIN SGT_CAT_OT_PRIORIDAD PR
                    ON PR.ID = O.PRIORIDAD_ID
                 WHERE 
                   (:P150_ESTADO IS NULL OR O.ESTADO_ID = :P150_ESTADO ) AND
                   ES.CODIGO = 'ASIGNADO'
                   AND (:P150_TIPO_TRABAJO IS NULL OR O.TIPO_TRABAJO_ID = :P150_TIPO_TRABAJO)
                 ORDER BY PR.NIVEL_ORDEN, O.FECHA_RECEPCION DESC;
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        card {
            primaryKeyColumn1: CARD_ID
        }
        title {
            column: CARD_TITLE
        }
        subtitle {
            column: CARD_SUBTITLE
        }
        body {
            column: CARD_BODY
        }
        secondaryBody {
            column: CARD_FOOTER
        }
    )

