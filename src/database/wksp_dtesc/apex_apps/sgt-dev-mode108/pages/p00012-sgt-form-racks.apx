    region vista-back (
        name: VISTA_BACK
        title: Vista Posterior Rack
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH Pisos(posicion_u) AS (
                  SELECT 1 FROM dual
                  UNION ALL
                  SELECT posicion_u + 1 FROM Pisos
                  WHERE posicion_u + 1 <= (
                    SELECT altura_u FROM sgt_Racks WHERE id=:P12_ID
                  )
                )
                
                SELECT 
                  'U'||p.posicion_u as "U", 
                  CASE 
                    WHEN EXISTS (
                      SELECT 1 FROM sgt_Equipos e
                      WHERE e.rack_id = :P12_ID
                        AND p.posicion_u BETWEEN e.u AND (e.u + e.altura_u - 1)
                        AND e.posicion = 'Back'
                    ) THEN 
                      '<span class="u-ocupada u-clickable">'|| 
                      (SELECT e.nombre FROM sgt_Equipos e
                       WHERE e.rack_id = :P12_ID
                         AND p.posicion_u BETWEEN e.u AND (e.u + e.altura_u - 1)
                         AND e.posicion = 'Back'
                       AND ROWNUM = 1) ||'</span>'
                    ELSE
                      '<span class="u-libre u-clickable" data-ua="'|| p.posicion_u ||'">Seleccionar Aqui</span>'
                  END AS Equipo
                FROM Pisos p
                ORDER BY p.posicion_u DESC;
                ```
        }
        layout {
            sequence: 40
            parentRegion: @equipos
            slot: subRegions
            startNewRow: false
            columnCssClasses: back
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 60
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column EQUIPO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: richText
            heading {
                heading: Equipo
            }
            layout {
                sequence: 20
            }
            settings {
                format: html
            }
            sorting {
                sortable: false
            }
        )

        column U (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: U
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

    )

