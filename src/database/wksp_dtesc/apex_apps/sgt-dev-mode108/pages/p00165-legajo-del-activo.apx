page 165 (
    name: Legajo del activo
    alias: LEGAJO-DEL-ACTIVO
    title: Legajo del activo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region auditoría-de-datos (
        name: Auditoría de Datos
        title: Auditoría de Datos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    am.AUDIT_ID,
                    am.APEX_USER AS USUARIO,
                    am.ACTION_TYPE AS TIPO_OPERACION,
                    am.TIMESTAMP AS FECHA_HORA,
                    ad.TABLE_NAME AS TABLA,
                    LISTAGG(CASE WHEN ad.OLD_VALUE IS NOT NULL OR ad.NEW_VALUE IS NOT NULL
                                 THEN ad.COLUMN_NAME || ': ' || COALESCE(ad.OLD_VALUE, '[NULL]') END, ' | ')
                            WITHIN GROUP (ORDER BY ad.COLUMN_NAME) AS DETALLE_OLD_VALUE,
                    LISTAGG(CASE WHEN ad.OLD_VALUE IS NOT NULL OR ad.NEW_VALUE IS NOT NULL
                                 THEN ad.COLUMN_NAME || ': ' || COALESCE(ad.NEW_VALUE, '[NULL]') END, ' | ')
                            WITHIN GROUP (ORDER BY ad.COLUMN_NAME) AS DETALLE_NEW_VALUE
                  FROM AUDIT_MASTER am
                  JOIN AUDIT_DETAIL ad ON ad.AUDIT_ID = am.AUDIT_ID
                 WHERE ad.TABLE_NAME = (
                           SELECT CASE TA.CODIGO
                                      WHEN 'SERVICIO' THEN 'SGT_SERVICIOS'
                                      WHEN 'EQUIPO'   THEN 'SGT_EQUIPOS'
                                      WHEN 'SITIO'    THEN 'SGT_SITIOS'
                                      WHEN 'SALA'     THEN 'SGT_SALAS'
                                      WHEN 'RACK'     THEN 'SGT_RACKS'
                                  END
                             FROM SGT_CAT_TIPO_ACTIVO_EVENTO TA
                            WHERE TA.ID = :P165_TIPO_ACTIVO_ID
                       )
                   AND ad.PK_VALUE = TO_CHAR(:P165_ACTIVO_ID)
                   AND am.ACTION_TYPE NOT IN ('INSERT', 'Inserción')
                 GROUP BY am.AUDIT_ID, am.APEX_USER, am.ACTION_TYPE, am.TIMESTAMP, ad.TABLE_NAME
                 ORDER BY am.TIMESTAMP DESC
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P165_FILTRO_APLICADO
            value: 'Y'
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column AUDIT_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Audit Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column DETALLE_NEW_VALUE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Detalle New Value
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column DETALLE_OLD_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Detalle Old Value
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column FECHA_HORA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Fecha Hora
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column TABLA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Tabla
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column TIPO_OPERACION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Tipo Operacion
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Usuario
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region historial-operativo (
        name: HISTORIAL OPERATIVO
        title: Historial operativo
        type: themeTemplateComponent/timeline
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT L.TIPO_ACTIVO,
                       L.ACTIVO_ID,
                       L.IDENTIFICADOR_ACTIVO,
                       L.EVENTO_ID,
                       L.EVENTO_CODIGO,
                       L.OT_ID,
                       L.ACTIVIDAD AS ACTIVIDAD,
                       L.RESULTADO,
                       L.DETALLE,
                       L.FECHA_EVENTO,
                       L.USUARIO_EVENTO,
                       CASE L.RESULTADO
                           WHEN 'EXITOSO'   THEN 'success'
                           WHEN 'FALLIDO'   THEN 'danger'
                           WHEN 'PARCIAL'   THEN 'warning'
                           WHEN 'PENDIENTE' THEN 'info'
                           WHEN 'CARGADO'   THEN 'info'
                           ELSE 'default'
                       END AS ESTADO_BADGE
                  FROM V_LEGAJO_ACTIVO L
                 WHERE (:P165_TIPO_ACTIVO_ID IS NULL OR L.TIPO_ACTIVO = (
                           SELECT TA.CODIGO FROM SGT_CAT_TIPO_ACTIVO_EVENTO TA
                            WHERE TA.ID = :P165_TIPO_ACTIVO_ID
                       ))
                   AND (:P165_ACTIVO_ID IS NULL OR L.ACTIVO_ID = :P165_ACTIVO_ID)
                   AND (:P165_FECHA_DESDE IS NULL OR L.FECHA_EVENTO >= CAST(:P165_FECHA_DESDE AS DATE))
                   AND (:P165_FECHA_HASTA IS NULL OR L.FECHA_EVENTO < CAST(:P165_FECHA_HASTA AS DATE) + 1)
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: FECHA_EVENTO DESC
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        advanced {
            htmlDomId: historial_operativo
        }
        serverSideCondition {
            type: item=value
            item: P165_FILTRO_APLICADO
            value: 'Y'
        }
        componentAppearance {
            display: report
        }
        settings {
            userName: USUARIO_EVENTO
            date: FECHA_EVENTO
            title: ACTIVIDAD
            description: DETALLE
            displayAvatar: true
            displayBadge: true
        }
        plugin-badge {
            label: &RESULTADO.
            value: RESULTADO
            state: ESTADO_BADGE
        }

        column ACTIVIDAD (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ACTIVIDAD
                dataType: varchar2
            }
        )

        column ACTIVO_ID (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: ACTIVO_ID
                dataType: number
            }
        )

        column DETALLE (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: DETALLE
                dataType: varchar2
            }
        )

        column ESTADO_BADGE (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: ESTADO_BADGE
                dataType: varchar2
            }
        )

        column EVENTO_CODIGO (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: EVENTO_CODIGO
                dataType: varchar2
            }
        )

        column EVENTO_ID (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: EVENTO_ID
                dataType: number
            }
        )

        column FECHA_EVENTO (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: FECHA_EVENTO
                dataType: timestamp
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI:SS
            }
        )

        column IDENTIFICADOR_ACTIVO (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDENTIFICADOR_ACTIVO
                dataType: varchar2
            }
        )

        column OT_ID (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: OT_ID
                dataType: number
            }
        )

        column RESULTADO (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: RESULTADO
                dataType: varchar2
            }
        )

        column TIPO_ACTIVO (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: TIPO_ACTIVO
                dataType: varchar2
            }
        )

        column USUARIO_EVENTO (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: USUARIO_EVENTO
                dataType: varchar2
            }
        )

    )

    region selector-activos (
        name: Selector_activos
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P165_ACTIVO_ID (
        type: combobox
        label {
            label: Activo
            alignment: left
        }
        settings {
            infiniteScroll: false
            manualEntriesItem: P165_ACTIVO_ID_MANUAL
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT display_value d, id r
                  FROM (
                    SELECT S.NOMBRE AS display_value, S.ID, 'SERVICIO' AS tipo_codigo FROM SGT_SERVICIOS S
                    UNION ALL
                    SELECT E.NOMBRE, E.ID, 'EQUIPO' FROM SGT_EQUIPOS E
                    UNION ALL
                    SELECT SI.NOMBRE, SI.ID, 'SITIO' FROM SGT_SITIOS SI
                    UNION ALL
                    SELECT SA.NOMBRE, SA.ID, 'SALA' FROM SGT_SALAS SA
                    UNION ALL
                    SELECT R.NOMBRE, R.ID, 'RACK' FROM SGT_RACKS R
                    UNION ALL 
                    SELECT EFO.NOMBRE, EFO.ID, 'ENLACE_FO' FROM SGT_ENLACES_FO EFO    
                  ) X
                 WHERE X.tipo_codigo = (
                    SELECT TA.CODIGO FROM SGT_CAT_TIPO_ACTIVO_EVENTO TA
                     WHERE TA.ID = :P165_TIPO_ACTIVO_ID
                 )
                 ORDER BY display_value
                ```
        }
        cascadingLov {
            parentItems: P165_TIPO_ACTIVO_ID
        }
        layout {
            sequence: 10
            region: @selector-activos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P165_ACTIVO_ID_MANUAL (
        type: hidden
        layout {
            sequence: 40
            region: @selector-activos
            slot: regionBody
        }
    )

    pageItem P165_FECHA_DESDE (
        type: datePicker
        label {
            label: Desde
            alignment: left
        }
        layout {
            sequence: 10
            region: @selector-activos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P165_FECHA_HASTA (
        type: datePicker
        label {
            label: Hasta
            alignment: left
        }
        layout {
            sequence: 10
            region: @selector-activos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P165_FILTRO_APLICADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @selector-activos
            slot: regionBody
        }
    )

    pageItem P165_TIPO_ACTIVO_ID (
        type: selectList
        label {
            label: Tipo de activo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT NOMBRE d, ID r FROM SGT_CAT_TIPO_ACTIVO_EVENTO WHERE ACTIVO='Y' ORDER BY NOMBRE
        }
        layout {
            sequence: 10
            region: @selector-activos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button consultar (
        buttonName: CONSULTAR
        label: Consultar
        layout {
            sequence: 20
            region: @selector-activos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button volver (
        buttonName: VOLVER
        label: Volver
        layout {
            sequence: 30
            region: @selector-activos
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 161
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction aplicar-filtro (
        name: APLICAR_FILTRO
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @consultar
        }

        action native-set-value (
            action: setValue
            settings {
                value: 'Y'
            }
            affectedElements {
                selectionType: items
                items: P165_FILTRO_APLICADO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cambia (
        name: CAMBIA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P165_TIPO_ACTIVO_ID
        }

        action refrescar (
            name: REFRESCAR
            action: refresh
            affectedElements {
                selectionType: items
                items: P165_ACTIVO_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

