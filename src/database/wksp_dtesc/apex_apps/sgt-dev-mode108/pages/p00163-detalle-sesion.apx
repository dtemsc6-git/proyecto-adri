    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  SELECT EO.CODIGO, EO.ESTADO, EO.OT_ID, EO.TIPO_CASO, EO.CRITICIDAD,
                         EO.ACTIVO_PRINCIPAL_ID, EO.OBSERVACIONES_CIERRE,
                         CASE CA.CODIGO
                             WHEN 'SERVICIO' THEN (SELECT S.NOMBRE FROM SGT_SERVICIOS S WHERE S.ID = EO.ACTIVO_PRINCIPAL_ID)
                             WHEN 'EQUIPO'   THEN (SELECT E.NOMBRE FROM SGT_EQUIPOS E WHERE E.ID = EO.ACTIVO_PRINCIPAL_ID)
                             WHEN 'SITIO'    THEN (SELECT SI.NOMBRE FROM SGT_SITIOS SI WHERE SI.ID = EO.ACTIVO_PRINCIPAL_ID)
                             WHEN 'SALA'     THEN (SELECT SA.NOMBRE FROM SGT_SALAS SA WHERE SA.ID = EO.ACTIVO_PRINCIPAL_ID)
                             WHEN 'RACK'      THEN (SELECT R.NOMBRE FROM SGT_RACKS R WHERE R.ID = EO.ACTIVO_PRINCIPAL_ID)
                             WHEN 'ENLACE_FO' THEN (SELECT EFO.NOMBRE FROM SGT_ENLACES_FO EFO WHERE EFO.ID = EO.ACTIVO_PRINCIPAL_ID)
                             ELSE TO_CHAR(EO.ACTIVO_PRINCIPAL_ID)
                         END
                    INTO :P163_CODIGO, :P163_ESTADO, :P163_OT_ID, :P163_TIPO_CASO, :P163_CRITICIDAD,
                         :P163_ACTIVO_PRINCIPAL_ID, :P163_OBSERVACIONES_CIERRE,
                         :P163_ACTIVO_PRINCIPAL_DESC
                    FROM SGT_EVENTO_OPERATIVO EO
                    LEFT JOIN SGT_CAT_TIPO_ACTIVO_EVENTO CA ON CA.ID = EO.TIPO_ACTIVO_PRINCIPAL_ID
                   WHERE EO.ID = :P163_EVENTO_ID;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26928656635480605
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P163_EVENTO_ID
        }
    )

    process pcr-guardar-cabecera (
        name: PCR_GUARDAR_CABECERA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    UPDATE SGT_EVENTO_OPERATIVO
                       SET OT_ID                    = :P163_OT_ID,
                           TIPO_CASO                = :P163_TIPO_CASO,
                           CRITICIDAD               = NVL(:P163_CRITICIDAD, CRITICIDAD),
                           OBSERVACIONES_CIERRE     = :P163_OBSERVACIONES_CIERRE,
                           ACTUALIZADO_POR          = :APP_USER,
                           ACTUALIZADO_EL           = SYSTIMESTAMP
                     WHERE ID = :P163_EVENTO_ID;
                
                    IF SQL%ROWCOUNT = 0 THEN
                        RAISE_APPLICATION_ERROR(-20011, 'No se encontró la sesión.');
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23616503737716946
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
    )

    process pcr-guardar-comentario (
        name: PCR_GUARDAR_COMENTARIO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_EXISTE NUMBER;
                BEGIN
                    SELECT COUNT(1) INTO V_EXISTE
                      FROM SGT_EVENTO_COMENTARIO C
                     WHERE C.EVENTO_ID = :P163_EVENTO_ID
                       AND C.AUTOR = :APP_USER
                       AND UPPER(TRIM(C.TEXTO)) = UPPER(TRIM(:P163_COMENTARIO))
                       AND C.FECHA_CREACION >= (SYSTIMESTAMP - INTERVAL '5' MINUTE);
                
                    IF V_EXISTE = 0 THEN
                        INSERT INTO SGT_EVENTO_COMENTARIO (
                            EVENTO_ID, TIPO_COMENTARIO, TEXTO, AUTOR,
                            FECHA_CREACION, CREADO_POR, CREADO_EL
                        ) VALUES (
                            :P163_EVENTO_ID, NVL(:P163_TIPO_COMENTARIO, 'TECNICO'),
                            :P163_COMENTARIO, :APP_USER,
                            SYSTIMESTAMP, :APP_USER, SYSTIMESTAMP
                        );
                    END IF;
                    :P163_COMENTARIO := NULL;
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 26866609270123322
        }
        serverSideCondition {
            whenButtonPressed: @guardar-comentario
            type: expression
            plsqlExpression: TRIM(:P163_COMENTARIO) IS NOT NULL
        }
    )

    process prc-agregar-activo (
        name: PRC_AGREGAR_ACTIVO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  V_ES_PRINCIPAL NUMBER(1) := CASE WHEN :P163_NUEVO_ES_PRINCIPAL = 'Y' THEN 1 ELSE 0 END;
                BEGIN
                  IF :P163_NUEVO_TIPO_ACTIVO_ID IS NULL OR :P163_NUEVO_ACTIVO_ID IS NULL THEN
                    RAISE_APPLICATION_ERROR(-20012, 'Debe informar tipo de activo y activo para vincular.');
                  END IF;
                
                  IF V_ES_PRINCIPAL = 1 THEN
                    UPDATE SGT_EVENTO_ACTIVO
                       SET ES_PRINCIPAL = 0
                     WHERE EVENTO_ID = :P163_EVENTO_ID
                       AND ES_PRINCIPAL = 1;
                  END IF;
                
                  INSERT INTO SGT_EVENTO_ACTIVO (
                    EVENTO_ID, TIPO_ACTIVO_ID, ACTIVO_ID, IDENTIFICADOR_ACTIVO,
                    ES_PRINCIPAL, CREADO_POR, CREADO_EL
                  ) VALUES (
                    :P163_EVENTO_ID, :P163_NUEVO_TIPO_ACTIVO_ID, :P163_NUEVO_ACTIVO_ID,
                    TO_CHAR(:P163_NUEVO_ACTIVO_ID), V_ES_PRINCIPAL, :APP_USER, SYSTIMESTAMP
                  );
                
                  :P163_NUEVO_TIPO_ACTIVO_ID := NULL;
                  :P163_NUEVO_ACTIVO_ID := NULL;
                END;
                ```
        }
        execution {
            sequence: 70
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 26930903728480628
        }
        serverSideCondition {
            whenButtonPressed: @agregar-activo
        }
    )

    process prc-cerrar-sesion (
        name: PRC_CERRAR_SESION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SGT_EVENTO_PKG.CERRAR_SESION(
                        P_EVENTO_ID     => :P163_EVENTO_ID,
                        P_OBSERVACIONES => :P163_OBSERVACIONES_CIERRE,
                        P_USUARIO       => :APP_USER
                    );
