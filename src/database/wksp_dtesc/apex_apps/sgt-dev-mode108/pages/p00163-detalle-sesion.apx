    region subtareas (
        name: Subtareas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT S.ID,
                       A.ACCION AS ACCION_PADRE,
                       S.SUBTAREA,
                       CASE S.RESULTADO
                           WHEN 'PENDIENTE' THEN 'PENDIENTE'
                           WHEN 'EXITOSO'   THEN 'FUNCIONAMIENTO OK'
                           WHEN 'FALLIDO'   THEN 'FALLA DETECTADA'
                           ELSE S.RESULTADO
                       END AS RESULTADO,       
                       S.DETALLE,
                       S.TIEMPO_EMPLEADO_MIN,
                       S.EJECUTADO_POR,
                       TO_CHAR(S.CREADO_EL, 'DD/MM/YYYY HH24:MI') AS FECHA,
                       'Editar' AS EDITAR
                  FROM SGT_EVENTO_SUBTAREA S
                  JOIN SGT_EVENTO_ACCION A ON A.ID = S.EVENTO_ACCION_ID
                  JOIN SGT_EVENTO_ACTIVO EA ON EA.ID = A.EVENTO_ACTIVO_ID
                 WHERE EA.EVENTO_ID = :P163_EVENTO_ID
                 ORDER BY S.ID
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
