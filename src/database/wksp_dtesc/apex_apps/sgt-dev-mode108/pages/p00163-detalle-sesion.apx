    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region acciones-tecnicas-tareas (
        name: acciones_tecnicas_tareas
        title: Acciones técnicas / tareas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT A.ID,
                       TA.NOMBRE AS TIPO_ACCION,
                       A.ACCION,
                       CASE A.RESULTADO
                           WHEN 'PENDIENTE' THEN 'PENDIENTE'
                           WHEN 'EXITOSO'   THEN 'FUNCIONAMIENTO OK'
                           WHEN 'FALLIDO'   THEN 'FALLA DETECTADA'
                           ELSE A.RESULTADO
                       END AS RESULTADO,   
                       A.DETALLE,
                       A.TIEMPO_EMPLEADO_MIN,
                       A.EJECUTADO_POR,
                       A.SECUENCIA,
                       TO_CHAR(A.CREADO_EL, 'DD/MM/YYYY HH24:MI') AS FECHA,
                       CASE TA2.CODIGO
                           WHEN 'SERVICIO' THEN (SELECT S.NOMBRE FROM SGT_SERVICIOS S WHERE S.ID = EA.ACTIVO_ID)
                           WHEN 'EQUIPO'   THEN (SELECT E.NOMBRE FROM SGT_EQUIPOS E WHERE E.ID = EA.ACTIVO_ID)
                           WHEN 'SITIO'    THEN (SELECT SI.NOMBRE FROM SGT_SITIOS SI WHERE SI.ID = EA.ACTIVO_ID)
                           WHEN 'SALA'     THEN (SELECT SA.NOMBRE FROM SGT_SALAS SA WHERE SA.ID = EA.ACTIVO_ID)
                           WHEN 'RACK'     THEN (SELECT R.NOMBRE FROM SGT_RACKS R WHERE R.ID = EA.ACTIVO_ID)
                           WHEN 'ENLACE_FO' THEN (SELECT EFO.NOMBRE FROM SGT_ENLACES_FO EFO WHERE EFO.ID = EA.ACTIVO_ID)
                           ELSE TO_CHAR(EA.ACTIVO_ID)
                       END AS ACTIVO_VINCULADO,
                       'Editar' AS EDITAR,
                       'Seleccionar' AS SELECCIONAR
                  FROM SGT_EVENTO_ACCION A
                  JOIN SGT_EVENTO_ACTIVO EA ON EA.ID = A.EVENTO_ACTIVO_ID
                  LEFT JOIN SGT_CAT_TIPO_ACTIVO_EVENTO TA2 ON TA2.ID = EA.TIPO_ACTIVO_ID
                  LEFT JOIN SGT_CAT_TIPO_ACCION_EVENTO TA ON TA.ID = A.TIPO_ACCION_ID
                 WHERE EA.EVENTO_ID = :P163_EVENTO_ID
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: SECUENCIA,ID
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ACCION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Tarea
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column ACTIVO_VINCULADO (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Activo Vinculado
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column DETALLE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Detalle
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column EDITAR (
            reportColumnQueryId: 11
            derivedColumn: N
            type: link
            heading {
                heading: Acción
            }
            layout {
                sequence: 110
            }
            link {
                target: {
                    page: 166
                    items: {
                        P166_ACCION_ID: #ID#
                        P166_EVENTO_ID: &P163_EVENTO_ID.
                    }
                }
                linkText: #EDITAR#
            }
            sorting {
                sortable: false
            }
        )

        column EJECUTADO_POR (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Ejecutado Por
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column FECHA (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Fecha
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column RESULTADO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Resultado
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column SECUENCIA (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column SELECCIONAR (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

