    region activos-vinculados (
        name: ACTIVOS VINCULADOS
        title: Activos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EA.ID, EA.EVENTO_ID, EA.TIPO_ACTIVO_ID,
                       TA.NOMBRE AS TIPO_ACTIVO_NOMBRE, EA.ACTIVO_ID,
                       CASE TA.CODIGO
                           WHEN 'SERVICIO' THEN (SELECT S.NOMBRE FROM SGT_SERVICIOS S WHERE S.ID = EA.ACTIVO_ID)
                           WHEN 'EQUIPO'   THEN (SELECT E.NOMBRE FROM SGT_EQUIPOS E WHERE E.ID = EA.ACTIVO_ID)
                           WHEN 'SITIO'    THEN (SELECT SI.NOMBRE FROM SGT_SITIOS SI WHERE SI.ID = EA.ACTIVO_ID)
                           WHEN 'SALA'     THEN (SELECT SA.NOMBRE FROM SGT_SALAS SA WHERE SA.ID = EA.ACTIVO_ID)
                           WHEN 'RACK'     THEN (SELECT R.NOMBRE FROM SGT_RACKS R WHERE R.ID = EA.ACTIVO_ID)
                           WHEN 'ENLACE_FO' THEN (SELECT EFO.NOMBRE FROM SGT_ENLACES_FO EFO WHERE EFO.ID = EA.ACTIVO_ID)
                           ELSE TO_CHAR(EA.ACTIVO_ID)
                       END AS ACTIVO_NOMBRE, EA.ES_PRINCIPAL
                  FROM SGT_EVENTO_ACTIVO EA
                  LEFT JOIN SGT_CAT_TIPO_ACTIVO_EVENTO TA ON TA.ID = EA.TIPO_ACTIVO_ID
                 WHERE EA.EVENTO_ID = :P163_EVENTO_ID
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ACTIVO_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column ACTIVO_NOMBRE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Activo
            }
            layout {
                sequence: 60
            }
        )

        column ES_PRINCIPAL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column EVENTO_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TIPO_ACTIVO_ID (
            reportColumnQueryId: 3
            derivedColumn: N
