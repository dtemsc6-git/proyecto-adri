        }
    )

    process prc-guardar-o-insertar-activo-vinculado (
        name: PRC_GUARDAR_O_INSERTAR_ACTIVO_VINCULADO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  V_TIPO_ACTIVO_ID NUMBER;
                  V_ACTIVO_ID NUMBER;
                  V_ES_PRINCIPAL NUMBER(1);
                BEGIN
                  V_TIPO_ACTIVO_ID := NVL(:P163_ACTIVO_TIPO_ID, :P163_TIPO_ACTIVO_PRINCIPAL_ID);
                  V_ACTIVO_ID := NVL(:P163_ACTIVO_ID, :P163_ACTIVO_PRINCIPAL_ID);
                  V_ES_PRINCIPAL := CASE
                              WHEN NVL(:P163_ES_PRINCIPAL, 0) = 1 THEN 1
                              WHEN :REQUEST = 'GUARDAR' THEN 1
                              ELSE 0
                            END;
                
                  IF V_TIPO_ACTIVO_ID IS NULL OR V_ACTIVO_ID IS NULL THEN
                    RAISE_APPLICATION_ERROR(-20012, 'Debe informar tipo de activo y activo para vincular.');
                  END IF;
                
                  IF V_ES_PRINCIPAL = 1 THEN
                    UPDATE SGT_EVENTO_ACTIVO
                       SET ES_PRINCIPAL = 0,
                         ACTUALIZADO_POR = :APP_USER,
                         ACTUALIZADO_EL = SYSTIMESTAMP
                     WHERE EVENTO_ID = :P163_ID
                       AND ES_PRINCIPAL = 1;
                  END IF;
                
                  MERGE INTO SGT_EVENTO_ACTIVO EA
                  USING (
                    SELECT :P163_ID AS EVENTO_ID,
                         V_TIPO_ACTIVO_ID AS TIPO_ACTIVO_ID,
                         V_ACTIVO_ID AS ACTIVO_ID,
                         TO_CHAR(V_ACTIVO_ID) AS IDENTIFICADOR_ACTIVO,
                         NULL AS DESCRIPCION_ACTIVO,
                         V_ES_PRINCIPAL AS ES_PRINCIPAL
                      FROM DUAL
                  ) SRC
                     ON (EA.EVENTO_ID = SRC.EVENTO_ID
                     AND EA.TIPO_ACTIVO_ID = SRC.TIPO_ACTIVO_ID
                     AND EA.ACTIVO_ID = SRC.ACTIVO_ID)
                  WHEN MATCHED THEN
                    UPDATE SET EA.IDENTIFICADOR_ACTIVO = SRC.IDENTIFICADOR_ACTIVO,
                           EA.DESCRIPCION_ACTIVO = SRC.DESCRIPCION_ACTIVO,
                           EA.ES_PRINCIPAL = SRC.ES_PRINCIPAL,
                           EA.ESTADO_VINCULO = 'ACTIVO',
                           EA.ACTUALIZADO_POR = :APP_USER,
                           EA.ACTUALIZADO_EL = SYSTIMESTAMP
                  WHEN NOT MATCHED THEN
                    INSERT (
                      EVENTO_ID,
                      TIPO_ACTIVO_ID,
                      ACTIVO_ID,
                      IDENTIFICADOR_ACTIVO,
                      DESCRIPCION_ACTIVO,
                      ES_PRINCIPAL,
                      CREADO_POR,
                      CREADO_EL
                    )
                    VALUES (
                      SRC.EVENTO_ID,
                      SRC.TIPO_ACTIVO_ID,
                      SRC.ACTIVO_ID,
                      SRC.IDENTIFICADOR_ACTIVO,
                      SRC.DESCRIPCION_ACTIVO,
                      SRC.ES_PRINCIPAL,
                      :APP_USER,
                      SYSTIMESTAMP
                    );
                END;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23616634505716947
        }
        config {
            buildOption: @commented-out
        }
    )

    process prc-guardar-o-insertar-activo-vinculado-2 (
        name: PRC_GUARDAR_O_INSERTAR_ACTIVO_VINCULADO_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  V_TIPO_ACTIVO_ID NUMBER;
                  V_ACTIVO_ID NUMBER;
                  V_ES_PRINCIPAL NUMBER(1);
                BEGIN
                  V_TIPO_ACTIVO_ID := NVL(:P163_ACTIVO_TIPO_ID, :P163_TIPO_ACTIVO_PRINCIPAL_ID);
                  V_ACTIVO_ID := NVL(:P163_ACTIVO_ID, :P163_ACTIVO_PRINCIPAL_ID);
                  V_ES_PRINCIPAL := CASE
                              WHEN NVL(:P163_ES_PRINCIPAL, 0) = 1 THEN 1
                              WHEN :REQUEST = 'GUARDAR' THEN 1
                              ELSE 0
                            END;
                
                  IF V_TIPO_ACTIVO_ID IS NULL OR V_ACTIVO_ID IS NULL THEN
                    RAISE_APPLICATION_ERROR(-20012, 'Debe informar tipo de activo y activo para vincular.');
                  END IF;
                
                  IF V_ES_PRINCIPAL = 1 THEN
                    UPDATE SGT_EVENTO_ACTIVO
                       SET ES_PRINCIPAL = 0,
                         ACTUALIZADO_POR = :APP_USER,
                         ACTUALIZADO_EL = SYSTIMESTAMP
                     WHERE EVENTO_ID = :P163_ID
                       AND ES_PRINCIPAL = 1;
                  END IF;
                
                  MERGE INTO SGT_EVENTO_ACTIVO EA
                  USING (
                    SELECT :P163_ID AS EVENTO_ID,
                         V_TIPO_ACTIVO_ID AS TIPO_ACTIVO_ID,
                         V_ACTIVO_ID AS ACTIVO_ID,
                         TO_CHAR(V_ACTIVO_ID) AS IDENTIFICADOR_ACTIVO,
                         NULL AS DESCRIPCION_ACTIVO,
                         V_ES_PRINCIPAL AS ES_PRINCIPAL
                      FROM DUAL
                  ) SRC
                     ON (EA.EVENTO_ID = SRC.EVENTO_ID
                     AND EA.TIPO_ACTIVO_ID = SRC.TIPO_ACTIVO_ID
                     AND EA.ACTIVO_ID = SRC.ACTIVO_ID)
                  WHEN MATCHED THEN
                    UPDATE SET EA.IDENTIFICADOR_ACTIVO = SRC.IDENTIFICADOR_ACTIVO,
                           EA.DESCRIPCION_ACTIVO = SRC.DESCRIPCION_ACTIVO,
                           EA.ES_PRINCIPAL = SRC.ES_PRINCIPAL,
                           EA.ESTADO_VINCULO = 'ACTIVO',
                           EA.ACTUALIZADO_POR = :APP_USER,
                           EA.ACTUALIZADO_EL = SYSTIMESTAMP
                  WHEN NOT MATCHED THEN
                    INSERT (
                      EVENTO_ID,
                      TIPO_ACTIVO_ID,
                      ACTIVO_ID,
                      IDENTIFICADOR_ACTIVO,
                      DESCRIPCION_ACTIVO,
                      ES_PRINCIPAL,
                      CREADO_POR,
                      CREADO_EL
                    )
                    VALUES (
                      SRC.EVENTO_ID,
                      SRC.TIPO_ACTIVO_ID,
                      SRC.ACTIVO_ID,
                      SRC.IDENTIFICADOR_ACTIVO,
                      SRC.DESCRIPCION_ACTIVO,
                      SRC.ES_PRINCIPAL,
                      :APP_USER,
                      SYSTIMESTAMP
                    );
                END;
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23702524590461504
        }
        config {
            buildOption: @commented-out
        }
        comments {
            comments: clone el proceso ya que no se como identificar ambos request guardar y añadir
        }
    )

    process prc-registrar-accion (
        name: PRC_REGISTRAR_ACCION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  V_EVENTO_ACTIVO_ID NUMBER;
                BEGIN
                  IF TRIM(:P163_ACCION) IS NULL OR :P163_ACCION_TIPO_ID IS NULL THEN
                    RAISE_APPLICATION_ERROR(-20013, 'Debe informar tipo de accion y descripcion de la accion.');
                  END IF;
                
                  IF :P163_ACTIVO_TIPO_ID IS NOT NULL AND :P163_ACTIVO_ID IS NOT NULL THEN
                    SELECT EA.ID
                      INTO V_EVENTO_ACTIVO_ID
                      FROM SGT_EVENTO_ACTIVO EA
                     WHERE EA.EVENTO_ID = :P163_ID
                       AND EA.TIPO_ACTIVO_ID = :P163_ACTIVO_TIPO_ID
                       AND EA.ACTIVO_ID = :P163_ACTIVO_ID
                       AND ROWNUM = 1;
                  ELSE
                    SELECT EA.ID
                      INTO V_EVENTO_ACTIVO_ID
                      FROM SGT_EVENTO_ACTIVO EA
                     WHERE EA.EVENTO_ID = :P163_ID
                       AND EA.ES_PRINCIPAL = 1
                       AND ROWNUM = 1;
                  END IF;
                
                  SGT_EVENTO_PKG.REGISTRAR_ACCION(
                    P_EVENTO_ACTIVO_ID    => V_EVENTO_ACTIVO_ID,
                    P_TIPO_ACCION_ID      => :P163_ACCION_TIPO_ID,
                    P_ACCION              => :P163_ACCION,
                    P_RESULTADO           => NVL(:P163_ACCION_RESULTADO, 'PENDIENTE'),
                    P_DETALLE             => :P163_ACCION_DETALLE,
                    P_TIEMPO_EMPLEADO_MIN => :P163_ACCION_TIEMPO_MIN,
                    P_EJECUTADO_POR       => :APP_USER,
                    P_EVENTO_ACCION_ID    => :P163_ACCION_ID
                  );
                END;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23702677087461505
        }
        config {
            buildOption: @commented-out
        }
    )

