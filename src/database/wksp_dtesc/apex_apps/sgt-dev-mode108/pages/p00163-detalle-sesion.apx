    region legajo-por-activo (
        name: Legajo por activo
        title: Legajo por activo
        type: themeTemplateComponent/timeline
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT L.*,
                       CASE L.RESULTADO
                           WHEN 'EXITOSO'   THEN 'success'
                           WHEN 'FALLIDO'   THEN 'danger'
                           WHEN 'PARCIAL'   THEN 'warning'
                           WHEN 'PENDIENTE' THEN 'info'
                           WHEN 'CARGADO'   THEN 'info'
                           ELSE 'default'
                       END AS ESTADO_BADGE
                  FROM V_LEGAJO_ACTIVO L
                 WHERE L.ACTIVO_ID = :P163_ACTIVO_PRINCIPAL_ID
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: FECHA_EVENTO DESC
        }
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            display: report
        }
        settings {
            userName: USUARIO_EVENTO
            date: FECHA_EVENTO
            title: ACTIVIDAD
            description: DETALLE
            displayAvatar: true
            displayBadge: true
        }
        plugin-badge {
            label: &RESULTADO.
            value: RESULTADO
            state: ESTADO_BADGE
        }
        rowSelection {
            type: focusOnly
        }

        column ACTIVIDAD (
            layout {
