page 49 (
    name: Grilla Interfaces
    alias: GRILLA-INTERFACES
    title: Grilla Interfaces
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region grilla-interfaces (
        name: Grilla Interfaces
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_INTERFACES
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @implementador-rights
            update: @implementador-rights
            delete: @implementador-rights
        }
        componentAppearance {
            selectFirstRow: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11713223564718422
        }

        savedReport 117137 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @VELOCIDAD_MBPS
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @EQUIPO_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @NOMBRE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ETIQUETA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ESTADO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TIPO_INTERFACE_ID
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @TX_EN_DBM
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @RX_EN_DBM
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @MAC_ADDRESS
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @CREADO_EL
                layout {
                    show: false
                    sequence: 12
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    show: false
                    sequence: 13
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    show: false
                    sequence: 14
                }
            )

            displayColumn (
                column: @CREADO_POR
                layout {
                    show: false
                    sequence: 15
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

        )

        column ACTUALIZADO_EL (
            type: datePicker
            heading {
                heading: Actualizado El
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: timestamp
            }
        )

        column ACTUALIZADO_POR (
            type: textField
            heading {
                heading: Actualizado Por
                alignment: center
            }
            layout {
                sequence: 170
                columnAlignment: center
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CREADO_EL (
            type: datePicker
            heading {
                heading: Creado El
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            source {
                databaseColumn: CREADO_EL
                dataType: timestamp
            }
            config {
                buildOption: @commented-out
            }
        )

        column CREADO_POR (
            type: textField
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 180
                columnAlignment: center
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: CREADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            config {
                buildOption: @commented-out
            }
        )

        column EQUIPO_ID (
            type: popupLov
            heading {
                heading: Equipo
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @equipos-nombre-compuesto
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: EQUIPO_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ESTADO (
            type: selectList
            heading {
                heading: Estado
            }
            lov {
                type: sharedComponent
                lov: @interfaces-estado
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ETIQUETA (
            type: textField
            heading {
                heading: Etiqueta/Descripción
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: ETIQUETA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column MAC_ADDRESS (
            type: textField
            heading {
                heading: MAC Address
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            validation {
                maxLength: 25
            }
            source {
                databaseColumn: MAC_ADDRESS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column NOMBRE (
            type: textField
            heading {
                heading: Nombre
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: NOMBRE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column RX_EN_DBM (
            type: textField
            heading {
                heading: Rx en dBm
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: RX_EN_DBM
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPO_INTERFACE_ID (
            type: selectList
            heading {
                heading: Tipo de Interfaz
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @tipo-interfaz-nombre
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                databaseColumn: TIPO_INTERFACE_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column TX_EN_DBM (
            type: textField
            heading {
                heading: Tx en dBm
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: TX_EN_DBM
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column VELOCIDAD_MBPS (
            type: numberField
            heading {
                heading: Velocidad (Mbps)
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                databaseColumn: VELOCIDAD_MBPS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Grilla Interfaces
        }
    )

    process grilla-interfaces-save-interactive-grid-data (
        name: Grilla Interfaces - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @grilla-interfaces
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11733720935772603
        }
    )

)

