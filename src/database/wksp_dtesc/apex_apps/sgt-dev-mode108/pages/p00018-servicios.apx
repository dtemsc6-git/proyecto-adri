page 18 (
    name: Servicios
    alias: SERVICIOS
    title: Servicios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region servicios (
        name: Servicios
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select es.ID,
                       SERVICIO_ID,
                       CASE 
                WHEN WAN_ID IS NULL THEN
                (
                    SELECT vse.SITIO_ID FROM v_sitios_equipos vse WHERE vse.equipo_id = es.EQUIPO_A_ID
                    fetch first 1 row only
                )
                ELSE 
                (
                    select vse.sitio_id from v_sitios_equipos vse
                    inner join sgt_equipos_wan ew on ew.equipo_a_id = vse.equipo_id
                    where ew.wan_id = es.wan_id 
                    fetch first 1 row only
                )
                
                END
                       
                       SITIO_ID,
                       WAN_ID,
                       EQUIPO_A_ID,
                       INTERFAZ_A_ID,
                       FO_ID,
                       SEQ
                
                  from SGT_EQUIPOS_SERVICIO es
                
                  
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 20455406772758815
        }

        savedReport 204559 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SITIO_ID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @WAN_ID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @FO_ID
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @SEQ
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @SERVICIO_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @EQUIPO_A_ID
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @INTERFAZ_A_ID
                layout {
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column EQUIPO_A_ID (
            type: popupLov
            heading {
                heading: Equipo
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @equipos-nombre-filtrado
                nullDisplayValue: Seleccione Una
            }
            cascadingLov {
                parentColumns: SITIO_ID
                itemsToSubmit: SITIO_ID
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: EQUIPO_A_ID
                dataType: number
            }
        )

        column FO_ID (
            type: popupLov
            heading {
                heading: FO
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NOMBRE, ID
                    FROM SGT_ENLACES_FO
                    WHERE
                    SGT_ENLACES_FO.EQUIPO_ID_A = :EQUIPO_A_ID
                    OR
                    SGT_ENLACES_FO.EQUIPO_ID_b = :EQUIPO_A_ID
                    
                    and
                    lower(estado) = 'activo'
                    ```
                nullDisplayValue: Seleccione Una
            }
            cascadingLov {
                parentColumns: EQUIPO_A_ID
                itemsToSubmit: EQUIPO_A_ID
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: FO_ID
                dataType: number
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column INTERFAZ_A_ID (
            type: popupLov
            heading {
                heading: Interfaz
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select i.nombre || ' : '|| nvl(i.etiqueta, 'Sin etiqueta') , i.id
                    from
                    sgt_interfaces i
                    where i.equipo_id = :EQUIPO_A_ID
                    order by i.nombre
                    ```
                nullDisplayValue: Seleccione una
            }
            cascadingLov {
                parentColumns: EQUIPO_A_ID
                itemsToSubmit: EQUIPO_A_ID
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: INTERFAZ_A_ID
                dataType: number
            }
        )

        column SEQ (
            type: numberField
            heading {
                heading: Seq
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                databaseColumn: SEQ
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SERVICIO_ID (
            type: popupLov
            heading {
                heading: Servicio
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @servicios-nombre
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SERVICIO_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column SITIO_ID (
            type: popupLov
            heading {
                heading: Sitio
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @sgt-sitios-siglas
                nullDisplayValue: Seleccione Una
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SITIO_ID
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column WAN_ID (
            type: popupLov
            heading {
                heading: Wan
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select distinct w.nombre, W.id
                    
                    from sgt_enlaces_wan w
                    
                    inner join sgt_equipos_wan ew on w.id = ew.wan_id
                    
                    join v_sitios_equipos vse on vse.equipo_id = ew.equipo_a_id
                    
                    
                    where vse.sitio_id = :SITIO_ID
                    
                    ```
                nullDisplayValue: Seleccione Una
            }
            cascadingLov {
                parentColumns: SITIO_ID
                itemsToSubmit: SITIO_ID
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: WAN_ID
                dataType: number
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Servicios
        }
    )

    button btn-servicios (
        buttonName: BTN_SERVICIOS
        label: Ir a Lista de Servicios
        layout {
            sequence: 10
            region: @servicios
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 16
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction clear-equipo (
        name: CLEAR_EQUIPO
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @servicios
            columns: WAN_ID
        }

        action clear-equipo (
            name: CLEAR_EQUIPO
            action: clear
            affectedElements {
                selectionType: columns
                columns: EQUIPO_A_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process servicios-save-interactive-grid-data (
        name: Servicios - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @servicios
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20472171518758802
        }
    )

)

