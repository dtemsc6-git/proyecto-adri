page 40 (
    name: SGT_FORM_ENLACE_TRAMOS_FO
    alias: SGT-FORM-ENLACE-TRAMOS-FO
    title: Agregar / Editar
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sgt-form-enlace-tramos-fo (
        name: SGT_FORM_ENLACE_TRAMOS_FO
        type: form
        source {
            location: localDatabase
            tableName: SGT_ENLACES_TRAMOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P40_ACTUALIZADO_EL (
        type: datePicker
        label {
            label: Actualizado El
            alignment: left
        }
        layout {
            sequence: 140
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: ACTUALIZADO_EL
            dataType: date
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P40_ACTUALIZADO_POR (
        type: textField
        label {
            label: Actualizado Por
            alignment: left
        }
        layout {
            sequence: 130
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: ACTUALIZADO_POR
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P40_CREADO_EL (
        type: datePicker
        label {
            label: Creado El
            alignment: left
        }
        layout {
            sequence: 120
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: CREADO_EL
            dataType: date
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P40_CREADO_POR (
        type: textField
        label {
            label: Creado Por
            alignment: left
        }
        layout {
            sequence: 110
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: CREADO_POR
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P40_ENLACE_ID (
        type: selectMany
        label {
            label: Enlace
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @enlaces-fo-nombre
        }
        layout {
            sequence: 50
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: ENLACE_ID
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P40_EQUIPO_A_ID (
        type: popupLov
        label {
            label: Equipo A
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nombre Mostrar, e.id Valor from SGT_EQUIPOS e
                left join sgt_racks r on e.rack_id = r.id
                left join sgt_salas s on r.sala_id = s.id
                left join sgt_sitios ss on s.sitio_id = ss.id
                WHERE :P40_LADO_ID IS NULL OR ss.id = :P40_LADO_ID;
                
                ```
        }
        cascadingLov {
            parentItems: P40_LADO_ID
            itemsToSubmit: P40_LADO_ID
        }
        layout {
            sequence: 70
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: EQUIPO_A_ID
            dataType: number
        }
    )

    pageItem P40_EQUIPO_B_ID (
        type: popupLov
        label {
            label: Equipo B
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nombre Mostrar, e.id Valor from SGT_EQUIPOS e
                left join sgt_racks r on e.rack_id = r.id
                left join sgt_salas s on r.sala_id = s.id
                left join sgt_sitios ss on s.sitio_id = ss.id
                WHERE :P40_LADO_ID IS NULL OR ss.id = :P40_LADO_ID;
                ```
        }
        cascadingLov {
            parentItems: P40_LADO_ID
            itemsToSubmit: P40_LADO_ID
        }
        layout {
            sequence: 90
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: EQUIPO_B_ID
            dataType: number
        }
    )

    pageItem P40_ID (
        type: hidden
        layout {
            sequence: 10
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P40_INTERFAZ_A_ID (
        type: popupLov
        label {
            label: Interfaz A
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @interfaces-nombre-equiqueta
        }
        cascadingLov {
            parentItems: P40_EQUIPO_A_ID
            itemsToSubmit: P40_EQUIPO_A_ID
        }
        layout {
            sequence: 80
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: INTERFAZ_A_ID
            dataType: number
        }
    )

    pageItem P40_INTERFAZ_B_ID (
        type: popupLov
        label {
            label: Interfaz B
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @interfaces-nombre-equiqueta
        }
        cascadingLov {
            parentItems: P40_EQUIPO_B_ID
            itemsToSubmit: P40_EQUIPO_B_ID
        }
        layout {
            sequence: 100
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: INTERFAZ_B_ID
            dataType: number
        }
    )

    pageItem P40_LADO_ID (
        type: popupLov
        label {
            label: Sitio
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @sgt-sitios-siglas
        }
        cascadingLov {
            parentItems: P40_ENLACE_ID
            itemsToSubmit: P40_ENLACE_ID
        }
        layout {
            sequence: 60
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: LADO_ID
            dataType: number
        }
    )

    pageItem P40_NOMBRE (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 20
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
            valuePlaceholder: "Ingrese un nombre "
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: NOMBRE
            dataType: varchar2
        }
        help {
            inlineHelpText: "Nombre del cable de interconexión, o etiqueta, ej: patchcord 01 "
            helpText: Puede ser la etiqueta del cable de interconexión (Patchcord)
        }
    )

    pageItem P40_TIPO_CONEXION (
        type: selectList
        label {
            label: Tipo Conexion
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Física;Física,Lógica;Lógica
        }
        layout {
            sequence: 30
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: TIPO_CONEXION
            dataType: varchar2
        }
    )

    button add-more (
        buttonName: ADD_MORE
        label: &APP_TEXT$BTN_CREAR_VARIOS!RAW.
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P40_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P40_ID
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$BTN_APLICAR_CAMBIOS!RAW.
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P40_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P40_TIPO_CONEXION
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P40_ENLACE_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 44132895177657381952
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sgt-form-enlace-tramos-fo (
        name: Initialize form SGT_FORM_ENLACE_TRAMOS_FO
        type: formInitialization
        formRegion: @sgt-form-enlace-tramos-fo
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44132894381459381951
        }
    )

    process process-form-sgt-form-enlace-tramos-fo (
        name: Process form SGT_FORM_ENLACE_TRAMOS_FO
        type: formAutoRowProcessing
        formRegion: @sgt-form-enlace-tramos-fo
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 44132894680571381951
        }
    )

)

