page 14 (
    name: SGT_FORM_EQUIPO
    alias: SGT-FORM-EQUIPO
    title: Formulario Equipo
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region datos-adicionales (
        name: Datos Adicionales
        title: Datos Adicionales
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @tabs
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region datos-log (
        name: DATOS_LOG
        type: staticContent
        source {
            htmlCode:
                ```html
                Creado por &P14_CREADO_POR. el &P14_CREADO_EL..
                Actualizado por &P14_ACTUALIZADO_POR. el &P14_ACTUALIZADO_EL. 
                ```
        }
        layout {
            sequence: 10
            parentRegion: @sgt-form-equipo
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_CREADO_POR
        }
    )

    region datos-principales (
        name: Datos Principales
        title: Datos Principales
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region historial-classic-report (
        name: HISTORIAL_CLASSIC_REPORT
        title: Historial
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    AUDIT_ID,
                    FECHA_HORA,
                    USUARIO,
                    TIPO_COMPONENTE                                       AS COMPONENTE,
                    TIPO_OPERACION                                        AS ACCION,
                    DETALLE_OLD_VALUE                                     AS OLD_VALUE,
                    DETALLE_NEW_VALUE                                     AS NEW_VALUE
                FROM V_AUDIT_EQUIPOS
                WHERE EQUIPO_ID = TO_CHAR(:P14_ID)
                    AND TIPO_OPERACION IN ('UPDATE', 'DELETE', 'Actualización', 'Eliminación')
                ORDER BY FECHA_HORA_FILTRO DESC;
                ```
            pageItemsToSubmit: P14_ID
        }
        layout {
            sequence: 30
            parentRegion: @tabs
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ACCION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Acción
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column AUDIT_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column COMPONENTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Componente
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: hidden
            layout {
                sequence: 90
            }
        )

        column FECHA_HORA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Fecha Hora
            }
            layout {
                sequence: 20
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 100
            }
        )

        column NEW_VALUE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Valores Actuales
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column OLD_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Valores Anteriores
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuario
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

    )

    region sgt-form-equipo (
        name: SGT_FORM_EQUIPO
        title: Agregar / Editar
        type: form
        source {
            location: localDatabase
            tableName: SGT_EQUIPOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region tabs (
        name: TABS
        title: TABS
        type: regionDisplaySelector
        layout {
            sequence: 60
            parentRegion: @sgt-form-equipo
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        settings {
            includeShowAll: false
        }
    )

