page 161 (
    name: BANDEJA-SESIONES
    alias: BANDEJA-SESIONES
    title: Bandeja de mis sesiones
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bandeja-sesiones (
        name: BANDEJA-SESIONES
        title: Sesiones operativas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EO.ID,
                       EO.CODIGO,
                       EO.TITULO,
                       EO.TIPO_CASO,
                       EO.ESTADO,
                       EO.REPORTADO_POR,
                       CA.NOMBRE AS TIPO_ACTIVO,
                       TO_CHAR(EO.CREADO_EL, 'DD/MM/YYYY HH24:MI') AS FECHA_INICIO
                  FROM SGT_EVENTO_OPERATIVO EO
                  LEFT JOIN SGT_CAT_TIPO_ACTIVO_EVENTO CA ON CA.ID = EO.TIPO_ACTIVO_PRINCIPAL_ID
                 ORDER BY EO.CREADO_EL DESC
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 23255197186968306
        }

        column CODIGO (
            type: link
            heading {
                heading: Codigo
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 163
                    items: {
                        P163_EVENTO_ID: #ID##EVENTO_ID#
                    }
                }
                linkText: #CODIGO#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FECHA_INICIO (
            type: plainText
            heading {
                heading: Fecha Inicio
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column REPORTADO_POR (
            type: plainText
            heading {
                heading: Reportado Por
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column TIPO_ACTIVO (
            type: plainText
            heading {
                heading: Tipo Activo
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column TIPO_CASO (
            type: plainText
            heading {
                heading: Tipo Caso
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TITULO (
            type: plainText
            heading {
                heading: Titulo
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Sesiones operativas
        }

        savedReport 232751 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODIGO (
                sequence: 1
            )

            displayColumn ESTADO (
                sequence: 5
            )

            displayColumn FECHA_INICIO (
                sequence: 7
            )

            displayColumn REPORTADO_POR (
                sequence: 6
            )

            displayColumn TIPO_ACTIVO (
                sequence: 3
            )

            displayColumn TIPO_CASO (
                sequence: 2
            )

            displayColumn TITULO (
                sequence: 4
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        title: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P161_FILTRO_ESTADO (
        type: selectList
        label {
            label: Estados
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Abierto;ABIERTO,En Ejecución;EN_EJECUCION,Cerrado;CERRADO
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P161_FILTRO_TIPO_CASO (
        type: textField
        label {
            label: Tipo de caso
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button p161-btn-aplicar-filtros (
        buttonName: P161_BTN_APLICAR_FILTROS
        label: Aplicar Filtros
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button p161-btn-limpiar-filtros (
        buttonName: P161_BTN_LIMPIAR_FILTROS
        label: Limpiar Filtros
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button p161-btn-nuevo-trabajo (
        buttonName: P161_BTN_NUEVO_TRABAJO
        label: Nuevo Evento
        layout {
            sequence: 10
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                clearCache: 162
                action: clearRegions
                request: NEW
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

