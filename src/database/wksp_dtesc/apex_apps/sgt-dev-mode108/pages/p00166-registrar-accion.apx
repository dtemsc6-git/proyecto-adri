page 166 (
    name: REGISTRAR ACCION
    alias: REGISTRAR-ACCION
    title: Registrar tarea
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P166_ACCION (
        type: textarea
        label {
            label: Tarea
            alignment: left
        }
        layout {
            sequence: 60
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
    )

    pageItem P166_ACCION_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P166_DETALLE (
        type: textarea
        label {
            label: Detalle
            alignment: left
        }
        layout {
            sequence: 80
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
    )

    pageItem P166_EVENTO_ACTIVO_ID (
        type: selectList
        label {
            label: Activo vinculado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CASE TA.CODIGO
                           WHEN 'SERVICIO' THEN (SELECT S.NOMBRE FROM SGT_SERVICIOS S WHERE S.ID = EA.ACTIVO_ID)
                           WHEN 'EQUIPO'   THEN (SELECT E.NOMBRE FROM SGT_EQUIPOS E WHERE E.ID = EA.ACTIVO_ID)
                           WHEN 'SITIO'    THEN (SELECT SI.NOMBRE FROM SGT_SITIOS SI WHERE SI.ID = EA.ACTIVO_ID)
                           WHEN 'SALA'     THEN (SELECT SA.NOMBRE FROM SGT_SALAS SA WHERE SA.ID = EA.ACTIVO_ID)
                           WHEN 'RACK'      THEN (SELECT R.NOMBRE FROM SGT_RACKS R WHERE R.ID = EA.ACTIVO_ID)
                           WHEN 'ENLACE_FO' THEN (SELECT EFO.NOMBRE FROM SGT_ENLACES_FO EFO WHERE EFO.ID = EA.ACTIVO_ID) 
                           ELSE TO_CHAR(EA.ACTIVO_ID)
                       END || CASE WHEN EA.ES_PRINCIPAL = 1 THEN ' (Principal)' ELSE '' END AS d,
                       EA.ID AS r
                  FROM SGT_EVENTO_ACTIVO EA
                  LEFT JOIN SGT_CAT_TIPO_ACTIVO_EVENTO TA ON TA.ID = EA.TIPO_ACTIVO_ID
                 WHERE EA.EVENTO_ID = :P166_EVENTO_ID
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P166_EVENTO_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P166_RESULTADO (
        type: selectList
        label {
            label: Resultado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:PENDIENTE;PENDIENTE,FUNCIONAMIENTO OK;EXITOSO,FALLA DETECTADA;FALLIDO
        }
        layout {
            sequence: 70
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P166_TIPO_ACCION_ID (
        type: selectList
        label {
            label: Tipo de tarea
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @sgt-cat-tipo-accion-evento
        }
        layout {
            sequence: 50
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 100
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar
        layout {
            sequence: 90
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process cargar-accion (
        name: CARGAR_ACCION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SELECT A.TIPO_ACCION_ID, A.ACCION, A.RESULTADO,
                           A.DETALLE, A.TIEMPO_EMPLEADO_MIN, A.EVENTO_ACTIVO_ID
                      INTO :P166_TIPO_ACCION_ID, :P166_ACCION, :P166_RESULTADO,
                           :P166_DETALLE, :P166_TIEMPO_MIN, :P166_EVENTO_ACTIVO_ID
                      FROM SGT_EVENTO_ACCION A
                     WHERE A.ID = :P166_ACCION_ID;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26868395629123339
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P166_ACCION_ID
        }
    )

    process cerrar-dialog (
        name: CERRAR_DIALOG
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 26868578153123341
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
    )

    process nueva-accion (
        name: NUEVA_ACCION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P166_EVENTO_ACTIVO_ID IS NULL THEN
                        SELECT EA.ID INTO :P166_EVENTO_ACTIVO_ID
                          FROM SGT_EVENTO_ACTIVO EA
                         WHERE EA.EVENTO_ID = :P166_EVENTO_ID
                           AND EA.ES_PRINCIPAL = 1
                           AND ROWNUM = 1;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27326635055871825
        }
        serverSideCondition {
            type: itemIsNull
            item: P166_ACCION_ID
        }
    )

    process prc-guardar-accion (
        name: PRC_GUARDAR_ACCION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_ACCION_ID NUMBER;
                BEGIN
                    IF :P166_ACCION_ID IS NULL THEN
                        SGT_EVENTO_PKG.REGISTRAR_ACCION(
                            P_EVENTO_ACTIVO_ID    => :P166_EVENTO_ACTIVO_ID,
                            P_TIPO_ACCION_ID      => :P166_TIPO_ACCION_ID,
                            P_ACCION              => :P166_ACCION,
                            P_RESULTADO           => NVL(:P166_RESULTADO, 'PENDIENTE'),
                            P_DETALLE             => :P166_DETALLE,
                            P_TIEMPO_EMPLEADO_MIN => :P166_TIEMPO_MIN,
                            P_EJECUTADO_POR       => :APP_USER,
                            P_EVENTO_ACCION_ID    => V_ACCION_ID
                        );
                    ELSE
                        SGT_EVENTO_PKG.EDITAR_ACCION(
                            P_EVENTO_ACCION_ID    => :P166_ACCION_ID,
                            P_TIPO_ACCION_ID      => :P166_TIPO_ACCION_ID,
                            P_ACCION              => :P166_ACCION,
                            P_RESULTADO           => :P166_RESULTADO,
                            P_DETALLE             => :P166_DETALLE,
                            P_TIEMPO_EMPLEADO_MIN => :P166_TIEMPO_MIN,
                            P_EVENTO_ACTIVO_ID    => :P166_EVENTO_ACTIVO_ID
                        );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 26868485839123340
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
    )

)

