    region en-uso (
        name: EN_USO
        title: Atención
        type: staticContent
        source {
            htmlCode: Esta interfaz esta en uso, modificar los datos podría afectar: Servicios / Enlaces / Otros.-
        }
        layout {
            sequence: 10
            parentRegion: @sgt-from-interfaces
            slot: regionBody
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
            ]
            cssClasses: warning
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                   v_id_interfaz CONSTANT sgt_interfaces.id%TYPE := :P30_ID;
                   v_existe NUMBER;
                BEGIN
                   -- Consulta combinada
                   BEGIN
                      SELECT 1 INTO v_existe
                      FROM dual
                      WHERE EXISTS (
                         SELECT 1 FROM sgt_equipos_wan
                         WHERE interfaz_a_id = v_id_interfaz OR interfaz_b_id = v_id_interfaz
                      ) OR EXISTS (
                         SELECT 1 FROM sgt_equipos_servicio
                         WHERE interfaz_a_id = v_id_interfaz OR interfaz_b_id = v_id_interfaz
                      );
                      
                      RETURN TRUE; -- Existe en alguna tabla
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                         RETURN FALSE; -- No existe en ninguna tabla
                   END;
                END;
                ```
        }
    )

