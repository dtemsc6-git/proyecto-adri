    region conectividad (
        name: Conectividad
        title: Conectividad
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_SRV,
                       SERVICIO,
                       NIVEL_DE_PRIORIDAD,
                       SITIOS,
                       WAN,
                       EQUIPO,
                       INTERFACE,
                       FO,
                       SEQ,
                       WAN_SEQ
                  from V_SERVICIOS V
                   JOIN SGT_OT_SERVICIO OS
                    ON OS.SERVICIO_ID = V.ID_SRV
                 where OS.OT_ID = :P120_ID
                ```
            pageItemsToSubmit: P120_ID
        }
        layout {
            sequence: 90
            parentRegion: @detalle-ot
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column EQUIPO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Equipo
            }
            layout {
                sequence: 120
            }
        )

        column FO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Fo
            }
            layout {
                sequence: 140
            }
        )

        column ID_SRV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Id Srv
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
        )

        column INTERFACE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Interface
            }
            layout {
                sequence: 130
            }
        )

        column NIVEL_DE_PRIORIDAD (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Nivel De Prioridad
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
        )

        column SEQ (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Seq
                alignment: end
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
        )

        column SERVICIO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Servicio
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column SITIOS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Sitios
            }
            layout {
                sequence: 110
            }
        )

        column WAN (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Wan
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column WAN_SEQ (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Wan Seq
                alignment: end
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
        )

    )

    region conectividad-old (
        name: Conectividad_old
        title: Conectividad_old
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       V.SERV_ID,
                       V.SERVICIO,
                       V.NIVEL_DE_PRIORIDAD,
                       V.EQ_ID,
                       V.EQ,
                       V.IFACE_ID,
                       V.IFACE,
                       V.EQ_B_ID,
                       V.EQ_B,
                       V.IFACE_B_ID,
                       V.IFACE_B,
                       V.CONN_ID,
                       V.TIPO_CONEXION,
                       V.FO_ID,
                       V.FO_NOMBRE,
                       V.SEQ,
                       V.WAN_ID,
                       V.WAN,
                       V.SEQ_WAN
                  FROM V_CONEXIONES_GENERAL_V2 V
                  JOIN SGT_OT_SERVICIO OS
                    ON OS.SERVICIO_ID = V.SERV_ID
                 WHERE OS.OT_ID = :P120_ID
                 ORDER BY V.SEQ NULLS LAST, V.SEQ_WAN NULLS LAST, V.CONN_ID
                ```
            pageItemsToSubmit: P120_ID
        }
        layout {
            sequence: 80
            parentRegion: @detalle-ot
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column EQ (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Eq
            }
            layout {
                sequence: 50
            }
