    region servicio-asociado (
        name: Servicio Asociado
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT O.CODIGO,
                       S.ID SERVICIO_ID,
                       S.NOMBRE SERVICIO,
                       OS.CREADO_EL
                  FROM SGT_OT O
                  JOIN SGT_OT_SERVICIO OS ON OS.OT_ID = O.ID
                  JOIN SGT_SERVICIOS S ON S.ID = OS.SERVICIO_ID
                 WHERE O.ID = :P120_ID
                ```
        }
        layout {
            sequence: 60
            parentRegion: @detalle-ot
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CREADO_EL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Creado El
            }
            layout {
                sequence: 40
            }
        )

        column SERVICIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Servicio
            }
            layout {
                sequence: 30
            }
        )

    )

    region topologia (
        name: Topologia
        title: Contexto físico del servicio
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                       OS.OT_ID,
                       S.ID AS SERVICIO_ID,
                       S.NOMBRE AS SERVICIO_NOMBRE,
                       SS.SITIO_ID,
                       SI.SIGLAS AS SITIO_SIGLAS,
                       SI.NOMBRE AS SITIO_NOMBRE,
                       R.ID AS RACK_ID,
                       R.NOMBRE AS RACK_NOMBRE
                  FROM SGT_OT_SERVICIO OS
                  JOIN SGT_SERVICIOS S ON S.ID = OS.SERVICIO_ID
                  LEFT JOIN SGT_SITIOS_SERVICIO SS ON SS.SERVICIO_ID = OS.SERVICIO_ID
                  LEFT JOIN SGT_SITIOS SI ON SI.ID = SS.SITIO_ID
                  LEFT JOIN SGT_SALAS SA ON SA.SITIO_ID = SI.ID
                  LEFT JOIN SGT_RACKS R ON R.SALA_ID = SA.ID
                 WHERE OS.OT_ID = :P120_ID
                 ORDER BY SI.NOMBRE, R.NOMBRE
                ```
            pageItemsToSubmit: P120_ID
        }
        layout {
            sequence: 70
            parentRegion: @detalle-ot
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column RACK_NOMBRE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Rack Nombre
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column SERVICIO_NOMBRE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Servicio Nombre
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column SITIO_NOMBRE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Sitio Nombre
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column SITIO_SIGLAS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Sitio Siglas
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

    )

