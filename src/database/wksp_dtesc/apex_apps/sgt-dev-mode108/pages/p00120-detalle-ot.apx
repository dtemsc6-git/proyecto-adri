    process initialize-form-detalle-ot (
        name: Initialize form DETALLE OT
        type: formInitialization
        formRegion: @detalle-ot
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21830798270597746
        }
    )

    process prc-p120-vincular-serv (
        name: PRC_P120_VINCULAR_SERV
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  SGT_OT_PKG.VINCULAR_SERVICIO_OT(
                        P_OT_ID       => :P120_ID,
                        P_SERVICIO_ID => :P120_SERVICIO_ID,
                        P_USUARIO     => :APP_USER
                    );
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 20412501556160950
        }
        serverSideCondition {
            whenButtonPressed: @btn-vincular-servicio
        }
    )

    process process-form-detalle-ot (
        name: Process form DETALLE OT
        type: formAutoRowProcessing
        formRegion: @detalle-ot
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21831187209597746
        }
        config {
            buildOption: @commented-out
        }
    )

)

