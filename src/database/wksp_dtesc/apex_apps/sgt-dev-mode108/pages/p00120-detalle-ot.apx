            heading {
                heading: Fo Nombre
            }
            layout {
                sequence: 150
            }
            sorting {
                sortable: false
            }
        )

        column IFACE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Iface
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column IFACE_B (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Iface B
            }
            layout {
                sequence: 110
            }
            sorting {
                sortable: false
            }
        )

        column SERVICIO (
            reportColumnQueryId: 2
            derivedColumn: N
