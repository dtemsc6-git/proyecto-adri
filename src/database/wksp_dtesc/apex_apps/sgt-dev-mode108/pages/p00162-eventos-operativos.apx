    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 30
            region: @acciones
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 161
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button guardar-borrador (
        buttonName: GUARDAR_BORRADOR
        label: Guardar Borrador
        layout {
            sequence: 20
            region: @acciones
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    button iniciar-sesion (
        buttonName: INICIAR_SESION
        label: Iniciar evento
        layout {
            sequence: 10
            region: @acciones
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P162_TIPO_ACTIVO_PRINCIPAL_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P162_ACTIVO_PRINCIPAL_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process cargar-borrador (
        name: Cargar borrador
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SELECT EO.CODIGO, EO.TIPO_CASO, EO.TITULO, EO.DESCRIPCION,
                           EO.TIPO_ACTIVO_PRINCIPAL_ID, EO.ACTIVO_PRINCIPAL_ID
                      INTO :P162_CODIGO, :P162_TIPO_CASO, :P162_TITULO, :P162_DESCRIPCION,
                           :P162_TIPO_ACTIVO_PRINCIPAL_ID, :P162_ACTIVO_PRINCIPAL_ID
                      FROM SGT_EVENTO_OPERATIVO EO
                     WHERE EO.ID = :P162_ID;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26604226053497118
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P162_ID
        }
    )

    process prc-crear-evento-operativo (
        name: PRC_Crear Evento Operativo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_EVENTO_ID NUMBER;
                    V_CODIGO    VARCHAR2(30);
                BEGIN
                    IF :P162_ID IS NULL THEN
                        SGT_EVENTO_PKG.INICIAR_SESION_CON_ACTIVO(
                            P_TIPO_ACTIVO_PRINCIPAL_ID => :P162_TIPO_ACTIVO_PRINCIPAL_ID,
                            P_ACTIVO_PRINCIPAL_ID      => :P162_ACTIVO_PRINCIPAL_ID,
                            P_TIPO_CASO                => :P162_TIPO_CASO,
                            P_TITULO                   => :P162_TITULO,
                            P_DESCRIPCION              => :P162_DESCRIPCION,
                            P_REPORTADO_POR            => :APP_USER,
                            P_IDENTIFICADOR_ACTIVO     => TO_CHAR(:P162_ACTIVO_PRINCIPAL_ID),
                            P_DESCRIPCION_ACTIVO       => NULL,
                            P_EVENTO_ID                => V_EVENTO_ID,
                            P_CODIGO                   => V_CODIGO
                        );
                        :P162_ID     := V_EVENTO_ID;
                        :P162_CODIGO := V_CODIGO;
                    ELSE
                        UPDATE SGT_EVENTO_OPERATIVO
                           SET TIPO_ACTIVO_PRINCIPAL_ID = :P162_TIPO_ACTIVO_PRINCIPAL_ID,
                               ACTIVO_PRINCIPAL_ID      = :P162_ACTIVO_PRINCIPAL_ID,
                               TIPO_CASO                = :P162_TIPO_CASO,
                               TITULO                   = :P162_TITULO,
                               DESCRIPCION              = :P162_DESCRIPCION,
                               ACTUALIZADO_POR          = :APP_USER,
                               ACTUALIZADO_EL           = SYSTIMESTAMP
                         WHERE ID = :P162_ID;
                
                        MERGE INTO SGT_EVENTO_ACTIVO EA
                        USING (SELECT :P162_ID AS EVENTO_ID,
                                      :P162_TIPO_ACTIVO_PRINCIPAL_ID AS TIPO_ACTIVO_ID,
                                      :P162_ACTIVO_PRINCIPAL_ID AS ACTIVO_ID,
                                      TO_CHAR(:P162_ACTIVO_PRINCIPAL_ID) AS IDENTIFICADOR_ACTIVO
                                 FROM DUAL) SRC
                           ON (EA.EVENTO_ID = SRC.EVENTO_ID AND EA.ES_PRINCIPAL = 1)
                        WHEN MATCHED THEN
                            UPDATE SET EA.TIPO_ACTIVO_ID       = SRC.TIPO_ACTIVO_ID,
                                       EA.ACTIVO_ID            = SRC.ACTIVO_ID,
                                       EA.IDENTIFICADOR_ACTIVO = SRC.IDENTIFICADOR_ACTIVO
                        WHEN NOT MATCHED THEN
                            INSERT (EVENTO_ID, TIPO_ACTIVO_ID, ACTIVO_ID, IDENTIFICADOR_ACTIVO,
                                    ES_PRINCIPAL, CREADO_POR, CREADO_EL)
                            VALUES (SRC.EVENTO_ID, SRC.TIPO_ACTIVO_ID, SRC.ACTIVO_ID,
                                    SRC.IDENTIFICADOR_ACTIVO, 1, :APP_USER, SYSTIMESTAMP);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23401525487956822
        }
        serverSideCondition {
            whenButtonPressed: @iniciar-sesion
        }
    )

    process prc-guardar-borrador (
        name: PRC_guardar borrador
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_EVENTO_ID NUMBER;
                    V_CODIGO    VARCHAR2(30);
                BEGIN
                    IF :P162_TIPO_ACTIVO_PRINCIPAL_ID IS NULL OR :P162_ACTIVO_PRINCIPAL_ID IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20002, 'Seleccioná tipo de activo y activo para guardar borrador.');
                    END IF;
                    IF :P162_ID IS NULL THEN
                        SGT_EVENTO_PKG.INICIAR_SESION_CON_ACTIVO(
                            P_TIPO_ACTIVO_PRINCIPAL_ID => :P162_TIPO_ACTIVO_PRINCIPAL_ID,
                            P_ACTIVO_PRINCIPAL_ID      => :P162_ACTIVO_PRINCIPAL_ID,
                            P_TIPO_CASO                => NVL(:P162_TIPO_CASO, 'OTRO'),
                            P_TITULO                   => NVL(:P162_TITULO, 'BORRADOR ' || TO_CHAR(SYSTIMESTAMP, 'YYYYMMDDHH24MISS')),
                            P_DESCRIPCION              => :P162_DESCRIPCION,
                            P_REPORTADO_POR            => :APP_USER,
                            P_IDENTIFICADOR_ACTIVO     => TO_CHAR(:P162_ACTIVO_PRINCIPAL_ID),
                            P_DESCRIPCION_ACTIVO       => NULL,
                            P_EVENTO_ID                => V_EVENTO_ID,
                            P_CODIGO                   => V_CODIGO
                        );
                        :P162_ID := V_EVENTO_ID;
                    ELSE
                        UPDATE SGT_EVENTO_OPERATIVO
                           SET TIPO_CASO       = NVL(:P162_TIPO_CASO, TIPO_CASO),
                               TITULO          = NVL(:P162_TITULO, TITULO),
                               DESCRIPCION     = :P162_DESCRIPCION,
                               ACTUALIZADO_POR = :APP_USER,
                               ACTUALIZADO_EL  = SYSTIMESTAMP
                         WHERE ID = :P162_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23401723277956824
        }
        serverSideCondition {
            whenButtonPressed: @guardar-borrador
        }
    )

    process prc-registrar-accion-inicial-si-existe (
        name: PRC_Registrar accion inicial si existe
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_EVENTO_ACTIVO_ID NUMBER;
                BEGIN
                    SELECT EA.ID INTO V_EVENTO_ACTIVO_ID
                      FROM SGT_EVENTO_ACTIVO EA
                     WHERE EA.EVENTO_ID = :P162_ID AND EA.ES_PRINCIPAL = 1 AND ROWNUM = 1;
                
                    SGT_EVENTO_PKG.REGISTRAR_ACCION(
                        P_EVENTO_ACTIVO_ID    => V_EVENTO_ACTIVO_ID,
                        P_TIPO_ACCION_ID      => :P162_ACCION_TIPO_ID,
                        P_ACCION              => :P162_ACCION_INICIAL,
                        P_RESULTADO           => 'PENDIENTE',
                        P_DETALLE             => :P162_OBSERVACION_INICIAL,
                        P_TIEMPO_EMPLEADO_MIN => NULL,
                        P_EJECUTADO_POR       => :APP_USER,
                        P_EVENTO_ACCION_ID    => :P162_EVENTO_ACCION_ID
                    );
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 23401667484956823
        }
        serverSideCondition {
            whenButtonPressed: @iniciar-sesion
            type: expression
            plsqlExpression: TRIM(:P162_ACCION_INICIAL) IS NOT NULL AND :P162_ACCION_TIPO_ID IS NOT NULL
        }
    )

    branch (
        name: BRANCH_INICIAR_SESION
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 163
                items: {
                    P163_EVENTO_ID: &P162_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @iniciar-sesion
        }
    )

    branch (
        name: GUARDAR_BORRADOR
        execution {
            sequence: 20
            point: processing
        }
        behavior {
            target: {
                page: 162
                items: {
                    P162_ID: &P162_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @guardar-borrador
        }
    )

)

