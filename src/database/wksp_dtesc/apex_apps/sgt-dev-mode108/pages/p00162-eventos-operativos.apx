    pageItem P162_ACCION_TIPO_ID (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NOMBRE d, ID r
                  FROM SGT_CAT_TIPO_ACCION_EVENTO
                 WHERE ACTIVO = 'Y'
                 ORDER BY NOMBRE
                ```
        }
        layout {
            sequence: 20
            region: @primeras-acciones
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P162_ACTIVO_PRINCIPAL_ID (
        type: popupLov
        label {
            label: Activo principal
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT display_value d, id r
                  FROM (
                    SELECT S.NOMBRE AS display_value, S.ID, 'SERVICIO' AS tipo_codigo FROM SGT_SERVICIOS S
                    UNION ALL
                    SELECT E.NOMBRE, E.ID, 'EQUIPO' FROM SGT_EQUIPOS E
                    UNION ALL
                    SELECT SI.NOMBRE, SI.ID, 'SITIO' FROM SGT_SITIOS SI
                    UNION ALL
                    SELECT SA.NOMBRE, SA.ID, 'SALA' FROM SGT_SALAS SA
                    UNION ALL
                    SELECT R.NOMBRE, R.ID, 'RACK' FROM SGT_RACKS R
                    UNION ALL 
                    SELECT EFO.NOMBRE, EFO.ID, 'ENLACE_FO' FROM SGT_ENLACES_FO EFO
                  ) X
                 WHERE X.tipo_codigo = (
                    SELECT TA.CODIGO FROM SGT_CAT_TIPO_ACTIVO_EVENTO TA
                     WHERE TA.ID = :P162_TIPO_ACTIVO_PRINCIPAL_ID
                 )
                ORDER BY display_value 
                ```
        }
        cascadingLov {
            parentItems: P162_TIPO_ACTIVO_PRINCIPAL_ID
            itemsToSubmit: P162_TIPO_ACTIVO_PRINCIPAL_ID
        }
        layout {
            sequence: 20
            region: @activo-principal
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P162_CODIGO (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P162_DESCRIPCION (
