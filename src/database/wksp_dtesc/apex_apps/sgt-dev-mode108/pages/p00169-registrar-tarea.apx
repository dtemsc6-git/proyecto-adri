page 169 (
    name: REGISTRAR_TAREA
    alias: REGISTRAR-TAREA
    title: REGISTRAR_TAREA
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P169_ACTIVO_LABEL (
        type: displayOnly
        label {
            label: Activo vinculado
            alignment: left
        }
        layout {
            sequence: 50
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P169_ANOTACION_ID (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P169_DESCRIPCION (
        type: textarea
        label {
            label: Tarea
            alignment: left
        }
        layout {
            sequence: 80
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
    )

    pageItem P169_ENTIDAD (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P169_ESTADO (
        type: selectList
        label {
            label: Estado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:PENDIENTE;PENDIENTE,REALIZADO;REALIZADO,RECHAZADO;RECHAZADO
        }
        layout {
            sequence: 90
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P169_ID
        }
    )

    pageItem P169_EVENTO_ID (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P169_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P169_MOTIVO (
        type: textarea
        label {
            label: Motivo del rechazo
            alignment: left
        }
        layout {
            sequence: 100
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 2000
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P169_ID
        }
    )

    pageItem P169_PK_ID (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P169_TIPO_TAREA_ID (
        type: selectList
        label {
            label: Tipo de tarea
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NOMBRE AS d, ID AS r
                  FROM SGT_CAT_TIPO_ACCION_EVENTO
                 WHERE ACTIVO = 'Y'
                   AND CODIGO IN ('MOD_FISICA','MOD_LOGICA','VER_FISICA','VER_LOGICA','ANOTACION')
                 ORDER BY DECODE(CODIGO,'ANOTACION',9,1), NOMBRE
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button btn-guardar-cerrado (
        buttonName: BTN_GUARDAR_CERRADO
        label: Guardar tarea realizada
        layout {
            sequence: 130
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 140
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar tarea pendiente
        layout {
            sequence: 110
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction da-estado-rechazado (
        name: DA_ESTADO_RECHAZADO
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P169_ESTADO
        }
        clientSideCondition {
            type: item=value
            item: P169_ESTADO
            value: RECHAZADO
        }

        action oculta-motivo (
            name: OCULTA_MOTIVO
            action: hide
            affectedElements {
                selectionType: items
                items: P169_MOTIVO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action requiere-motivo (
            name: REQUIERE_MOTIVO
            action: show
            affectedElements {
                selectionType: items
                items: P169_MOTIVO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction da-tipo-anotacion (
        name: DA_TIPO_ANOTACION
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P169_TIPO_TAREA_ID
        }
        clientSideCondition {
            type: item=value
            item: P169_TIPO_TAREA_ID
            value: &P169_ANOTACION_ID.
        }

        action estado (
            name: OCULTAR_ESTADO
            action: hide
            affectedElements {
                selectionType: items
                items: P169_ESTADO
            }
            execution {
                sequence: 10
            }
        )

        action estado_1 (
            name: MOSTRAR_ESTADO
            action: show
            affectedElements {
                selectionType: items
                items: P169_ESTADO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action motivo (
            name: OCULTAR_MOTIVO
            action: hide
            affectedElements {
                selectionType: items
                items: P169_MOTIVO
            }
            execution {
                sequence: 20
            }
        )

    )

    validation v-motivo-rechazo (
        name: V_MOTIVO_RECHAZO
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF :P169_ESTADO = 'RECHAZADO' AND :P169_MOTIVO IS NULL THEN
                        RETURN 'Para rechazar la tarea debes indicar el motivo.';
                    END IF;
                    RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @guardar
            type: itemIsNotNull
            item: P169_ID
        }
    )

    computation p169-anotacion-id (
        itemName: P169_ANOTACION_ID
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: SELECT ID FROM SGT_CAT_TIPO_ACCION_EVENTO WHERE CODIGO = 'ANOTACION'
        }
    )

    process p-alta (
        name: P_ALTA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P169_ID := SGT_TAREA_PKG.CREAR_TAREA(
                                    p_entidad       => :P169_ENTIDAD,
                                    p_pk_id         => :P169_PK_ID,
                                    p_tipo_tarea_id => :P169_TIPO_TAREA_ID,
                                    p_descripcion   => :P169_DESCRIPCION,
                                    p_evento_id     => :P169_EVENTO_ID);
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9832900484317108
        }
        serverSideCondition {
            whenButtonPressed: @guardar
            type: itemIsNull
            item: P169_ID
        }
    )

    process p-cargar (
        name: P_CARGAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SELECT t.TIPO_TAREA_ID, t.DESCRIPCION, t.ESTADO, t.ENTIDAD, t.PK_ID
                      INTO :P169_TIPO_TAREA_ID, :P169_DESCRIPCION, :P169_ESTADO, :P169_ENTIDAD, :P169_PK_ID
                      FROM SGT_TAREA t
                     WHERE t.ID = :P169_ID;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9833378513317112
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P169_ID
        }
    )

    process p-cerrar-dialogo (
        name: P_CERRAR_DIALOGO
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9833230115317111
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
    )

    process p-edicion-datos (
        name: P_EDICION_DATOS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SGT_TAREA_PKG.ACTUALIZAR_TAREA(
                        p_tarea_id      => :P169_ID,
                        p_tipo_tarea_id => :P169_TIPO_TAREA_ID,
                        p_descripcion   => :P169_DESCRIPCION);
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 9833041823317109
        }
        serverSideCondition {
            whenButtonPressed: @guardar
            type: itemIsNotNull
            item: P169_ID
        }
    )

    process p-edicion-estado (
        name: P_EDICION_ESTADO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SGT_TAREA_PKG.CAMBIAR_ESTADO(
                        p_tarea_id     => :P169_ID,
                        p_nuevo_estado => :P169_ESTADO,
                        p_comentario   => :P169_MOTIVO);
                EXCEPTION
                    WHEN OTHERS THEN
                
                        IF SQLCODE != -20015 THEN RAISE; END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 9833130131317110
        }
        serverSideCondition {
            whenButtonPressed: @guardar
            type: expression
            plsqlExpression: :P169_ID IS NOT NULL AND :P169_ESTADO IS NOT NULL
        }
    )

)

