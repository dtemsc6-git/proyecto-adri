page 24 (
    name: SGT_FORM_CIUDADES
    alias: SGT-FORM-CIUDADES
    title: Formulario Ciudades
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sgt-form-ciudades (
        name: SGT_FORM_CIUDADES
        type: form
        source {
            location: localDatabase
            tableName: SGT_CIUDAD
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P24_DEPTO_ID (
        type: selectList
        label {
            label: Departamento
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-sgt-dpto
        }
        layout {
            sequence: 40
            region: @sgt-form-ciudades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @sgt-form-ciudades
            column: DEPTO_ID
            dataType: number
        }
    )

    pageItem P24_ID (
        type: hidden
        layout {
            sequence: 20
            region: @sgt-form-ciudades
            slot: regionBody
        }
        source {
            formRegion: @sgt-form-ciudades
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P24_NOMBRE (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 30
            region: @sgt-form-ciudades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @sgt-form-ciudades
            column: NOMBRE
            dataType: varchar2
        }
    )

    pageItem P24_TITULO (
        type: hidden
        layout {
            sequence: 10
            region: @sgt-form-ciudades
            slot: regionBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Agregar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P24_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Eliminar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_ID
        }
    )

    dynamicAction actualizar-titulo-de-página (
        name: Actualizar titulo de página
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).ready(function() {
                    
                    apex.util.getTopApex().jQuery(".ui-dialog-content").dialog("option", "title", "&P24_TITULO.");
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 6936150668095909627
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sgt-form-ciudades (
        name: Initialize form SGT_FORM_CIUDADES
        type: formInitialization
        formRegion: @sgt-form-ciudades
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6936149899932909627
        }
    )

    process process-form-sgt-form-ciudades (
        name: Process form SGT_FORM_CIUDADES
        type: formAutoRowProcessing
        formRegion: @sgt-form-ciudades
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6936150276113909627
        }
    )

)

