    region enlaces-wan (
        name: Enlaces WAN
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_EQUIPOS_WAN
            whereClause: EQUIPO_A_ID=:P465_EQUIPO_ID
        }
        layout {
            sequence: 40
            parentRegion: @selector
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select * from 
                
                SGT_EQUIPOS_WAN
                where
                EQUIPO_A_ID=:P465_EQUIPO_ID
                ```
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: saveButton
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 21308401643884303
        }

        savedReport 213149 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @WAN_ID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @INTERFAZ_A_ID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column INTERFAZ_A_ID (
            type: popupLov
            heading {
                heading: "Interfaz "
            }
            lov {
                type: sqlQuery
                sqlQuery: SELECT NOMBRE ||' : '|| ETIQUETA, ID FROM SGT_INTERFACES WHERE EQUIPO_ID = :P465_EQUIPO_ID
                nullDisplayValue: Seleccione Una
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: INTERFAZ_A_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column WAN_ID (
            type: displayOnly
            heading {
                heading: Wan
            }
            settings {
                basedOn: lov
            }
            lov {
                type: sharedComponent
                lov: @enlaces-wan
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: WAN_ID
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    region interfaces (
        name: INTERFACES
        title: Interfaces
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id,
                       NOMBRE,
                       ETIQUETA,
                       ESTADO,
                       TX_EN_DBM,
                       RX_EN_DBM,
                       MAC_ADDRESS,
                       VELOCIDAD_MBPS
                
                  from SGT_INTERFACES
                
                 where EQUIPO_ID=:P465_EQUIPO_ID 
                -- 2026-06-11: dmf: Para poder editar los niveles se deben mostrar todas las interfaces del equipo
                -- and id not in (select interfaz_a_id from sgt_equipos_wan where equipo_a_id =:P465_EQUIPO_ID and interfaz_a_id is not null)
                -- and id not in (select interfaz_a_id from sgt_equipos_servicio where equipo_a_id =:P465_EQUIPO_ID and interfaz_a_id is not null)
                ```
            pageItemsToSubmit: P465_EQUIPO_ID
        }
        layout {
            sequence: 30
            parentRegion: @selector
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @implementador-rights
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        messages {
            whenNoDataFound: No hay datos que mostrar.
        }
        toolbar {
            controls: saveButton
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 24828085078840805
        }

