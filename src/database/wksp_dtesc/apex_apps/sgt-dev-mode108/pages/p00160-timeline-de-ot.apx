page 160 (
    name: TIMELINE DE OT
    alias: TIMELINE-DE-OT
    title: TIMELINE DE OT
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region timeline (
        name: TIMELINE
        title: Historial de la orden de trabajo
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT H.FECHA_EVENTO,
                       H.TIPO_EVENTO,
                       EO.NOMBRE ESTADO_ORIGEN,
                       ED.NOMBRE ESTADO_DESTINO,
                       H.DETALLE,
                       H.USUARIO_EVENTO
                  FROM SGT_OT_HISTORIAL H
                  LEFT JOIN SGT_CAT_OT_ESTADO EO ON EO.ID = H.ESTADO_ORIGEN_ID
                  LEFT JOIN SGT_CAT_OT_ESTADO ED ON ED.ID = H.ESTADO_DESTINO_ID
                 WHERE H.OT_ID = :P160_OT_ID
                 ORDER BY H.FECHA_EVENTO DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DETALLE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Detalle
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column ESTADO_DESTINO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Estado Destino
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column ESTADO_ORIGEN (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Estado Origen
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column FECHA_EVENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Fecha Evento
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column TIPO_EVENTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Tipo Evento
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO_EVENTO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Usuario Evento
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P160_OT_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button btn-volver (
        buttonName: BTN_VOLVER
        label: Volver
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 120
                items: {
                    P120_ID: &P160_OT_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

