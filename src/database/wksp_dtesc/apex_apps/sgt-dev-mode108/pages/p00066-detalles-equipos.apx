    region historial-equipo (
        name: Historial Equipo
        title: Historial
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    AUDIT_ID,
                    FECHA_HORA,
                    USUARIO,
                    TIPO_COMPONENTE                                       AS COMPONENTE,
                    TIPO_OPERACION                                        AS ACCION,
                    DETALLE_OLD_VALUE                                     AS OLD_VALUE,
                    DETALLE_NEW_VALUE                                     AS NEW_VALUE
                FROM V_AUDIT_EQUIPOS
                WHERE EQUIPO_ID = TO_CHAR(:P66_ID)
                    AND TIPO_OPERACION IN ('UPDATE', 'DELETE', 'Actualización', 'Eliminación')
                ORDER BY FECHA_HORA_FILTRO DESC;
                ```
            pageItemsToSubmit: P66_ID
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No se encontraron registros
        }

        column ACCION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Accion
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
