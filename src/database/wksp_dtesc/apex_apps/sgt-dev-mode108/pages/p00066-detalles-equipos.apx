        performance {
            lazyLoading: true
        }
    )

    region interfaces (
        name: INTERFACES
        title: Interfaces
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id,
                       NOMBRE,
                       ETIQUETA,
                       ESTADO,
                       TX_EN_DBM,
                       RX_EN_DBM,
                       MAC_ADDRESS,
                       VELOCIDAD_MBPS
                
                  from SGT_INTERFACES
                
                 where EQUIPO_ID=:P66_ID 
                -- 2026-06-11: dmf: Para poder editar los niveles se deben mostrar todas las interfaces del equipo
                -- and id not in (select interfaz_a_id from sgt_equipos_wan where equipo_a_id =:P66_EQUIPO_ID and interfaz_a_id is not null)
                -- and id not in (select interfaz_a_id from sgt_equipos_servicio where equipo_a_id =:P66_EQUIPO_ID and interfaz_a_id is not null)
                ```
            pageItemsToSubmit: P66_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @implementador-rights
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        messages {
            whenNoDataFound: No hay datos que mostrar.
        }
        toolbar {
            controls: saveButton
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 52685005722806207
        }

