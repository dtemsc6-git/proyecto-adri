    region servicios (
        name: Servicios
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_EQUIPOS_SERVICIO
            whereClause: EQUIPO_A_ID=:P66_ID
            pageItemsToSubmit: P66_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select * from 
                
                SGT_EQUIPOS_servicio
                where
                EQUIPO_A_ID=:P66_ID
                ```
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: saveButton
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 52967899252805898
        }

        savedReport 213318 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @SERVICIO_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @INTERFAZ_A_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column INTERFAZ_A_ID (
            type: popupLov
            heading {
                heading: Interfaz
            }
            lov {
                type: sqlQuery
                sqlQuery: SELECT NOMBRE ||' : '|| ETIQUETA, ID FROM SGT_INTERFACES WHERE EQUIPO_ID = :P66_ID
                nullDisplayValue: Seleccione Una
            }
            layout {
                sequence: 70
            }
            source {
