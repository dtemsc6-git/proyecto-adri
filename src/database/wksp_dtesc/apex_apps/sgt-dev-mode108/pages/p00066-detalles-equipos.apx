page 66 (
    name: Detalles Equipos
    alias: DETALLES-EQUIPOS
    title: Detalles Equipos
    appearance {
        pageTemplate: @/marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .a-Cards {
                scroll-snap-type: x mandatory;
                overflow-x: auto;
            }
            
            .a-Card {
                scroll-snap-align: center;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region acciones (
        name: Acciones
        type: list
        source {
            list: @acciones-equipos
        }
        layout {
            sequence: 60
            slot: rightSideColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--stacked
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            htmlDomId: lstAcciones
        }
        componentAppearance {
            listTemplate: @/links-list
            templateOptions: [
                #DEFAULT#
                t-LinksList--showIcons
            ]
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region comentarios (
        name: Comentarios
        type: themeTemplateComponent/comments
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ENTIDAD,
                       PK_ID,
                       COMENTARIO,
                       CREADO_POR,
                       SUBSTR(CREADO_POR, 1, 2) iniciales,
                       CREADO_EL,
                       actualizado_POR,
                       actualizado_EL
                  from SGT_COMENTARIOS
                 where entidad =4 and pk_id = :P66_ID
                ```
            pageItemsToSubmit: P66_ID
        }
        orderBy {
            type: item
            item: {
                itemName: P66_ORDER_BY
                orderBys: {
                    CREADO_EL: 1 desc
                    Comentarios: 2 asc
                    CREADO_POR: 3 asc
                }
            }
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        advanced {
            htmlDomId: rptComentarios
            regionDisplaySelector: true
        }
        componentAppearance {
            display: report
        }
        settings {
            commentText: COMENTARIO
            userName: CREADO_POR
            date: ACTUALIZADO_EL
            style: chatSpeechBubbles
        }
        plugin-avatar {
            type: initials
            initials: INICIALES
        }

        column ACTUALIZADO_EL (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: timestamp
            }
        )

        column ACTUALIZADO_POR (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
            }
        )

        column COMENTARIO (
