    dynamicAction close-comentarios (
        name: CLOSE_COMENTARIOS
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: #rptComentarios, #lstAcciones
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comentarios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction close-editar (
        name: CLOSE_EDITAR
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: #rptEquipo, #lstAcciones
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detalle-equipo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction close-imagenes (
        name: CLOSE_IMAGENES
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jQuerySelector
            jquerySelector: #crdImagenes, #lstAcciones
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @imagen
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescarcarousel (
        name: RefrescarCarousel
        execution {
            sequence: 10
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @imagen
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: console.log("Evento");
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

