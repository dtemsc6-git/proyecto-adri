page 110 (
    name: Crear OT
    alias: CREAR-OT
    title: Crear OT
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region crear-ot (
        name: Crear OT
        type: form
        source {
            location: localDatabase
            tableName: SGT_OT
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P110_CODIGO (
        type: displayOnly
        label {
            label: Codigo
            alignment: left
        }
        layout {
            sequence: 70
            region: @crear-ot
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @crear-ot
            column: CODIGO
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P110_DESCRIPCION (
        type: textarea
        label {
            label: Descripcion
            alignment: left
        }
        layout {
            sequence: 40
            region: @crear-ot
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 2000
        }
        source {
            formRegion: @crear-ot
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P110_ID (
        type: hidden
        layout {
            sequence: 60
            region: @crear-ot
            slot: regionBody
        }
        source {
            formRegion: @crear-ot
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P110_PRIORIDAD_ID (
        type: selectList
        label {
            label: Prioridad Id
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @sgt-cat-ot-prioridad-codigo
        }
        layout {
            sequence: 20
            region: @crear-ot
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @crear-ot
            column: PRIORIDAD_ID
            dataType: number
        }
    )

    pageItem P110_REPORTADO_POR (
        type: textField
        label {
            label: Reportado Por
            alignment: left
        }
        layout {
            sequence: 50
            region: @crear-ot
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @crear-ot
            column: REPORTADO_POR
            dataType: varchar2
        }
    )

    pageItem P110_TIPO_TRABAJO_ID (
        type: selectList
        label {
            label: Tipo Trabajo Id
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @sgt-cat-ot-tipo-trabajo-codigo
        }
        layout {
            sequence: 10
            region: @crear-ot
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @crear-ot
            column: TIPO_TRABAJO_ID
            dataType: number
        }
    )

    pageItem P110_TITULO (
        type: textField
        label {
            label: Titulo
            alignment: left
        }
        layout {
            sequence: 30
            region: @crear-ot
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @crear-ot
            column: TITULO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @crear-ot
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create-ot (
        buttonName: CREATE_OT
        label: Crear OT
        layout {
            sequence: 40
            region: @crear-ot
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P110_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @crear-ot
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @crear-ot
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    process initialize-form-crear-ot (
        name: Initialize form Crear OT
        type: formInitialization
        formRegion: @crear-ot
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21778743144728065
        }
    )

    process prc-p110-crear-ot (
        name: PRC_P110_CREAR_OT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    SGT_OT_PKG.CREAR_OT(
                        P_TIPO_TRABAJO_ID => :P110_TIPO_TRABAJO_ID,
                        P_PRIORIDAD_ID    => :P110_PRIORIDAD_ID,
                        P_TITULO          => :P110_TITULO,
                        P_DESCRIPCION     => :P110_DESCRIPCION,
                        P_REPORTADO_POR   => :P110_REPORTADO_POR,
                        P_OT_ID           => :P110_ID,
                        P_OT_CODIGO       => :P110_CODIGO
                    );
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 20409285424160917
        }
        serverSideCondition {
            whenButtonPressed: @create-ot
        }
    )

    process process-form-crear-ot (
        name: Process form Crear OT
        type: formAutoRowProcessing
        formRegion: @crear-ot
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21779183764728065
        }
        config {
            buildOption: @commented-out
        }
    )

    branch (
        name: Detalle OT
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 120
                items: {
                    P120_ID: &P110_ID.
                }
            }
        }
    )

)

