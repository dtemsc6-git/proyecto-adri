page 168 (
    name: Subir evidencia
    alias: SUBIR-EVIDENCIA
    title: Subir evidencia
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P168_ARCHIVO (
        type: fileUpload
        label {
            label: Archivo
            alignment: left
        }
        display {
            displayAs: blockDropzone
            dropzoneTitle: Zona para arrastrar
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P168_CATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:DIO;Return1,Fusión;Return2,Rectificador;Rectificador,Microondas;Microondas,General;General,Otro;Otro
        }
        layout {
            sequence: 40
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P168_DESCRIPCION (
        type: textField
        label {
            label: Descripcion
            alignment: left
        }
        layout {
            sequence: 50
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P168_EVENTO_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P168_TIPO_EVIDENCIA (
        type: selectList
        label {
            label: Tipo Evidencia
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:FOTO;FOTO,PDF;PDF,KMZ;KMZ,OTRO;OTRO
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prc-guardar (
        name: PRC_GUARDAR
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 27267853347548709
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
    )

    process prc-subir-evidencia (
        name: PRC_SUBIR_EVIDENCIA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_NOMBRE_ARCHIVO VARCHAR2(255);
                    V_MIME_TYPE      VARCHAR2(255);
                    V_BLOB           BLOB;
                BEGIN
                    IF TRIM(:P168_ARCHIVO) IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20017, 'Seleccioná un archivo.');
                    END IF;
                
                    SELECT T.FILENAME, T.MIME_TYPE, T.BLOB_CONTENT
                      INTO V_NOMBRE_ARCHIVO, V_MIME_TYPE, V_BLOB
                      FROM APEX_APPLICATION_TEMP_FILES T
                     WHERE T.NAME = :P168_ARCHIVO;
                
                    INSERT INTO SGT_EVENTO_EVIDENCIA (
                        EVENTO_ID, TIPO_EVIDENCIA, CATEGORIA,
                        NOMBRE_ARCHIVO, RUTA_ALMACENAMIENTO, DESCRIPCION,
                        ARCHIVO_BLOB, MIME_TYPE,
                        CARGADO_POR, FECHA_CARGA, CREADO_POR, CREADO_EL
                    ) VALUES (
                        :P168_EVENTO_ID, NVL(:P168_TIPO_EVIDENCIA, 'OTRO'), :P168_CATEGORIA,
                        V_NOMBRE_ARCHIVO, 'BD:BLOB', :P168_DESCRIPCION,
                        V_BLOB, V_MIME_TYPE,
                        :APP_USER, SYSTIMESTAMP, :APP_USER, SYSTIMESTAMP
                    );
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 27267666884548707
        }
    )

)

