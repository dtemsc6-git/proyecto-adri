page 59 (
    name: Admin IP's
    alias: ADMIN-IP-S
    title: Admin IP's
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region admin-ip-s (
        name: Admin IP's
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_IP_ADM
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12231412619919567
        }

        savedReport 122319 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 48.375
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @INTERFACE_ID
                layout {
                    width: 267.375
                    sequence: 3
                }
            )

            displayColumn (
                column: @IP
                layout {
                    width: 118.375
                    sequence: 4
                }
            )

            displayColumn (
                column: @MASK
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @GW
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ESTADO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @CREADO_EL
                layout {
                    show: false
                    sequence: 8
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @CREADO_POR
                layout {
                    show: false
                    sequence: 11
                }
            )

        )

        column ACTUALIZADO_EL (
            type: textField
            heading {
                heading: Actualizado El
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ACTUALIZADO_POR (
            type: textField
            heading {
                heading: Actualizado Por
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CREADO_EL (
            type: textField
            heading {
                heading: Creado El
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CREADO_EL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREADO_POR (
            type: textField
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CREADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ESTADO (
            type: textField
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column GW (
            type: textField
            heading {
                heading: Gateway
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 45
            }
            source {
                databaseColumn: GW
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column INTERFACE_ID (
            type: popupLov
            heading {
                heading: Interfaz
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @interfaces-nombre-compuesto
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: INTERFACE_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column IP (
            type: textField
            heading {
                heading: IP
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                maxLength: 45
            }
            source {
                databaseColumn: IP
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column MASK (
            type: textField
            heading {
                heading: Máscara de red
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 45
            }
            source {
                databaseColumn: MASK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Admin IP's
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button load (
        buttonName: LOAD
        label: Importar XLSX
        layout {
            sequence: 10
            region: @admin-ip-s
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 62
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process admin-ip-s-save-interactive-grid-data (
        name: Admin IP's - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @admin-ip-s
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12244105309919573
        }
    )

)

