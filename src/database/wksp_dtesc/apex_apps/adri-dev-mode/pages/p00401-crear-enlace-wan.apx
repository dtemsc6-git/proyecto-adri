page 401 (
    name: Crear el enlace WAN
    alias: CREAR-ENLACE-WAN
    title: Datos del enlace WAN
    pageGroup: @wzrd-wan
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region form-enlace-wan (
        name: Form Enlace WAN
        type: form
        source {
            location: localDatabase
            tableName: SGT_ENLACES_WAN
        }
        layout {
            sequence: 10
            parentRegion: @step
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region step (
        name: Step 1
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @wizard-progress
            slot: wizardSubRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region wizard-progress (
        name: Wizard Progress
        type: list
        source {
            list: @wzrd-conexiones-wan
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @/wizard-progress
        }
    )

    pageItem P401_GRUPO_RED (
        type: selectOne
        label {
            label: Grupo Red
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @enlaces-wan-grupo-red
        }
        layout {
            sequence: 30
            region: @form-enlace-wan
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
        source {
            formRegion: @form-enlace-wan
            column: GRUPO_RED
            dataType: varchar2
        }
        sessionState {
            storage: session
        }
    )

    pageItem P401_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-enlace-wan
            slot: regionBody
        }
        source {
            formRegion: @form-enlace-wan
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        sessionState {
            storage: session
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P401_NOMBRE (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-enlace-wan
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @form-enlace-wan
            column: NOMBRE
            dataType: varchar2
        }
        sessionState {
            storage: session
        }
        help {
            inlineHelpText: Ingrese un nombre para esta WAN
            helpText: En nombre de la WAN debe ser significativo, incluir el grupo de red al que pertenece y los sitios que une, ej: FOX_SMI_PBO
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 40
            region: @wizard-progress
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
                clearCache: 405
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 50
            region: @wizard-progress
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process initialize-form-crear-el-enlace-wan (
        name: Initialize form Crear el enlace WAN
        type: formInitialization
        formRegion: @form-enlace-wan
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 78443846972739367149
        }
    )

    process process-form-new (
        name: Process form New
        type: formAutoRowProcessing
        formRegion: @form-enlace-wan
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 85693682422729747631
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 402
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

