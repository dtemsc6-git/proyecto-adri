page 67 (
    name: Vista Global Comentarios
    alias: VISTA-GLOBAL-COMENTARIOS
    title: Vista Global Comentarios
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @search-results
        }
        layout {
            sequence: 10
            slot: leftColumn
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkLabel: Filters
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
            displayChartForTopNValues: 10
        }

        facet P67_ACTUALIZADO_POR (
            type: checkboxGroup
            label {
                label: Actualizado Por
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: ACTUALIZADO_POR
            }
        )

        facet P67_COMENTARIO (
            type: checkboxGroup
            label {
                label: Comentario
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: COMENTARIO
            }
        )

        facet P67_EQUIPO_NOMBRE (
            type: checkboxGroup
            label {
                label: Equipo Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: EQUIPO_NOMBRE
            }
        )

        facet P67_RACK_NOMBRE (
            type: checkboxGroup
            label {
                label: Rack Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: RACK_NOMBRE
            }
        )

        facet P67_SALA_NOMBRE (
            type: checkboxGroup
            label {
                label: Sala Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: SALA_NOMBRE
            }
        )

        facet P67_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: SITIO_NOMBRE,SALA_NOMBRE,RACK_NOMBRE,EQUIPO_NOMBRE,COMENTARIO
            }
        )

        facet P67_SITIO_NOMBRE (
            type: checkboxGroup
            label {
                label: Sitio Nombre
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: SITIO_NOMBRE
            }
        )

    )

    region search-results (
        name: Search Results
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sitio.id as sitio_id, sitio.nombre as sitio_nombre, null as sala_id, null as sala_nombre, null as rack_id, null as rack_nombre,
                null as equipo_id, null as equipo_nombre, comentario, sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por 
                
                from sgt_sitios sitio join sgt_comentarios on pk_id = sitio.id
                where entidad = 1 
                
                union all 
                
                select sitio.id as sitio_id, sitio.nombre as sitio_nombre, salas.id as sala_id, salas.nombre as sala_nombre, null as rack_id, null as rack_nombre,
                null as equipo_id, null as equipo_nombre, comentario, sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_sitios sitio 
                join sgt_salas salas on salas.sitio_id = sitio.id
                join sgt_comentarios on pk_id = salas.id
                where entidad = 2 
                
                union all 
                
                --Comentarios de los racks
                select sitio.id as sitio_id, sitio.nombre as sitio_nombre, salas.id as sala_id, salas.nombre as sala_nombre, racks.id as rack_id, racks.nombre as rack_nombre,
                null as equipo_id, null as equipo_nombre, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_sitios sitio 
                join sgt_salas salas on salas.sitio_id = sitio.id
                join sgt_racks racks on racks.sala_id = salas.id
                join sgt_comentarios on pk_id = racks.id
                where entidad = 3 
                
                union all
                --vista de los comentarios de los equipos
                
                select sitio.id as sitio_id, sitio.nombre as sitio_nombre, salas.id as sala_id, salas.nombre as sala_nombre, racks.id as rack_id, racks.nombre as rack_nombre,
                equipos.id as equipo_id, equipos.nombre as equipo_nombre, comentario , sgt_comentarios.actualizado_el as actualizado_el, sgt_comentarios.actualizado_por as actualizado_por
                
                from sgt_sitios sitio 
                join sgt_salas salas on salas.sitio_id = sitio.id
                join sgt_racks racks on racks.sala_id = salas.id
                join sgt_equipos equipos on equipos.rack_id = racks.id
                join sgt_comentarios on pk_id = equipos.id
                where entidad = 4
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: no data found
        }

        column ACTUALIZADO_EL (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Actualizado El
            }
            layout {
                sequence: 29
            }
        )

        column ACTUALIZADO_POR (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Actualizado Por
            }
            layout {
                sequence: 19
            }
        )

        column COMENTARIO (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Comentario
            }
            layout {
                sequence: 9
            }
            sorting {
                defaultSequence: 1
            }
        )

        column EQUIPO_ID (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column EQUIPO_NOMBRE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Equipo Nombre
            }
            layout {
                sequence: 8
            }
            sorting {
                defaultSequence: 1
            }
        )

        column RACK_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column RACK_NOMBRE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Rack Nombre
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SALA_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column SALA_NOMBRE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Sala Nombre
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SITIO_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column SITIO_NOMBRE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Sitio Nombre
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 67
                clearCache: 67
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

