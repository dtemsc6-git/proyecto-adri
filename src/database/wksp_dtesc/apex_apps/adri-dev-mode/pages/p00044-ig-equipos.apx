        column RACK_ID (
            type: popupLov
            heading {
                heading: Rack
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 
                    
                    s.siglas||'.'||r.nombre, r.id
                    
                    from 
                    sgt_racks r 
                    inner join sgt_salas s on r.sala_id = s.id
                    inner join sgt_sitios ss on s.sitio_id = ss.id
                    
                    where ss.id = :SITIO_ID
                    ```
            }
            cascadingLov {
                parentColumns: SITIO_ID
                itemsToSubmit: SITIO_ID
            }
            layout {
