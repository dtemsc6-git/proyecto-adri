page 10 (
    name: Grilla enlaces WAN
    alias: GRILLA-ENLACES-WAN
    title: Grilla enlaces WAN
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region grilla-enlaces-wan (
        name: Grilla enlaces WAN
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_ENLACES_WAN
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 23434111634083220
        }

        savedReport 235005 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOMBRE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @CREADO_POR
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @CREADO_EL
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @TIPO_WAN_ID
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @COMENTARIOS
                layout {
                    sequence: 9
                }
            )

        )

        column ACTUALIZADO_EL (
            type: displayOnly
            heading {
                heading: Actualizado El
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: timestamp
                queryOnly: true
            }
        )

        column ACTUALIZADO_POR (
            type: displayOnly
            heading {
                heading: Actualizado Por
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COMENTARIOS (
            type: displayOnly
            heading {
                heading: Comentarios
            }
            layout {
                sequence: 60
            }
            link {
                target: {
                    page: 32
                    items: {
                        P32_ENTIDAD: 8
                        P32_PK_ID: &ID.
                    }
                }
                linkText: &COMENTARIOS.
            }
            source {
                type: sqlExpression
                sqlExpression: 'Ver'
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREADO_EL (
            type: displayOnly
            heading {
                heading: Creado El
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CREADO_EL
                dataType: timestamp
                queryOnly: true
            }
        )

        column CREADO_POR (
            type: displayOnly
            heading {
                heading: Creado Por
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: CREADO_POR
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NOMBRE (
            type: textField
            heading {
                heading: Nombre
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 255
            }
            source {
                databaseColumn: NOMBRE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPO_WAN_ID (
            type: popupLov
            heading {
                heading: Tipo Wan
            }
            lov {
                type: sharedComponent
                lov: @enlaces-wan-tipo-enlace
                nullDisplayValue: Seleccione Una
            }
            layout {
                sequence: 110
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: TIPO_WAN_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    button btn-grilla (
        buttonName: BTN_GRILLA
        label: Ir a Conexiones de Enlaces WAN
        layout {
            sequence: 10
            region: @grilla-enlaces-wan
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 407
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button btn-tipo-enlace-wan (
        buttonName: BTN_TIPO_ENLACE_WAN
        label: Ir a Tipos de Enlace Wan
        layout {
            sequence: 20
            region: @grilla-enlaces-wan
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refrescar-grilla (
        name: REFRESCAR_GRILLA
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @grilla-enlaces-wan
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @grilla-enlaces-wan
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process grilla-enlaces-wan-save-interactive-grid-data (
        name: Grilla enlaces WAN - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @grilla-enlaces-wan
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23435259205083231
        }
    )

)

