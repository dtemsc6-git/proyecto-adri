page 21 (
    name: SGT_DEPTO
    alias: SGT-DEPTO
    title: Lista de departamentos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-depto (
        name: SGT_DEPTO
        type: interactiveReport
        source {
            location: localDatabase
            tableName: SGT_DEPTO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 22
                items: {
                    P22_ID: \#ID#\
                    P22_TITULO: Editar departamento
                }
                clearCache: 22
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            finderDropDown: false
            searchButtonLabel: Buscar
        }
        actionsMenu {
            includeActionsMenu: false
        }
        advanced {
            savedReportMappingIdentifier: 6036841430800672389
        }

        column CAPITAL (
            type: plainText
            heading {
                heading: Capital
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 60365545 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CAPITAL (
                sequence: 3
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn NOMBRE (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Agregar
        layout {
            sequence: 10
            region: @sgt-depto
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 22
                items: {
                    P22_TITULO: Agregar departamento
                }
                clearCache: 22
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-depto
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-depto
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

