page 26 (
    name: SGT_FORM_SITIOS
    alias: SGT-FORM-SITIOS
    title: Formulario Sitios
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region arbol (
        name: ARBOL
        title: Racks y Equipos
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @contenedor
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        config {
            buildOption: @commented-out
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region contenedor (
        name: CONTENEDOR
        type: regionDisplaySelector
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        settings {
            includeShowAll: false
        }
    )

    region new (
        name: New
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with data as (
                select ('SC') as link_type, 'S-'||to_char(sitio_id) as PARENT_ID, 'SC-'||to_char(c.id) as ID, c.siglas as name, c.id as sub_id from sgt_salas c
                union all
                select ('R') as link_type,'SC-'||to_char(sala_id) as PARENT_ID, 'R-'||to_char(d.id) as ID, d.nombre as name, d.id as sub_id from sgt_racks d  
                union all 
                select ('E') as link_type,  'R-'||to_char(rack_id) as parent_id , 'E-'||to_char(e.id) as ID, 'U: '||e.u||', '||e.nombre as name, e.id as sub_id from sgt_equipos e
                
                
                )
                select case when connect_by_isleaf = 1 then 0
                            when level = 1             then 1
                            else                           -1
                       end as status, 
                       level,
                       name as title, 
                       null as icon, 
                       "ID" as value, 
                       null as tooltip, 
                       null as link 
                from data 
                
                start with "PARENT_ID" = 'S-'||:P26_ID
                connect by prior "ID" = "PARENT_ID"
                order siblings by name
                ```
        }
        layout {
            sequence: 10
            parentRegion: @arbol
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        settings {
            nodeLabelColumn: TITLE
            nodeValueColumn: VALUE
            hierarchy: notComputed
            nodeStatusColumn: STATUS
            hierarchyLevelColumn: LEVEL
            defaultIconCssClass: icon-tree-folder
            iconTypeCssClass: a-Icon
        }
    )

    region sitio (
        name: SITIO
        type: form
        source {
            location: localDatabase
            tableName: SGT_SITIOS
        }
        layout {
            sequence: 10
            parentRegion: @contenedor
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P26_CIUDAD_ID (
        type: popupLov
        label {
            label: Ciudad
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @ciudad-nombre-compuesto
            nullDisplayValue: Seleccione Una
        }
        cascadingLov {
            parentItems: P26_DEPARTAMENTO_ID
            itemsToSubmit: P26_DEPARTAMENTO_ID
        }
        layout {
            sequence: 90
            region: @sitio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @sitio
            column: CIUDAD_ID
            dataType: number
        }
        help {
            inlineHelpText: Indicar ciudad a la cual perternece el sitio
        }
    )

    pageItem P26_DEPARTAMENTO_ID (
