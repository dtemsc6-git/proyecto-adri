    pageItem P26_OBSERVACION (
        type: textField
        label {
            label: Observación
            alignment: left
        }
        layout {
            sequence: 140
            region: @sitio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
