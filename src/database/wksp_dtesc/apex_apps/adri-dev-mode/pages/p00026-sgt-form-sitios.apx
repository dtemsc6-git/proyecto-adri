        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_ID
        }
    )

    dynamicAction actualizar-título-de-página (
        name: Actualizar título de página
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).ready(function() {
                    
                    apex.util.getTopApex().jQuery(".ui-dialog-content").dialog("option", "title", "&P26_TITULO.");
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 6937189029694263842
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sgt-form-sitios (
        name: Initialize form SGT_FORM_SITIOS
        type: formInitialization
        formRegion: @sitio
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6937188205053263842
        }
    )

    process process-form-sgt-form-sitios (
        name: Process form SGT_FORM_SITIOS
        type: formAutoRowProcessing
        formRegion: @sitio
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6937188658023263842
        }
    )

)

