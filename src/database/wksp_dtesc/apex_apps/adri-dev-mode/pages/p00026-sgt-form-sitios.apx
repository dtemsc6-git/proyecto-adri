            region: @sitio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P26_ID (
        type: hidden
        layout {
            sequence: 20
            region: @sitio
            slot: regionBody
        }
        source {
            formRegion: @sitio
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P26_LATITUD (
        type: numberField
        label {
            label: Latitud
            alignment: left
        }
        layout {
            sequence: 110
            region: @sitio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
