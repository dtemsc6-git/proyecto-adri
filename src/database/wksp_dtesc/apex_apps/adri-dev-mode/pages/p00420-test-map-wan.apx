                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process get-one-lng-lat (
        name: GET_ONE_LNG_LAT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                --OBTIENE UNA LNG Y LAT PARA MOVER EL MAPA
                declare
                l_cursor SYS_REFCURSOR;
                BEGIN
                
                    open l_cursor for
                    SELECT LON, LAT FROM V_SITIOS_GPS V
                    join v_sitios_equipos se  on   V.ID = se.SITIO_ID
                    join sgt_equipos_wan wan on se.equipo_id = wan.equipo_a_id
                    WHERE wan.WAN_ID = :P420_WAN;
                
                    -- DEBO RETORNAR EL PRIMER ELEMENTO NOMAS 
                    APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE('data', l_cursor); -- Convierte el cursor a JSON array
                    APEX_JSON.CLOSE_OBJECT;
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 88034740753693770450
        }
    )

)

