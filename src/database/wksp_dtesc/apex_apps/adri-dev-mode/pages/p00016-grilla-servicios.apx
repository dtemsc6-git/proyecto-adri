page 16 (
    name: Grilla Servicios
    alias: GRILLA-SERVICIOS
    title: Grilla Servicios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region grilla-servicios (
        name: Grilla Servicios
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_SERVICIOS
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 20812124850591843
        }

        savedReport 208126 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @NOMBRE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @NIVEL_DE_PRIORIDAD
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @CREADO_POR
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @CREADO_EL
                layout {
                    show: false
                    sequence: 7
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    show: false
                    sequence: 8
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    show: false
                    sequence: 9
                }
            )

            displayColumn (
                column: @COMENTARIOS
                layout {
                    sequence: 12
                }
            )

        )

        column ACTUALIZADO_EL (
            type: displayOnly
            heading {
                heading: Actualizado El
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: date
            }
        )

        column ACTUALIZADO_POR (
            type: displayOnly
            heading {
                heading: Actualizado Por
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COMENTARIOS (
            type: displayOnly
            heading {
                heading: Comentarios
            }
            layout {
                sequence: 110
            }
            link {
                target: {
                    page: 32
                    items: {
                        P32_ENTIDAD: 9
                        P32_PK_ID: &ID.
                    }
                }
                linkText: &COMENTARIOS.
            }
            source {
                type: sqlExpression
                sqlExpression: 'Ver'
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREADO_EL (
            type: displayOnly
            heading {
                heading: Creado El
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CREADO_EL
                dataType: date
            }
        )

        column CREADO_POR (
            type: displayOnly
            heading {
                heading: Creado Por
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: CREADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NIVEL_DE_PRIORIDAD (
            type: popupLov
            heading {
                heading: Nivel De Prioridad
            }
            lov {
                type: sharedComponent
                lov: @servicios-nivel-prioridad
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: NIVEL_DE_PRIORIDAD
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column NOMBRE (
            type: textField
            heading {
                heading: Nombre
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: NOMBRE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Grilla Servicios
        }
    )

    button btn-grilla-conexiones-srv (
        buttonName: BTN_GRILLA_CONEXIONES_SRV
        label: Ir a Conexiones de Servicio
        layout {
            sequence: 10
            region: @grilla-servicios
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 18
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @grilla-servicios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @grilla-servicios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process grilla-servicios-save-interactive-grid-data (
        name: Grilla Servicios - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @grilla-servicios
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20822444004591849
        }
    )

)

