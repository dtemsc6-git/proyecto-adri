    button btn-mapa-sitios (
        buttonName: BTN_MAPA_SITIOS
        label: Mapa Sitios
        layout {
            sequence: 10
            region: @sgt-sitios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-map-marker
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 47
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 20
            region: @sgt-sitios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 26
                items: {
                    P26_TITULO: Agregar sitio
                }
                clearCache: 26
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @implementador-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-sitios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-sitios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process formato-numerico (
        name: FORMATO_NUMERICO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                EXECUTE IMMEDIATE 
                   'ALTER SESSION SET NLS_NUMERIC_CHARACTERS = ''.,''';
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15999113760665707
        }
        config {
            buildOption: @commented-out
        }
    )

)

