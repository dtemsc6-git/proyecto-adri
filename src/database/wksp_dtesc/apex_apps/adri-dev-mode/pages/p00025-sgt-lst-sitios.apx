page 25 (
    name: SGT_LST_SITIOS
    alias: SGT-LST-SITIOS
    title: Lista de sitios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-sitios (
        name: SGT_SITIOS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT S.ID,
                       '<ul>' ||
                        
                        '<li><a href='||APEX_PAGE.GET_URL(p_page => 26, p_items => 'P26_ID', p_values => s.ID )||'>Editar</a></li>' || 
                        '<li><a href='||APEX_PAGE.GET_URL(p_page => 470, p_items => 'P470_ENTIDAD,P470_PK_ID', p_values=> '1,' || s.ID )||'>Imágenes</a></li>' || 
                        '<li><a href='||APEX_PAGE.GET_URL(p_page => 9, p_items => 'P9_ID', p_values=>  s.ID )||'>Dependencias</a></li>' || 
                        --'<li><a href='||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:470:&APP_SESSION.::::P470_ENTIDAD,P470_PK_ID:1,' || s.ID )||'>Imágenes</a></li>' || 
                        --'<li><a href='||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:9:&APP_SESSION.::::P9_ID:' || s.ID )||'>Dependencias</a></li>' || 
                       -- '<li><a href='||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:465:&APP_SESSION.::::P465_EQUIPO_ID:'|| e.ID )||'>Dependencias</a></li>' || 
                       -- '<li><a href='||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:14:&APP_SESSION.::::P14_ID:'|| e.ID )||'>Incidencias</a></li>' || 
                       -- '<li><a href='||APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:14:&APP_SESSION.::::P14_ID:'|| e.ID )||'>Auditoria</a></li>' || 
                        
                        '</ul>'
                       as ACCIONES,   
                       SIGLAS,
                       S.NOMBRE,
                       TIPO_DE_SITIO,
                       PROPIETARIO,
                       ZONA_ID,
                       depto.nombre Departamento,
                       CIUDAD_ID,
                       LATITUD,
                       LONGITUD,
                       "UBICACIÓN",
                       --OBSERVACION,
                       CASE 
                           WHEN LATITUD IS NOT NULL 
                            AND LONGITUD IS NOT NULL THEN 
                               'https://www.google.com/maps?q=' ||
                               TO_CHAR(LATITUD, 'FM9999990D000000', 'NLS_NUMERIC_CHARACTERS=.,') || ',' ||
                               TO_CHAR(LONGITUD, 'FM9999990D000000', 'NLS_NUMERIC_CHARACTERS=.,')
                           ELSE 
                               NULL
                       END AS GMAPS,
                       NVL(C.COMENTARIO,'Ver') COMENTARIOS
                FROM SGT_SITIOS S
                
                --Agregar comentarios
                LEFT JOIN (
                    SELECT PK_ID, 
                           COMENTARIO, 
                           ROW_NUMBER() OVER (PARTITION BY PK_ID ORDER BY CREADO_EL DESC) AS rn
                    FROM SGT_COMENTARIOS
                    WHERE ENTIDAD = 1
                ) C ON C.PK_ID = S.ID AND C.rn = 1
                --
                
                
                left join sgt_ciudad ciudad on S.ciudad_id = ciudad.id
                LEFT JOIN SGT_DEPTO depto on ciudad.depto_id = depto.id
                ORDER BY S.ID DESC
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            searchButtonLabel: Buscar
        }
        actionsMenu {
            controlBreak: false
            compute: false
            aggregate: false
            chart: false
            groupBy: false
            flashback: false
            savePublicReport: true
            help: false
        }
        download {
            authorization: !@reader-rights
            formats: [
                csv
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 6937190126632263843
        }

        column ACCIONES (
            type: richText
            heading {
                heading: Acciones
                alignment: center
            }
            layout {
                sequence: 10
            }
            settings {
                format: html
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
            enableUsersTo {
                hide: false
                filter: false
                highlight: false
            }
        )

        column CIUDAD_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Ciudad
                alignment: center
            }
            lov {
                lov: @ciudad-nombre
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column COMENTARIOS (
            type: link
            heading {
                heading: Comentarios
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            link {
                target: {
                    page: 32
                    items: {
                        P32_ENTIDAD: 1
                        P32_PK_ID: #ID#
                    }
                }
