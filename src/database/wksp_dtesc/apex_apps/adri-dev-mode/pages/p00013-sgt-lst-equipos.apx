    dynamicAction click-acciones (
        name: CLICK_ACCIONES
        execution {
            sequence: 20
            eventScope: dynamic
            staticContainer: .a-IRR-table
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .btn-acciones
        }

        action get-url (
            name: GET_URL
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    
                    R_URL varchar2(4000);
                    BEGIN
                    
                    SELECT APEX_PAGE.GET_URL (
                                p_page   => 1,
                                p_items  => :P13_ITEMS,
                                p_values => :P13_VALUES ) into R_URL         
                         FROM DUAL;
                        
                     :P13_RESULT := R_URL;
                    
                    
                    END;
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: console.log(this.triggeringElement.dataset)
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action set-items (
            name: SET_ITEMS
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.dataset.items
            }
            affectedElements {
                selectionType: items
                items: P13_ITEMS
            }
            execution {
                sequence: 20
            }
        )

        action set-values (
            name: SET_VALUES
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.dataset.values
            }
            affectedElements {
                selectionType: items
                items: P13_VALUES
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-lst-equipos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-lst-equipos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                R_URL varchar2(4000);
                BEGIN
                
                SELECT APEX_PAGE.GET_URL (
                            p_page   => 1,
                            p_items  => :P13_ITEMS,
                            p_values => :P13_VALUES ) into R_URL         
                     FROM DUAL;
                    
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 23436758616083246
        }
    )

