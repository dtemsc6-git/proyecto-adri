page 34 (
    name: SGT_LST_ENLACES_LOGICOS
    alias: SGT-LST-ENLACES-LOGICOS
    title: Enlaces WAN
    pageGroup: @técnicos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-lst-enlaces-wan (
        name: SGT_LST_ENLACES_WAN
        type: interactiveReport
        source {
            location: localDatabase
            tableName: SGT_ENLACES_WAN
            orderByClause: ID desc
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 401
                items: {
                    P401_ID: \#ID#\
                }
                clearCache: [
                    401
                    402
                    403
                    405
                ]
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @implementador-rights
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            controlBreak: false
            highlight: false
            compute: false
            aggregate: false
            chart: false
            groupBy: false
            pivot: false
            flashback: false
            saveReport: false
            reset: false
            help: false
        }
        advanced {
            savedReportMappingIdentifier: 43769687655303608878
        }

        column ACTUALIZADO_EL (
            type: plainText
            heading {
                heading: Actualizado El
            }
            layout {
                sequence: 119
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AE
            }
        )

        column ACTUALIZADO_POR (
            type: plainText
            heading {
                heading: Actualizado Por
            }
            layout {
                sequence: 109
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AD
            }
        )

        column CREADO_EL (
            type: plainText
            heading {
                heading: Creado El
            }
            layout {
                sequence: 17
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Q
            }
            config {
                buildOption: @commented-out
            }
        )

        column CREADO_POR (
            type: plainText
            heading {
                heading: Creado Por
            }
            layout {
                sequence: 16
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
            config {
                buildOption: @commented-out
            }
        )

        column GRUPO_RED (
            type: plainText
            heading {
                heading: Grupo Red
            }
            layout {
                sequence: 99
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AA
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 29
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: SGT_LST_ENLACES_LOGICOS
        }

        savedReport 437698322 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn GRUPO_RED (
                sequence: 2
            )

            displayColumn NOMBRE (
                sequence: 1
            )

        )

    )

    button asistente (
        buttonName: ASISTENTE
        label: Asistente
        layout {
            sequence: 30
            region: @sgt-lst-enlaces-wan
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 401
                clearCache: [
                    401
                    402
                    403
                    405
                ]
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button grilla-editable (
        buttonName: GRILLA_EDITABLE
        label: Grilla Editable
        layout {
            sequence: 50
            region: @sgt-lst-enlaces-wan
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-lst-enlaces-wan
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-lst-enlaces-wan
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

