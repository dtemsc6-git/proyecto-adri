page 45 (
    name: IG_ENLACES_FO
    alias: IG-ENLACES-FO
    title: IG_ENLACES_FO
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region sgt-enlaces-fo (
        name: SGT_ENLACES_FO_2
        title: Enlaces FO
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       NOMBRE,
                       SITIO_ID_A,
                       EQUIPO_ID_A,
                       SITIO_ID_B,
                       EQUIPO_ID_B,
                       --"CERTIFICACIÓN",
                       --UNIDAD_MEDIDA,
                       --ABS_LONGITUD,
                       --CANTIDAD_DE_PELOS,
                       --TIPO_DE_FO,
                       TIPO,
                       LT,
                       --CONECTOR,
                       ESTADO,
                       --COMENTARIOS,
                       --"PROYECTO_DE_IMPLEMENTACIÓN",
                       --"FECHA_IMPLEMENTACIÓN",
                       --UNIDAD_ENCARGADA_ACTUAL,
                       --CREADO_POR,
                       --CREADO_EL,
                       ACTUALIZADO_POR,
                       ACTUALIZADO_EL,
                       TIPO_CABLE,
                       TIPO_TENDIDO
                       --PUERTOS_LADO_A,
                       --PUERTOS_LADO_B
                  from SGT_ENLACES_FO
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 88029835160769630930
        }

        savedReport 880350054 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOMBRE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SITIO_ID_A
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @EQUIPO_ID_A
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @SITIO_ID_B
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @EQUIPO_ID_B
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TIPO
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @LT
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @ESTADO
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    sequence: 22
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    sequence: 23
                }
            )

            displayColumn (
                column: @TIPO_CABLE
                layout {
                    sequence: 24
                }
            )

            displayColumn (
                column: @TIPO_TENDIDO
                layout {
                    sequence: 25
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column ACTUALIZADO_EL (
            type: displayOnly
            heading {
                heading: Actualizado el
                alignment: center
            }
            layout {
                sequence: 210
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: timestamp
            }
        )

        column ACTUALIZADO_POR (
            type: displayOnly
            heading {
                heading: Actualizado por
                alignment: center
            }
            layout {
                sequence: 200
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column EQUIPO_ID_A (
            type: selectList
            heading {
                heading: Equipo A
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select e.nombre Mostrar, e.id Valor from SGT_EQUIPOS e
                    left join sgt_racks r on e.rack_id = r.id
                    left join sgt_salas s on r.sala_id = s.id
                    left join sgt_sitios ss on s.sitio_id = ss.id
                    where ss.id =  :SITIO_ID_A AND e.tipo_equipo_id = 11
                    ```
                nullDisplayValue: Valor no asignado
            }
            cascadingLov {
                parentColumns: SITIO_ID_A
                itemsToSubmit: SITIO_ID_A
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: EQUIPO_ID_A
                dataType: number
            }
        )

        column EQUIPO_ID_B (
            type: selectList
            heading {
                heading: Equipo B
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select e.nombre Mostrar, e.id Valor from SGT_EQUIPOS e
                    left join sgt_racks r on e.rack_id = r.id
                    left join sgt_salas s on r.sala_id = s.id
                    left join sgt_sitios ss on s.sitio_id = ss.id
                    where ss.id =  :SITIO_ID_B AND e.tipo_equipo_id = 11
                    ```
                nullDisplayValue: Valor no asignado
            }
            cascadingLov {
                parentColumns: SITIO_ID_B
                itemsToSubmit: SITIO_ID_B
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: EQUIPO_ID_B
                dataType: number
            }
        )

        column ESTADO (
            type: selectList
            heading {
                heading: Estado
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @enlace-fo-estado
            }
            layout {
                sequence: 190
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
