page 7 (
    name: Historial Equipo
    alias: HISTORIAL-EQUIPO
    title: Historial Equipo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region historial-equipo (
        name: Historial Equipo
        title: Historial
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    AUDIT_ID,
                    FECHA_HORA,
                    USUARIO,
                    TIPO_COMPONENTE                                       AS COMPONENTE,
                    TIPO_OPERACION                                        AS ACCION,
                    DETALLE_OLD_VALUE                                     AS OLD_VALUE,
                    DETALLE_NEW_VALUE                                     AS NEW_VALUE
                FROM V_AUDIT_EQUIPOS
                WHERE EQUIPO_ID = TO_CHAR(:P7_ID)
                    AND TIPO_OPERACION IN ('UPDATE', 'DELETE', 'Actualización', 'Eliminación')
                ORDER BY FECHA_HORA_FILTRO DESC;
                ```
            pageItemsToSubmit: P7_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No se encontraron registros
        }

        column ACCION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Accion
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column AUDIT_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column COMPONENTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Componente
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column FECHA_HORA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Fecha Hora
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column NEW_VALUE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: New Value
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column OLD_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Old Value
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuario
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P7_EQUIPO_FULL_NAME (
        type: displayOnly
        label {
            label: Equipo (Full name):
            alignment: left
        }
        settings {
            basedOn: lov
            showLineBreaks: false
            sendOnPageSubmit: false
        }
        lov {
            type: sharedComponent
            lov: @equipos-nombre-compuesto
        }
        layout {
            sequence: 10
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: item
            item: P7_ID
        }
    )

    pageItem P7_ID (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

)

