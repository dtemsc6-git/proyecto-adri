page 32 (
    name: SGT_CABLES
    alias: SGT-CABLES
    title: SGT_CABLES
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-cables (
        name: SGT_CABLES
        type: classicReport
        source {
            location: localDatabase
            tableName: SGT_CABLES
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }

        column ABS_LONGITUD (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Abs Longitud
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
        )

        column ACTUALIZADO_EL (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Actualizado El
            }
            layout {
                sequence: 13
            }
        )

        column COMENTARIOS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Comentarios
            }
            layout {
                sequence: 7
            }
            sorting {
                defaultSequence: 1
            }
        )

        column CREADO_EL (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Creado El
            }
            layout {
                sequence: 12
            }
        )

        column DESCRIPCION (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ESTADO_CONEXION (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Estado Conexion
            }
            layout {
                sequence: 8
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ETIQUETA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Etiqueta
            }
            layout {
                sequence: 5
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 0
            }
        )

        column LONGITUD (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Longitud
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
        )

        column NOMBRE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Nombre
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SGT_TIPO_CABLE_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Sgt Tipo Cable
            }
            lov {
                type: sharedComponent
                lov: @sgt-tipo-cable-nombre
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column UNIDAD_ENCARGADA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Unidad Encargada
            }
            layout {
                sequence: 3
            }
            sorting {
                defaultSequence: 1
            }
        )

        column UNIDAD_MEDIDA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Unidad Medida
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

)

