page 25 (
    name: SGT_LST_SITIOS
    alias: SGT-LST-SITIOS
    title: Lista de sitios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-sitios (
        name: SGT_SITIOS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT S.ID,
                       SIGLAS,
                       S.NOMBRE,
                       TIPO_DE_SITIO,
                       PROPIETARIO,
                       ZONA_ID,
                       depto.nombre Departamento,
                       CIUDAD_ID,
                       LATITUD,
                       LONGITUD,
                       "UBICACIÓN",
                       OBSERVACION,
                       CASE 
                           WHEN LATITUD IS NOT NULL 
                            AND LONGITUD IS NOT NULL THEN 
                               'https://www.google.com/maps?q=' ||
                               TO_CHAR(LATITUD, 'FM9999990D000000', 'NLS_NUMERIC_CHARACTERS=.,') || ',' ||
                               TO_CHAR(LONGITUD, 'FM9999990D000000', 'NLS_NUMERIC_CHARACTERS=.,')
                           ELSE 
                               NULL
                       END AS GMAPS
                FROM SGT_SITIOS S
                left join sgt_ciudad ciudad on S.ciudad_id = ciudad.id
                LEFT JOIN SGT_DEPTO depto on ciudad.depto_id = depto.id
                
                ORDER BY S.ID DESC
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 26
                items: {
                    P26_ID: \#ID#\
                    P26_TITULO: Editar sitio
                }
                clearCache: 26
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @implementador-rights
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            searchButtonLabel: Buscar
        }
        actionsMenu {
            controlBreak: false
            compute: false
            aggregate: false
            chart: false
            groupBy: false
            flashback: false
            savePublicReport: true
            help: false
        }
        download {
            authorization: !@reader-rights
            formats: [
                csv
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 6937190126632263843
        }

        column CIUDAD_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Ciudad
                alignment: center
            }
            lov {
                lov: @ciudad-nombre
            }
            layout {
                sequence: 41
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column DEPARTAMENTO (
            type: plainText
            heading {
                heading: Departamento
            }
            layout {
                sequence: 61
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column GMAPS (
            type: link
            heading {
                heading: Ubicación
            }
            layout {
                sequence: 91
            }
            link {
                target: {
                    type: url
                    url: #GMAPS#
                }
                linkText: <span class="t-Icon fa fa-map-marker" style="display: block; text-align: center;"></span>
                linkAttributes: target="_blank"
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column LATITUD (
            type: plainText
            heading {
                heading: Latitud
                alignment: end
            }
            layout {
                sequence: 71
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column LONGITUD (
            type: plainText
            heading {
                heading: Longitud
                alignment: end
            }
            layout {
                sequence: 81
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column OBSERVACION (
            type: plainText
            heading {
                heading: Observación
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column PROPIETARIO (
            type: plainText
            heading {
                heading: Propietario
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            security {
                authorizationScheme: @implementador-rights
            }
        )

        column SIGLAS (
            type: plainText
            heading {
                heading: Sigla
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TIPO_DE_SITIO (
            type: plainText
            heading {
                heading: Tipo de Sitio
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column UBICACIÓN (
            type: hidden
            heading {
                heading: Ubicación
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ZONA_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Zona
                alignment: center
            }
            lov {
                lov: @lov-sgt-zonas
            }
            layout {
                sequence: 31
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: SGT_SITIOS
        }

        savedReport 69378249 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CIUDAD_ID (
                sequence: 3
            )

            displayColumn DEPARTAMENTO (
                sequence: 2
            )

            displayColumn GMAPS (
                sequence: 6
            )

            displayColumn LATITUD (
                sequence: 4
            )

            displayColumn LONGITUD (
                sequence: 5
            )

            displayColumn NOMBRE (
                sequence: 9
            )

            displayColumn OBSERVACION (
                sequence: 10
            )

            displayColumn PROPIETARIO (
                sequence: 11
            )

            displayColumn SIGLAS (
                sequence: 8
            )

            displayColumn TIPO_DE_SITIO (
                sequence: 7
            )

            displayColumn ZONA_ID (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 10
            region: @sgt-sitios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 26
                items: {
                    P26_TITULO: Agregar sitio
                }
                clearCache: 26
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @implementador-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-sitios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-sitios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process formato-numerico (
        name: FORMATO_NUMERICO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                EXECUTE IMMEDIATE 
                   'ALTER SESSION SET NLS_NUMERIC_CHARACTERS = ''.,''';
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15999113760665707
        }
        config {
            buildOption: @commented-out
        }
    )

)

