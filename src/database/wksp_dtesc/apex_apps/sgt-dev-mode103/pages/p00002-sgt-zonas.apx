page 2 (
    name: SGT_ZONAS
    alias: SGT-ZONAS
    title: Lista de zonas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sgt-zonas (
        name: SGT_ZONAS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    A.ID,
                    A.NOMBRE,
                    B.NOMBRE AS DEPENDE_DE,
                    A.DESCRIPCION
                FROM 
                    SGT_ZONAS A
                left JOIN 
                    SGT_ZONAS B
                ON 
                    A.PARENT_ID = B.ID
                order by a.id;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 3
                items: {
                    P3_ID: \#ID#\
                    P3_TITULO: Editar zona
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            searchButtonLabel: Buscar
        }
        actionsMenu {
            flashback: false
        }
        advanced {
            savedReportMappingIdentifier: 81350286384235282201
        }

        column DEPENDE_DE (
            type: plainText
            heading {
                heading: Depende De
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: SGT_ZONAS
        }

        savedReport 813503052 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn ID (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Agregar
        layout {
            sequence: 10
            region: @sgt-zonas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                items: {
                    P3_TITULO: Agregar zona
                }
                clearCache: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sgt-zonas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sgt-zonas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

