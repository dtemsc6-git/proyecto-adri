page 10 (
    name: SGT_FORM_LST_SITIO_2
    alias: SGT-FORM-LST-SITIO-2
    title: Agregar / Modificar un Sitio
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sgt-lst-sitio-2-form (
        name: SGT_LST_SITIO_2_FORM
        type: form
        source {
            location: localDatabase
            tableName: SGT_SITIOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10_CIUDAD (
        type: textField
        label {
            label: Ciudad
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: CIUDAD
            dataType: varchar2
        }
    )

    pageItem P10_DEPARTAMENTO (
        type: textField
        label {
            label: Departamento
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 110
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: DEPARTAMENTO
            dataType: varchar2
        }
    )

    pageItem P10_ID (
        type: hidden
        layout {
            sequence: 50
            region: @sgt-lst-sitio-2-form
            slot: regionBody
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_LATITUD (
        type: textField
        label {
            label: Latitud
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 130
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: LATITUD
            dataType: varchar2
        }
    )

    pageItem P10_LONGITUD (
        type: textField
        label {
            label: Longitud
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 140
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: LONGITUD
            dataType: varchar2
        }
    )

    pageItem P10_NOMBRE (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 100
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: NOMBRE
            dataType: varchar2
        }
    )

    pageItem P10_PROPIETARIO (
        type: textField
        label {
            label: Propietario
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: PROPIETARIO
            dataType: varchar2
        }
    )

    pageItem P10_SIGLAS (
        type: textField
        label {
            label: Siglas
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: SIGLAS
            dataType: varchar2
        }
    )

    pageItem P10_TIPO_DE_SITIO (
        type: selectList
        label {
            label: Tipo De Sitio
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @tipo-sitio
        }
        layout {
            sequence: 40
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: TIPO_DE_SITIO
            dataType: varchar2
        }
    )

    pageItem P10_UBICACIÓN (
        type: textField
        label {
            label: Ubicación
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 150
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: UBICACIÓN
            dataType: varchar2
        }
    )

    pageItem P10_ZONA_ID (
        type: selectList
        label {
            label: Zona Id
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select nombre, id as valor from sgt_zonas;
        }
        layout {
            sequence: 60
            region: @sgt-lst-sitio-2-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @sgt-lst-sitio-2-form
            column: ZONA_ID
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P10_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 79358089967598362261
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sgt-lst-sitio-2-form (
        name: Initialize form SGT_LST_SITIO_2_FORM
        type: formInitialization
        formRegion: @sgt-lst-sitio-2-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 79358089122469362260
        }
    )

    process process-form-sgt-lst-sitio-2-form (
        name: Process form SGT_LST_SITIO_2_FORM
        type: formAutoRowProcessing
        formRegion: @sgt-lst-sitio-2-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 79358089581362362261
        }
    )

)

