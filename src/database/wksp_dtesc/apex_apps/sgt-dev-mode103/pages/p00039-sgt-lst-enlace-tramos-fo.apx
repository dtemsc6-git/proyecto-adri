    region sgt-lst-enlace-tramos-fo (
        name: SGT_LST_ENLACE_TRAMOS_FO
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT et.ID,
                       sa.SIGLAS                                              AS SITIO_A,
                       ea.NOMBRE                                             AS EQUIPO_A,
                       ei_a.NOMBRE || ' : ' || NVL(ei_a.ETIQUETA,'Sin datos') AS INTERFAZ_A,
                       sitio_b.SIGLAS                                        AS SITIO_B,
                       eb.NOMBRE                                             AS EQUIPO_B,
                       ei_b.NOMBRE || ' : ' || NVL(ei_b.ETIQUETA,'Sin datos') AS INTERFAZ_B,
                       et.TIPO_CONEXION,
                       et.ACTUALIZADO_EL
                FROM SGT_ENLACES_TRAMOS et
                INNER JOIN SGT_EQUIPOS ea        ON et.EQUIPO_A_ID   = ea.ID
                INNER JOIN SGT_RACKS r           ON ea.RACK_ID       = r.ID
                INNER JOIN SGT_SALAS s           ON r.SALA_ID        = s.ID
                INNER JOIN SGT_SITIOS sa         ON s.SITIO_ID       = sa.ID
                LEFT  JOIN SGT_INTERFACES ei_a   ON et.INTERFAZ_A_ID = ei_a.ID
                INNER JOIN SGT_EQUIPOS eb        ON et.EQUIPO_B_ID   = eb.ID
                INNER JOIN SGT_RACKS rb          ON eb.RACK_ID       = rb.ID
                INNER JOIN SGT_SALAS sb          ON rb.SALA_ID       = sb.ID
                INNER JOIN SGT_SITIOS sitio_b    ON sb.SITIO_ID      = sitio_b.ID
                LEFT  JOIN SGT_INTERFACES ei_b   ON et.INTERFAZ_B_ID = ei_b.ID
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 40
                items: {
                    P40_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @implementador-rights
        }
        pagination {
