    pageItem P46_MIN_CAMPOS (
        type: textField
        label {
            label: Cantidad mínima de campos
            alignment: left
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: static
            staticValue: 0
        }
        help {
            helpText:
                ```html
                Filtra transacciones que modificaron al menos esta cantidad de campos. 
                Por ejemplo, si ingresas "3", solo verás cambios que afectaron 3 o más campos.
                Deja vacío o en "0" para ver todos los registros.
                ```
        }
    )

    pageItem P46_MODULO (
        type: selectList
        label {
            label: Módulo del Sistema
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT 
                    MODULO as display_value,
                    MODULO as return_value
                FROM V_AUDIT_GENERAL
                WHERE MODULO IS NOT NULL
                ORDER BY 1
                ```
            nullDisplayValue: TODOS
            nullReturnValue: %
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P46_TIPO_OPERACION (
        type: selectList
        label {
            label: Tipo de Operacion
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                    CASE TIPO_OPERACION
                        WHEN 'INSERT' THEN 'Inserción'
                        WHEN 'UPDATE' THEN 'Modificación'  
                        WHEN 'DELETE' THEN 'Eliminación'
                        WHEN 'Creación' THEN 'Creación'
                        WHEN 'Modificación' THEN 'Modificación'
                        WHEN 'Eliminación' THEN 'Eliminación'
                        ELSE TIPO_OPERACION
                    END as display_value,
                    TIPO_OPERACION as return_value
                FROM V_AUDIT_GENERAL
                WHERE TIPO_OPERACION IS NOT NULL
                ```
            nullDisplayValue: TODOS
            nullReturnValue: %
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P46_USUARIO (
