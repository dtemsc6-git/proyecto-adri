                        P101_USUARIO: #USUARIO#
                        P101_OPERACION: #TIPO_OPERACION#
                        P101_FECHA_HORA: #FECHA#
                        P101_TABLA: #ORIGEN#
                    }
                }
                linkText: VER DETALLES
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AJ
            }
        )

