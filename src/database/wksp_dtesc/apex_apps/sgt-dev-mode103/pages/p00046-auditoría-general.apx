page 46 (
    name: Auditoría General del Sistema
    alias: AUDITORÍA-GENERAL
    title: Auditoría General del Sistema
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region auditoría-general-del-sistema (
        name: Auditoría General del Sistema
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    AUDIT_ID,
                    USUARIO,
                    TIPO_OPERACION,
                    FECHA,
                    HORA,
                    MODULO as SISTEMA,
                    TABLA as ORIGEN,
                    -- ID_REGISTRO eliminado
                    
                    -- NUEVAS COLUMNAS PRINCIPALES
                    CAMPOS_MODIFICADOS as CANT_CAMPOS,
                    CAMPOS_LISTA as CAMPOS,
                    DETALLE_OLD_VALUE as VALORES_ANTERIORES,
                    DETALLE_NEW_VALUE as VALORES_ACTUALES,
                    
                    -- Información de contexto
                    TIPO_CAMBIO,
                    NIVEL_CRITICIDAD,
                    TURNO,
                    PERIODO,
                    INDICADOR_VISUAL as ESTADO,
                    IP_ADDRESS,
                    
                    -- Para análisis y filtros
                    CASE 
                        WHEN CAMPOS_MODIFICADOS = 1 THEN '1 campo'
                        WHEN CAMPOS_MODIFICADOS <= 2 THEN CAMPOS_MODIFICADOS || ' campos'
                        WHEN CAMPOS_MODIFICADOS <= 5 THEN CAMPOS_MODIFICADOS || ' campos 🟡'
                        ELSE CAMPOS_MODIFICADOS || ' campos 🔴'
                    END as RESUMEN_CAMBIOS,
                   
                    CASE 
                        WHEN CAMPOS_MODIFICADOS > 3 THEN 
                            '<a href="javascript:ver_detalle_completo(' || AUDIT_ID || ')">Ver detalle completo</a>'
                        ELSE ''
                    END as ACCION_DETALLE
                
                FROM V_AUDIT_CONSOLIDADO
                WHERE 1=1
                    -- Filtros existentes
                    AND (:P46_FECHA_DESDE IS NULL OR 
                         LENGTH(TRIM(:P46_FECHA_DESDE)) = 0 OR
                         TRUNC(FECHA_HORA_FILTRO) >= TO_DATE(:P46_FECHA_DESDE, 'DD/MM/YYYY'))
                    
                    AND (:P46_FECHA_HASTA IS NULL OR 
                         LENGTH(TRIM(:P46_FECHA_HASTA)) = 0 OR
                         TRUNC(FECHA_HORA_FILTRO) <= TO_DATE(:P46_FECHA_HASTA, 'DD/MM/YYYY'))
                    
                    AND (:P46_USUARIO IS NULL OR 
                         :P46_USUARIO = '%' OR 
                         TRIM(:P46_USUARIO) = '' OR
                         UPPER(TRIM(USUARIO)) = UPPER(TRIM(:P46_USUARIO)))
                    
                    AND (:P46_TIPO_OPERACION IS NULL OR 
                         :P46_TIPO_OPERACION = '%' OR 
                         TIPO_OPERACION = :P46_TIPO_OPERACION)
                    
                    AND (:P46_MODULO IS NULL OR 
                         :P46_MODULO = '%' OR 
                         MODULO = :P46_MODULO)
                    
                    -- NUEVO FILTRO: Cantidad mínima de campos
                    AND (:P46_MIN_CAMPOS IS NULL OR 
                         :P46_MIN_CAMPOS = 0 OR
                         CAMPOS_MODIFICADOS >= :P46_MIN_CAMPOS)
                    
                ORDER BY FECHA_HORA_FILTRO DESC;
                ```
            pageItemsToSubmit: [
                P46_FECHA_DESDE
                P46_FECHA_HASTA
                P46_USUARIO
                P46_TIPO_OPERACION
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 59777351057680233353
        }

        column ACCION_DETALLE (
