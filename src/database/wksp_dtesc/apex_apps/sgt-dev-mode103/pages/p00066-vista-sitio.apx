page 66 (
    name: Vista Sitio
    alias: VISTA-SITIO
    title: Vista Sitio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region vista-sitio (
        name: Vista Sitio
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.siglas, s.nombre from sgt_salas s
                where s.sitio_id = :P66_SITIO_ID
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }

        column NOMBRE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Nombre
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SIGLAS (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Siglas
            }
            layout {
                sequence: 1
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    pageItem P66_SITIO_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

)

