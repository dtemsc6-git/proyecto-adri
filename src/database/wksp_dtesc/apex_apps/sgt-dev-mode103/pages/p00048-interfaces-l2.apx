page 48 (
    name: Interfaces L2
    alias: INTERFACES-L2
    title: Interfaces L2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region interfaces-l (
        name: Interfaces L2
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: SGT_INTERFACES_L2
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12174679079673636
        }

        savedReport 121751 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @INTERFACE_ID
                layout {
                    width: 114
                    sequence: 2
                }
            )

            displayColumn (
                column: @TIPO_VLAN
                layout {
                    width: 76
                    sequence: 3
                }
            )

            displayColumn (
                column: @VLAN
                layout {
                    width: 79
                    sequence: 4
                }
            )

            displayColumn (
                column: @L2_VC_ID
                layout {
                    width: 40
                    sequence: 5
                }
            )

            displayColumn (
                column: @LS_TX_RX_LABEL
                layout {
                    width: 100
                    sequence: 6
                }
            )

            displayColumn (
                column: @CREADO_EL
                layout {
                    show: false
                    width: 91
                    sequence: 7
                }
            )

            displayColumn (
                column: @ACTUALIZADO_EL
                layout {
                    width: 105
                    sequence: 8
                }
            )

            displayColumn (
                column: @ACTUALIZADO_POR
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @CREADO_POR
                layout {
                    show: false
                    sequence: 10
                }
            )

        )

        column ACTUALIZADO_EL (
            type: textField
            heading {
                heading: Actualizado El
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: ACTUALIZADO_EL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ACTUALIZADO_POR (
            type: textField
            heading {
                heading: Actualizado Por
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: ACTUALIZADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREADO_EL (
            type: textField
            heading {
                heading: Creado El
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CREADO_EL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREADO_POR (
            type: textField
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CREADO_POR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column INTERFACE_ID (
            type: popupLov
            heading {
                heading: Interfaz
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @interfaces-nombre-compuesto
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                databaseColumn: INTERFACE_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column L2_VC_ID (
            type: numberField
            heading {
                heading: L2 VC ID
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: L2_VC_ID
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column LS_TX_RX_LABEL (
            type: textField
            heading {
                heading: Ls Tx Rx Label
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: LS_TX_RX_LABEL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPO_VLAN (
            type: textField
            heading {
                heading: Tipo de VLAN
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: TIPO_VLAN
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column VLAN (
            type: textField
            heading {
                heading: VLAN
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: VLAN
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Interfaces L2
        }
    )

    button load (
        buttonName: LOAD
        label: Importar XLSX
        layout {
            sequence: 30
            region: @interfaces-l
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 56
                action: clearRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

