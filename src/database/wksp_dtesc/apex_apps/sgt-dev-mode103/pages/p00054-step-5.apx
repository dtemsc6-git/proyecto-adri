    region conexiones (
        name: Conexiones
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    t.id as title,
                    t.equipo_a || ':'|| t.interfaz_a ||'►'|| t.equipo_b || ':'|| t.interfaz_b description,
                    'fa-check-circle' as icon,
                    t.id as card_id
                FROM 
                    V_TRAMOS_NOMBRES t
                WHERE 
                    t.id IN (
                        SELECT column_value 
                        FROM apex_string.split_numbers(:P52_CIRCUITOS_FISICOS, ',')
                    )
                ```
        }
        layout {
            sequence: 30
            parentRegion: @step
            slot: subRegions
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
