            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-enlaces-logicos
            column: ACTUALIZADO_EL
            dataType: timestamp
        }
        config {
            buildOption: @commented-out
