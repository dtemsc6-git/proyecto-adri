    )

    pageItem P35_NOMBRE (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 20
            region: @sgt-form-enlaces-logicos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-enlaces-logicos
            column: NOMBRE
            dataType: varchar2
        }
        help {
            inlineHelpText: Nombre único para todo el sistema, ejemplo EQUIPO_SITIO_SITIO
            helpText: El nombre debe ser unico para todo el sistema, debe ser significativo y puede estar compuesto por ejemplo del equipo involucrado y los sitios de origen y destino, ej: ECI_VHA_AYO
        }
    )

