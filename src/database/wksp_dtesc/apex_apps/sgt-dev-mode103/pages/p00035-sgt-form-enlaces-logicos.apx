    pageItem P35_EQUIPO_A_ID (
        type: popupLov
        label {
            label: Equipo A
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nombre Mostrar, e.id Valor from SGT_EQUIPOS e
                left join sgt_racks r on e.rack_id = r.id
                left join sgt_salas s on r.sala_id = s.id
                left join sgt_sitios ss on s.sitio_id = ss.id
                where ss.id = :P35_SITIO_A_ID
                ```
        }
        cascadingLov {
            parentItems: P35_SITIO_A_ID
            itemsToSubmit: P35_SITIO_A_ID
        }
        layout {
            sequence: 50
            region: @sgt-form-enlaces-logicos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @sgt-form-enlaces-logicos
            column: EQUIPO_A_ID
            dataType: number
        }
    )

    pageItem P35_EQUIPO_B_ID (
        type: popupLov
        label {
