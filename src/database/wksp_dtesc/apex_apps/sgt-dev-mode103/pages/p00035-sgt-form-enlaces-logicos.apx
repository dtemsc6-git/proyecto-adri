page 35 (
    name: SGT_FORM_ENLACES_LOGICOS
    alias: SGT-FORM-ENLACES-LOGICOS
    title: Agregar / Editar
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sgt-form-enlaces-logicos (
        name: SGT_FORM_ENLACES_LOGICOS
        title: Agregar / Editar
        type: form
        source {
            location: localDatabase
            tableName: SGT_ENLACES_LOGICOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P35_ACTUALIZADO_EL (
        type: datePicker
        label {
            label: Actualizado El
            alignment: left
        }
        layout {
            sequence: 130
