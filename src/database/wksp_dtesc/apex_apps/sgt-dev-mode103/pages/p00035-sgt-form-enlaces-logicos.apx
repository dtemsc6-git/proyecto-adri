        }
        source {
            formRegion: @sgt-form-enlaces-logicos
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P35_INTERFAZ_A_ID (
        type: popupLov
        label {
            label: Interfaz A
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.nombre, i.id
                from sgt_interfaces i
                where i.equipo_id = :P35_equipo_a_id
                ```
        }
        cascadingLov {
            parentItems: P35_EQUIPO_A_ID
            itemsToSubmit: P35_EQUIPO_A_ID
