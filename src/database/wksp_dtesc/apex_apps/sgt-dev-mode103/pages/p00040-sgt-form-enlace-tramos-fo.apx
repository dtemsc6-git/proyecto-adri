    pageItem P40_EQUIPO_A_ID (
        type: popupLov
        label {
            label: Equipo A
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nombre || ' (' || e.id || ')' d,
                       e.id r
                from sgt_equipos e
                join sgt_racks r
                  on r.id = e.rack_id
                join sgt_salas sa
                  on sa.id = r.sala_id
                where :P40_SITIO_A is not null
                  and sa.sitio_id = :P40_SITIO_A
                order by e.nombre
                ```
            nullDisplayValue: - Seleccione equipo -
        }
        cascadingLov {
            parentItems: P40_SITIO_A
            itemsToSubmit: P40_SITIO_A
        }
        layout {
            sequence: 40
            region: @sgt-form-enlace-tramos-fo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @sgt-form-enlace-tramos-fo
            column: EQUIPO_A_ID
            dataType: number
        }
    )

