    process obtener-sitios (
        name: obtener_sitios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :P40_EQUIPO_A_ID is not null then
                        select sa.sitio_id
                          into :P40_SITIO_A
                          from sgt_equipos e
                          join sgt_racks r
                            on r.id = e.rack_id
                          join sgt_salas sa
                            on sa.id = r.sala_id
                         where e.id = :P40_EQUIPO_A_ID;
                    end if;
                
                    if :P40_EQUIPO_B_ID is not null then
                        select sa.sitio_id
                          into :P40_SITIO_B
                          from sgt_equipos e
                          join sgt_racks r
                            on r.id = e.rack_id
                          join sgt_salas sa
                            on sa.id = r.sala_id
                         where e.id = :P40_EQUIPO_B_ID;
                    end if;
                exception
                    when no_data_found then
                        :P40_SITIO_A := null;
                        :P40_SITIO_B := null;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 20177821211130141
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P40_ID
        }
    )

    process process-form-sgt-form-enlace-tramos-fo (
