page 38 (
    name: SGT_FORM_SERVICIOS
    alias: SGT-FORM-SERVICIOS
    title: Agregar / Editar
    pageGroup: @implementadores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @implementador-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sgt-form-servicios (
        name: SGT_FORM_SERVICIOS
        title: Agregar
        type: form
        source {
            location: localDatabase
            tableName: SGT_SERVICIOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P38_ACTUALIZADO_EL (
        type: datePicker
        label {
            label: Actualizado El
            alignment: left
        }
        layout {
            sequence: 80
            region: @sgt-form-servicios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-servicios
            column: ACTUALIZADO_EL
            dataType: date
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P38_ACTUALIZADO_POR (
        type: textField
        label {
            label: Actualizado Por
            alignment: left
        }
        layout {
            sequence: 70
            region: @sgt-form-servicios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-form-servicios
            column: ACTUALIZADO_POR
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P38_CREADO_EL (
        type: datePicker
        label {
            label: Creado El
            alignment: left
        }
        layout {
            sequence: 60
            region: @sgt-form-servicios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-servicios
            column: CREADO_EL
            dataType: date
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P38_CREADO_POR (
        type: textField
        label {
            label: Creado Por
            alignment: left
        }
        layout {
            sequence: 50
            region: @sgt-form-servicios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-form-servicios
            column: CREADO_POR
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P38_ID (
        type: hidden
        layout {
            sequence: 10
            region: @sgt-form-servicios
            slot: regionBody
        }
        source {
            formRegion: @sgt-form-servicios
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P38_INFORMACIÓN_ADICIONAL (
        type: textField
        label {
            label: Información Adicional
            alignment: left
        }
        layout {
            sequence: 40
            region: @sgt-form-servicios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @sgt-form-servicios
            column: INFORMACIÓN_ADICIONAL
            dataType: varchar2
        }
        help {
            inlineHelpText: Ingrese información relevante del servicio, velocidad, unidad que solicito u otra información significativa
        }
    )

    pageItem P38_NIVEL_DE_PRIORIDAD (
        type: numberField
        label {
            label: Nivel De Prioridad
            alignment: left
        }
        layout {
            sequence: 30
            region: @sgt-form-servicios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-servicios
            column: NIVEL_DE_PRIORIDAD
            dataType: number
        }
        help {
            inlineHelpText: Indica la prioridad del servicio, cuanto más bajo sea el número significa que requiere ser atendido primero.
        }
    )

    pageItem P38_NOMBRE (
        type: textField
        label {
            label: Nombre
            alignment: left
        }
        layout {
            sequence: 20
            region: @sgt-form-servicios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @sgt-form-servicios
            column: NOMBRE
            dataType: varchar2
        }
        help {
            inlineHelpText: Ingrese un nombre único para el servicio
            helpText:
                ```html
                El nombre del servicio podría ser definido asi:
                SCADA_SMI_PBO; ANDE.CORP_SMI_PBO; TELEFONIA_SMI_PBO
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: &APP_TEXT$BTN_CREAR!RAW.
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P38_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P38_ID
        }
    )

    button save (
        buttonName: SAVE
        label: &APP_TEXT$BTN_APLICAR_CAMBIOS!RAW.
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P38_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 44129479486774328233
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-sgt-form-servicios (
        name: Initialize form SGT_FORM_SERVICIOS
        type: formInitialization
        formRegion: @sgt-form-servicios
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44129478674140328232
        }
    )

    process process-form-sgt-form-servicios (
        name: Process form SGT_FORM_SERVICIOS
        type: formAutoRowProcessing
        formRegion: @sgt-form-servicios
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 44129479076368328232
        }
    )

)

